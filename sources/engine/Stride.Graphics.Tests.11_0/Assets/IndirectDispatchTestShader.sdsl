namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Marks each thread group that runs: element n gets n + 1.
    /// </summary>
    internal shader IndirectDispatchTestShader : ComputeShaderBase
    {
        stage RWStructuredBuffer<uint> Output;

        override void Compute()
        {
            Output[streams.GroupId.x] = streams.GroupId.x + 1;
        }
    };
}
