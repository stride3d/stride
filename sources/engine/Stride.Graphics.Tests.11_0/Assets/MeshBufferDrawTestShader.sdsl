namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Fills the triangle with one color.
    /// </summary>
    internal shader MeshBufferDrawTestShader : ShaderBase
    {
        stage stream float3 Position : POSITION;

        stage float4 Color;

        stage override void VSMain()
        {
            streams.ShadingPosition = float4(streams.Position, 1.0f);
        }

        stage override void PSMain()
        {
            streams.ColorTarget = Color;
        }
    };
}
