namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Fetches vertex positions through an index buffer, both read as raw buffers.
    /// Thread n writes (position, index) of the vertex that index n points to.
    /// </summary>
    internal shader MeshBufferFetchTestShader : ComputeShaderBase
    {
        stage ByteAddressBuffer Vertices;
        stage ByteAddressBuffer Indices;
        stage RWStructuredBuffer<float4> Output;

        stage uint IndexByteOffset;
        stage uint IndexSize;
        stage uint VertexByteOffset;
        stage uint VertexStride;

        override void Compute()
        {
            uint n = streams.DispatchThreadId.x;

            // A 16-bit index is in the low or high half of the 32-bit word that holds it
            uint indexAddress = IndexByteOffset + n * IndexSize;
            uint word = Indices.Load(indexAddress & ~3u);
            uint index = IndexSize == 4 ? word : (word >> ((indexAddress & 2u) * 8)) & 0xFFFFu;

            float3 position = asfloat(Vertices.Load3(VertexByteOffset + index * VertexStride));
            Output[n] = float4(position, index);
        }
    };
}
