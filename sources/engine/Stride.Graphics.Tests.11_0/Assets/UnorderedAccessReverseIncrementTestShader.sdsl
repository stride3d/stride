namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Increments each element of a read-write structured buffer, last element first: the first thread groups read
    /// what the last thread groups of a previous dispatch wrote.
    /// </summary>
    internal shader UnorderedAccessReverseIncrementTestShader : ComputeShaderBase
    {
        stage RWStructuredBuffer<uint> Data;
        stage uint Count;

        override void Compute()
        {
            uint index = Count - 1 - streams.DispatchThreadId.x;
            Data[index] = Data[index] + 1;
        }
    };
}
