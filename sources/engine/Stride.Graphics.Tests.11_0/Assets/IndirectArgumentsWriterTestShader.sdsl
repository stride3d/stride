namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Writes indirect call arguments on the GPU, one value per thread.
    /// </summary>
    internal shader IndirectArgumentsWriterTestShader : ComputeShaderBase
    {
        stage StructuredBuffer<uint> Source;
        stage RWBuffer<uint> Arguments;

        override void Compute()
        {
            Arguments[streams.DispatchThreadId.x] = Source[streams.DispatchThreadId.x];
        }
    };
}
