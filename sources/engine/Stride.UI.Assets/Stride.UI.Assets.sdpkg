!Package
SerializedVersion: {Assets: 3.1.0.0}
AssetFolders:
    -   Path: !dir Assets
ResourceFolders:
    - !dir Resources
TemplateFolders:
    - Path: !dir Templates/Assets
      Group: Assets
      Files:
        - !file Templates/Assets/UI/Library.sdtpl
        - !file Templates/Assets/UI/Page.sdtpl
