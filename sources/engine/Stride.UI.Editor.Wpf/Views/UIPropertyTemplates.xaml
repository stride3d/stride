<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Stride.UI;assembly=Stride.UI"
                    xmlns:views="clr-namespace:Stride.UI.Editor.Views"
                    xmlns:tp="clr-namespace:Stride.Core.Assets.Editor.View.TemplateProviders;assembly=Stride.Core.Assets.Editor.Wpf"
                    xmlns:sd="http://schemas.stride3d.net/xaml/presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Stride.Core.Assets.Editor.Wpf;component/View/DefaultPropertyTemplateProviders.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!--  Thickness arrows  -->
  <DrawingImage x:Key="ImageThicknessLeft" >
