<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideEditorTargetFramework)</TargetFramework>
    <!-- The UI editor view and the UI property templates are WPF -->
    <UseWPF>true</UseWPF>
    <StridePackageKind>Editor</StridePackageKind>
    <!-- The views of the WPF Game Studio; Stride.UI.Editor (toolkit-neutral) declares this package as its companion -->
    <StrideEditorToolkit>Wpf</StrideEditorToolkit>
    <!-- Indexes the [AssemblyScan] types (the editor views) the plugin registers -->
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\editor\Stride.Assets.Presentation.Wpf\Stride.Assets.Presentation.Wpf.csproj" />
    <ProjectReference Include="..\Stride.UI.Editor\Stride.UI.Editor.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
