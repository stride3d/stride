namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Fills the triangle with a color read from a per-instance vertex stream.
    /// </summary>
    shader InstancedDrawTestShader : ShaderBase
    {
        stage stream float2 Position : POSITION;
        stage stream float4 InstanceColor : COLOR;

        stage override void VSMain()
        {
            streams.ShadingPosition = float4(streams.Position, 0.0f, 1.0f);
        }

        stage override void PSMain()
        {
            streams.ColorTarget = streams.InstanceColor;
        }
    };
}
