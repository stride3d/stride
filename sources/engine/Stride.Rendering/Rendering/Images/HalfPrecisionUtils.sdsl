namespace Stride.Rendering.Images
{
    /// <summary>
    /// Helpers for values that end up in half-float render targets.
    /// </summary>
    shader HalfPrecisionUtils
    {
        /// <summary>
        /// Half the half-float maximum (65504), leaving headroom for the blurs and sums that follow.
        /// </summary>
        static const float MaxSafeValue = 32000.0;

        /// <summary>
        /// Clamps a color to [0, MaxSafeValue]. min/max return the other operand for a NaN, so a NaN is replaced too.
        /// </summary>
        static float3 ClampToSafeRange(float3 color)
        {
            return min(max(color, 0.0), MaxSafeValue);
        }
    };
}
