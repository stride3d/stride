namespace Stride.Rendering.Shadows
{
    /// <summary>
    /// Mixed into the shadow caster effects that keep a pixel shader, so that
    /// <see cref="ShadowMapCasterPassInfo"/> is set before the material chain runs.
    /// </summary>
    shader ShadowMapCasterPassMarker : ShadowMapCasterPassInfo, ShaderBase
    {
        override stage void PSMain()
        {
            streams.IsShadowMapCasterPass = ShadowMapViewFlag;
            base.PSMain();
        }
    };
}
