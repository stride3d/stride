namespace Stride.Rendering.Materials
{
    /// <summary>
    /// A see-through volume whose density is the same everywhere.
    /// </summary>
    shader MaterialSurfaceVolumeUniformDensity : IMaterialSurfacePixel, MaterialVolumeOpticalDepth
    {
        override void Compute()
        {
            streams.matVolumeDensity = 1;
        }
    };
}
