namespace Stride.Rendering.Materials
{
    /// <summary>
    /// Outputs the transmittance of an absorbing body, per colour channel, for a multiplicative blend over what is behind it.
    /// </summary>
    shader MaterialSurfaceVolumeTransmittance : IMaterialSurfacePixel, MaterialPixelShadingStream, MaterialVolumeOpticalDepth
    {
        cbuffer PerMaterial
        {
            [Link("MaterialVolume.ChannelAbsorption")]
            stage float3 VolumeChannelAbsorption;
        }

        override void Compute()
        {
            streams.shadingColor = exp(-ComputeVolumeOpticalDepth() * VolumeChannelAbsorption);
        }
    };
}
