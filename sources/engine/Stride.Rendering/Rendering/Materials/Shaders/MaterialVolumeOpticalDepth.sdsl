namespace Stride.Rendering.Materials
{
    /// <summary>
    /// The optical depth a face of a see-through volume blends over the scene behind it: its share of the sum of the thickness
    /// pass for its medium. The product of the shares is the transmittance of the whole ray, whatever the order the faces draw in.
    /// Visible front faces apply it; when the camera is inside a volume, every back face does too, hidden ones included, so a
    /// volume still shows from inside in front of a wall. Without the thickness pass, the material blends with its alpha as usual.
    /// </summary>
    shader MaterialVolumeOpticalDepth : MaterialPixelStream, ShaderBaseStream, PositionStream4, MaterialVolumeDepth
    {
        cbuffer PerMaterial
        {
            [Link("MaterialVolume.Absorption")]
            stage float VolumeAbsorption;

            [Link("MaterialVolume.Scattering")]
            stage float VolumeMediumScattering;
        }

        rgroup PerView.VolumeOpticalDepth
        {
            stage Texture2D VolumeOpticalDepth;
        }

        rgroup PerView.VolumeFaces
        {
            stage Texture2D VolumeFaces;
        }

        // Alpha a volume is clamped to, so a fully opaque one still has a finite optical depth
        static const float MaxAlpha = 0.999;

        float ComputeVolumeOpticalDepth()
        {
            int3 pixel = int3((int2)streams.ShadingPosition.xy, 0);
            bool front = streams.IsFrontFace;
            bool hidden = VolumeLinearDepth(streams.ShadingPosition.z) > VolumeSceneDepth(pixel.xy) * (1 + CoplanarTolerance);

            // This medium's sum and face counts: absorbing in x (xy for the faces), scattering in y (zw)
            float4 allFaces = round(VolumeFaces.Load(pixel) * FaceCountSteps);
            float2 faces = lerp(allFaces.xy, allFaces.zw, VolumeMediumScattering);
            float opticalDepth = lerp(VolumeOpticalDepth.Load(pixel).x, VolumeOpticalDepth.Load(pixel).y, VolumeMediumScattering);
            float hiddenFronts = floor(faces.x / HiddenFaceWeight);
            float visibleFronts = faces.x - hiddenFronts * HiddenFaceWeight;
            float fronts = visibleFronts + hiddenFronts;
            float backs = faces.y;

            if (fronts + backs < 0.5)
            {
                // No thickness pass, as in a shadow map: the front faces blend with the alpha
                clip(front ? 1 : -1);
                return -log(1 - min(streams.matDiffuseSpecularAlphaBlend.r, MaxAlpha));
            }

            bool inside = backs > fronts + 0.5;
            clip((front && !hidden) || (!front && inside) ? 1 : -1);
            float sharing = visibleFronts + (inside ? backs : 0);
            return max(opticalDepth, 0) / max(sharing, 1);
        }
    };
}
