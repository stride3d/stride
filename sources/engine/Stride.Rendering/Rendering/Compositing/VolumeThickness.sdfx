using Stride.Rendering.Materials;

namespace Stride.Rendering.Compositing
{
    // Spawn a sub-effect for the volume thickness pass of see-through materials whose opacity grows with thickness
    partial effect VolumeThickness
    {
        mixin MaterialVolumeThicknessPass;
    };
}
