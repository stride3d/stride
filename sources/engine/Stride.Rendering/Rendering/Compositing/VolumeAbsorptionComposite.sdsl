namespace Stride.Rendering.Compositing
{
    /// <summary>
    /// Applies the absorbing optical depth summed by the volume thickness pass to the opaque scene, for a multiplicative blend:
    /// transmittance plus the tint for what was absorbed. Optical depth is in alpha, tint times optical depth in rgb.
    /// </summary>
    shader VolumeAbsorptionComposite : ImageEffectShader
    {
        // Optical depth under which a pixel has no volume on it
        static const float MinOpticalDepth = 1e-5;

        stage override float4 Shading()
        {
            int3 pixel = int3((int2)streams.ShadingPosition.xy, 0);
            float4 sum = Texture0.Load(pixel);
            float opticalDepth = max(sum.a, 0);
            float3 tint = sum.rgb / max(opticalDepth, MinOpticalDepth);
            float transmittance = exp(-opticalDepth);
            float3 absorbed = transmittance + (1 - transmittance) * tint;
            return float4(opticalDepth > MinOpticalDepth ? absorbed : float3(1, 1, 1), 1);
        }
    };
}
