// Used as a lit diffuse color so both deformed directions contribute directly to the regression image.
shader DeformationBasisColor : ComputeColor, NormalStream
{
    override float4 Compute()
    {
        float3 combined = 0.5 * normalize(streams.meshNormal) + 0.5 * normalize(streams.meshTangent.xyz);
        return float4(combined * 0.5 + 0.5, 1);
    }
};
