<?xml version="1.0" encoding="utf-8"?>
<!-- The Android build merges this manifest into the manifest of every app that uses Stride.Graphics. It needs a package
     to be packed into the .aar. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.stride3d.graphics">
  <!-- The system Vulkan loader exposes Vulkan 1.3 only from Android 13 (API 33): an app with a lower minimum fails to
       build. Without it, the merger would also add the permissions it implies for a very old library. -->
  <uses-sdk android:minSdkVersion="33" />
  <!-- Google Play installs the app only on a device whose driver supports Vulkan 1.3, which the Vulkan backend requires. -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
</manifest>
