shader SinglePassWireframeShader : ShaderBase, Transformation, Texturing, PositionStream4
{
    noperspective stage stream float4 EdgeA;
    noperspective stage stream float4 EdgeB;
    stage stream float3 Normal : NORMAL;
    stage stream uint   Case;
    // Added to the distance to edge A, edge B and edge AB when they are the hidden diagonal of a quad
    stage stream float3 EdgeExclude;
    stage stream float3 PositionVS;
    // Normal of the triangle in view space, its sign does not matter
    stage stream float3 FaceNormalVS;

    static const uint infoA[]     = { 0, 0, 0, 0, 1, 1, 2 };
    static const uint infoB[]     = { 1, 1, 2, 0, 2, 1, 2 };
    static const uint infoAd[]    = { 2, 2, 1, 1, 0, 0, 0 };
    static const uint infoBd[]    = { 2, 2, 1, 2, 0, 2, 1 }; 
    static const uint infoEdge0[] = { 0, 2, 0, 0, 0, 0, 2 }; 
    static const float MinDepthDelta = 1e-6;
    // Farthest a line pixel looks for its own model on screen
    static const float MaxSearchRadius = 24;

    float LineWidth;
    float3 LineColor;
    float3 InsideColor;
    float3 OutsideColor;

    // Id buffer: the collidable id, view depth and facet error of the visual model each pixel shows, 0 elsewhere,
    // and the view depth of the first back face behind it
    Texture2D ModelIds;
    // View-space normal of the visual model's facet each pixel shows
    Texture2D ModelNormals;
    // 1 for an orthographic projection, where view rays are parallel
    float Orthographic;
    // 1 when ModelIds holds this frame's ids, so lines are told apart from their own model
    float CompareToModel;
    float ObjectId;
    // Farther than this plus the model's own facet error from its own model,
    // a line is colored as inside or outside it (view units)
    float Threshold;
    // Pixels per world unit at a view depth of 1, or anywhere with an orthographic projection
    float ProjectionScale;
    // 1 for the pass that draws, without depth test, the lines over their own model
    float ThroughOwnModel;
    float Dotted;
    // 0 for back faces: only the front surface of the own model is known, so they keep their color
    float Classify;

    cbuffer PerView
    {
        stage float4 Viewport;
    }

    float4 projToWorld(in float4 pos)
    {
        return mul(pos, WorldViewProjection);
    }

    float2 projToWindow(in float4 pos)
    {
        return float2(
            Viewport.x * 0.5 * (1 + (pos.x / pos.w)) + Viewport.z,
            Viewport.y * 0.5 * (1 - (pos.y / pos.w)) + Viewport.w
        );
    }

    // Cross product rather than Pythagoras, which loses all precision when the edge's origin is far off-screen
    float distanceToLine(float2 offset, float2 direction)
    {
        return abs(offset.x * direction.y - offset.y * direction.x);
    }

    // Projects 'to', moved along the edge onto the near plane if it is behind it, so the result stays on the edge's screen line
    float2 projectTowards(float4 from, float4 to)
    {
        float t = saturate(from.z / max(from.z - to.z, MinDepthDelta));
        return projToWindow(lerp(from, to, t));
    }

    float evalMinDistanceToEdges()
    {
        float dist;

        if (streams.Case == 0)
        {
            // the easy case, the 3 distances of the fragment to the 3 edges
            // is already computed, get the min

            dist = min(min(streams.EdgeA.x, streams.EdgeA.y), streams.EdgeA.z);
        }
        else
        {
            // the tricky case, compute the distances and get the min from 2D lines
            // given from the geometry shader

            float2 af = streams.ShadingPosition.xy - streams.EdgeA.xy;
            dist = distanceToLine(af, streams.EdgeA.zw) + streams.EdgeExclude.x;

            float2 bf = streams.ShadingPosition.xy - streams.EdgeB.xy;
            dist = min(dist, distanceToLine(bf, streams.EdgeB.zw) + streams.EdgeExclude.y);

            // only need to care about the 3rd edge for some cases
            if (streams.Case == 1 || streams.Case == 2 || streams.Case == 4)
            {
                dist = min(dist, distanceToLine(af, normalize(streams.EdgeB.xy - streams.EdgeA.xy)) + streams.EdgeExclude.z);
            }
        }

        return dist;
    }

    // geometry shader
    [maxvertexcount(3)]
    void GSMain(triangle Input input[3], inout TriangleStream<Output> triangleStream)
    {
        // project to world
        float4 positionWS[3];
        positionWS[0] = projToWorld(input[0].Position);
        positionWS[1] = projToWorld(input[1].Position);
        positionWS[2] = projToWorld(input[2].Position);

        // Compute the case from the positions of point in space.

        uint vertexCase
            = (positionWS[0].z < 0 ? 1 : 0) * 4 
            + (positionWS[1].z < 0 ? 1 : 0) * 2 
            + (positionWS[2].z < 0 ? 1 : 0);

        // Compute the case from the positions of point in space.
        if (vertexCase == 7)
        {
            return;
        }

        float3 faceNormal = normalize(cross(input[1].PositionVS - input[0].PositionVS, input[2].PositionVS - input[0].PositionVS));

        float2 points[3];
        points[0] = projToWindow(positionWS[0]);
        points[1] = projToWindow(positionWS[1]);
        points[2] = projToWindow(positionWS[2]);

        float3 vertExclude = float3(0, 0, 0);
        float excludeEdgeLength = LineWidth + 100;

        // general computation
        if (vertexCase == 0)
        {
            // compute the edges vectors of transformed triangle
            float2 edges[3];
            edges[0] = points[1] - points[0];
            edges[1] = points[2] - points[1];
            edges[2] = points[0] - points[2];

            // store the length of the edges
            float lengths[3];
            lengths[0] = length(edges[0]);
            lengths[1] = length(edges[1]);
            lengths[2] = length(edges[2]);

            float3 edgesWS[3];
            edgesWS[0] = input[1].Position.xyz - input[0].Position.xyz;
            edgesWS[1] = input[2].Position.xyz - input[1].Position.xyz;
            edgesWS[2] = input[0].Position.xyz - input[2].Position.xyz;

            float lengthsWS[3];
            lengthsWS[0] = length(edgesWS[0]);
            lengthsWS[1] = length(edgesWS[1]);
            lengthsWS[2] = length(edgesWS[2]);

            float maxLength = max(max(lengthsWS[0], lengthsWS[1]), lengthsWS[2]);

            vertExclude.x = lengthsWS[0] == maxLength ? 1 : 0;
            vertExclude.y = lengthsWS[1] == maxLength ? 1 : 0;
            vertExclude.z = lengthsWS[2] == maxLength ? 1 : 0;

            // compute the cos angle of each vertices
            float cosAngles[3];
            cosAngles[0] = dot(-edges[2], edges[0]) / (lengths[2] * lengths[0]);
            cosAngles[1] = dot(-edges[0], edges[1]) / (lengths[0] * lengths[1]);
            cosAngles[2] = dot(-edges[1], edges[2]) / (lengths[1] * lengths[2]);

            // the height for each vertices of triangle
            float heights[3];
            heights[1] = lengths[0] * sqrt(1 - cosAngles[0] * cosAngles[0]);
            heights[2] = lengths[1] * sqrt(1 - cosAngles[1] * cosAngles[1]);
            heights[0] = lengths[2] * sqrt(1 - cosAngles[2] * cosAngles[2]);

            float edgeSigns[3];
            edgeSigns[0] = (edges[0] > 0 ? 1 : -1);
            edgeSigns[1] = (edges[1] > 0 ? 1 : -1);
            edgeSigns[2] = (edges[2] > 0 ? 1 : -1);

            float edgeOffsets[3];
            edgeOffsets[0] = lengths[0] * (0.5 - 0.5 * edgeSigns[0]);
            edgeOffsets[1] = lengths[1] * (0.5 - 0.5 * edgeSigns[1]);
            edgeOffsets[2] = lengths[2] * (0.5 - 0.5 * edgeSigns[2]);

            // vertex 0
            streams = input[0];
            streams.Case = vertexCase;
            streams.FaceNormalVS = faceNormal;
            streams.EdgeA[0] = vertExclude.x * excludeEdgeLength;
            streams.EdgeA[1] = heights[0];
            streams.EdgeA[2] = vertExclude.z * excludeEdgeLength;
            streams.EdgeB[0] = edgeOffsets[0];
            streams.EdgeB[1] = edgeOffsets[1] + edgeSigns[1] * cosAngles[1] * lengths[0];
            streams.EdgeB[2] = edgeOffsets[2] + edgeSigns[2] * lengths[2];
            triangleStream.Append(streams);

            // vertex 1
            streams = input[1];
            streams.Case = vertexCase;
            streams.FaceNormalVS = faceNormal;
            streams.EdgeA[0] = vertExclude.x * excludeEdgeLength;
            streams.EdgeA[1] = vertExclude.y * excludeEdgeLength;
            streams.EdgeA[2] = heights[1];
            streams.EdgeB[0] = edgeOffsets[0] + edgeSigns[0] * lengths[0];
            streams.EdgeB[1] = edgeOffsets[1];
            streams.EdgeB[2] = edgeOffsets[2] + edgeSigns[2] * cosAngles[2] * lengths[1];
            triangleStream.Append(streams);

            // vertex 2
            streams = input[2];
            streams.Case = vertexCase;
            streams.FaceNormalVS = faceNormal;
            streams.EdgeA[0] = heights[2];
            streams.EdgeA[1] = vertExclude.y * excludeEdgeLength;
            streams.EdgeA[2] = vertExclude.z * excludeEdgeLength;
            streams.EdgeB[0] = edgeOffsets[0] + edgeSigns[0] * cosAngles[0] * lengths[2];
            streams.EdgeB[1] = edgeOffsets[1] + edgeSigns[1] * lengths[1];
            streams.EdgeB[2] = edgeOffsets[2];
            triangleStream.Append(streams);

            triangleStream.RestartStrip();
        }
        else
        {
            // Else need some tricky computations
            uint a = infoA[vertexCase];
            uint b = infoB[vertexCase];
            float lengthA = length(input[a].Position.xyz - input[infoAd[vertexCase]].Position.xyz);
            float lengthB = length(input[b].Position.xyz - input[infoBd[vertexCase]].Position.xyz);
            float lengthAB = length(input[a].Position.xyz - input[b].Position.xyz);
            float maxLength = max(max(length(input[1].Position.xyz - input[0].Position.xyz), length(input[2].Position.xyz - input[1].Position.xyz)), length(input[0].Position.xyz - input[2].Position.xyz));
            float3 edgeExclude = float3(lengthA == maxLength, lengthB == maxLength, lengthAB == maxLength) * excludeEdgeLength;

            for (int i = 0; i < 3; i++)
            {
                streams = input[i];

                streams.EdgeA = float4(0, 0, 0, 0);
                streams.EdgeB = float4(0, 0, 0, 0);

                streams.Case = vertexCase;
                streams.FaceNormalVS = faceNormal;
                streams.EdgeExclude = edgeExclude;
                streams.EdgeA.xy = points[a];
                streams.EdgeB.xy = points[b];

                streams.EdgeA.zw = normalize(streams.EdgeA.xy - projectTowards(positionWS[a], positionWS[infoAd[vertexCase]]));
                streams.EdgeB.zw = normalize(streams.EdgeB.xy - projectTowards(positionWS[b], positionWS[infoBd[vertexCase]]));

                triangleStream.Append(streams);
            }

            triangleStream.RestartStrip();
        }
    }

    float isOwnModel(float4 model)
    {
        return step(abs(model.x - ObjectId), 0.5);
    }

    // Whether the own model shows close enough, on screen, to a line pixel drawn over something else:
    // within the debug mesh's error plus the facet error of the model found there
    float ownModelNearby(float2 pixel, float depth)
    {
        float pixelsPerUnit = ProjectionScale / lerp(max(depth, MinDepthDelta), 1, Orthographic);
        float found = 0;
        for (float radius = 1; radius <= MaxSearchRadius && found < 0.5; radius++)
        {
            for (int i = 0; i < 16; i++)
            {
                float angle = i * 0.392699;
                float4 model = ModelIds.Load(int3(pixel + float2(cos(angle), sin(angle)) * radius, 0));
                float reach = (Threshold + model.z) * pixelsPerUnit + 0.5 * LineWidth + 1;
                found = max(found, isOwnModel(model) * step(radius, reach));
            }
        }
        return found;
    }

    // The model's surface on this fragment's view ray, from the depth the id buffer holds
    float3 modelOnRay(float modelDepth)
    {
        return lerp(streams.PositionVS * (modelDepth / min(streams.PositionVS.z, -MinDepthDelta)), float3(streams.PositionVS.xy, modelDepth), Orthographic);
    }

    // Whether the line is farther from the model the pixel shows than the debug mesh's and the model's errors allow.
    // Along the view ray, a gap seen at a grazing angle looks far larger than it is: measured along the normal of the
    // line's face and along the normal of the model's facet, it only grows when that face, or that facet, is seen edge-on
    float isBeyond(int2 pixel)
    {
        float4 model = ModelIds.Load(int3(pixel, 0));
        float3 gap = modelOnRay(model.y) - streams.PositionVS;
        float3 modelNormal = ModelNormals.Load(int3(pixel, 0)).xyz;
        // A neighbor showing something else does not vote against
        return 1 - isOwnModel(model) * step(min(abs(dot(gap, streams.FaceNormalVS)), abs(dot(gap, modelNormal))), Threshold + model.z);
    }

    // vertex shader
    stage override void VSMain()
    {
        float4 positionVS = mul(streams.Position, WorldView);
        streams.PositionVS = positionVS.xyz;
        streams.ShadingPosition = mul(positionVS, Projection);
    }

    // pixel shader
    stage override void PSMain()
    {
        float dist = evalMinDistanceToEdges();
        if (dist > 0.5 * LineWidth)
        {
            // too far from edge
            discard;
        }

        // Dashes for the back faces, from a screen-space checker so any line direction crosses them
        float2 cell = floor(streams.ShadingPosition.xy * 0.25);
        if (Dotted * frac((cell.x + cell.y) * 0.5) > 0.25)
            discard;

        float4 model = ModelIds.Load(int3(streams.ShadingPosition.xy, 0));
        float own = isOwnModel(model) * CompareToModel;
        float hidden = own * step(-model.y * (1 + 1e-4), -streams.PositionVS.z);
        // Everything over its own model, so a line lying on it is drawn even where the depth test missed it by a hair
        if (ThroughOwnModel * (1 - own) > 0.5)
            discard;

        // Only where their result is used: the outline search alone reads up to 384 texels
        // The neighbors too, so a pixel on the seam between two facets seen edge-on does not decide alone
        int2 pixel = int2(streams.ShadingPosition.xy);
        float beyond = 0;
        if (Classify * own > 0.5)
            beyond = isBeyond(pixel) * isBeyond(pixel + int2(1, 0)) * isBeyond(pixel - int2(1, 0)) * isBeyond(pixel + int2(0, 1)) * isBeyond(pixel - int2(0, 1));
        float outsideBeyondOutline = 0;
        if (Classify * CompareToModel * (1 - own) > 0.5)
            outsideBeyondOutline = 1 - ownModelNearby(streams.ShadingPosition.xy, -streams.PositionVS.z);
        // Behind the back face of the part it shows through, a line is behind that part rather than in it
        float inFirstPart = step(-streams.PositionVS.z, -model.w + Threshold + model.z);
        float inside = Classify * hidden * inFirstPart * beyond;
        float outsideOver = Classify * own * (1 - hidden) * beyond;
        float3 color = lerp(LineColor, InsideColor, inside);
        color = lerp(color, OutsideColor, max(outsideOver, outsideBeyondOutline));
        streams.ColorTarget = float4(color, 1);
    }
};
