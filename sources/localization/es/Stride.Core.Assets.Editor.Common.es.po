msgctxt "Message"
msgid "A package with the same name already exists in the session."
msgstr "Un paquete con el mismo nombre ya existe en la sesión."

#: ../editor/Stride.Core.Assets.Editor.Common/ViewModel/SessionObjectViewModel.cs:110
msgctxt "Message"
msgid "The name is too long."
msgstr "El nombre es demasiado largo."

#: ../editor/Stride.Core.Assets.Editor.Common/ViewModel/SessionObjectViewModel.cs:116
msgctxt "Message"
msgid "The name contains invalid characters."
msgstr "El nombre contiene caracteres no válidos."

#: ../editor/Stride.Core.Assets.Editor.Common/ViewModel/SessionObjectViewModel.cs:122
