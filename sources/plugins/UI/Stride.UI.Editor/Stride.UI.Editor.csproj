<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--serialization --parameter-key</StrideAssemblyProcessorOptions>
    <StridePackageKind>Editor</StridePackageKind>
    <StrideLocalized>true</StrideLocalized>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UI editor's WPF views: the WPF Game Studio loads them, another toolkit's editor does not -->
    <StrideCompanionProject Include="..\Stride.UI.Editor.Wpf\Stride.UI.Editor.Wpf.csproj" />
    <!-- Its Avalonia views: the Avalonia editor loads them, the WPF Game Studio does not -->
    <StrideCompanionProject Include="..\Stride.UI.Editor.Avalonia\Stride.UI.Editor.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\editor\Stride.Assets.Editor\Stride.Assets.Editor.csproj" />
    <ProjectReference Include="..\Stride.UI\Stride.UI.csproj" />
    <ProjectReference Include="..\Stride.UI.Assets\Stride.UI.Assets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\*.png" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
