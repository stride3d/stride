<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--serialization</StrideAssemblyProcessorOptions>
    <StridePackageKind>Editor</StridePackageKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\editor\Stride.Assets.Presentation.Common\Stride.Assets.Presentation.Common.csproj" />
    <ProjectReference Include="..\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\Stride.Physics.Assets\Stride.Physics.Assets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed for NavigationMeshTile.Data (DtMeshData): Stride.Navigation doesn't flow DotRecast at compile time -->
    <PackageReference Include="DotRecast.Detour" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\PhysicsComponent.png" />
    <EmbeddedResource Include="Resources\PhysicsConstraintComponent.png" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
