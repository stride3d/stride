namespace Stride.Heightfield
{
    shader HeightfieldSinusoidalWaveShader<float TilingX, float TilingY> : ComputeColor, HeightfieldDisplacementProperties, PositionStream, NormalStream, Transformation, Texturing
    {
        override float4 Compute()
        {
            float2 uv = streams.TexCoord * float2(TilingX, TilingY);
            return sin(uv.x) * cos(uv.y);
        }
    };
}
