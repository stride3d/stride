<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--auto-module-initializer --serialization</StrideAssemblyProcessorOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.PackageManagement" />
    <PackageReference Include="NuGet.Resolver" />
    <PackageReference Include="NuGet.Commands" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Include="..\..\shared\Stride.NuGetResolver\NuGetResolverCache.cs" Link="NuGetResolverCache.cs" />
    <Compile Update="TargetGenerator.cs">
      <DependentUpon>TargetGenerator.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Stride.Core.Design\Stride.Core.Design.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TargetGenerator.tt">
      <Generator>TextTemplatingFilePreprocessor</Generator>
      <LastGenOutput>TargetGenerator.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <!-- The packages the SDK prunes from a restore for this project's framework: NugetStore prunes them from the restores it runs itself. -->
  <Target Name="_StrideEmbedPackagesToPrune" BeforeTargets="BeforeBuild" DependsOnTargets="AddPrunePackageReferences">
    <WriteLinesToFile File="$(IntermediateOutputPath)PackagesToPrune.txt" Lines="@(PrunePackageReference->'%(Identity)|%(Version)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)PackagesToPrune.txt" LogicalName="PackagesToPrune.txt" />
      <FileWrites Include="$(IntermediateOutputPath)PackagesToPrune.txt" />
    </ItemGroup>
  </Target>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
