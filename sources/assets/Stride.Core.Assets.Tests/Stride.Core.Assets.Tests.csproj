<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The test asset types are never consumed by a game: no runtime declares their extensions -->
    <NoWarn>$(NoWarn);STRDIAG014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\core\Stride.Core.Design.Tests\TestMemberPathBase.cs">
      <Link>TestMemberPathBase.cs</Link>
    </Compile>
    <!-- The resolver isn't in a referenced assembly: compile it here, as Stride.Cli does -->
    <Compile Include="..\..\shared\Stride.NuGetResolver\RestoreHelper.cs" Link="Shared\RestoreHelper.cs" />
    <Compile Include="..\..\shared\Stride.NuGetResolver\GraphicsApiSelector.cs" Link="Shared\GraphicsApiSelector.cs" />
    <Compile Include="..\..\shared\Stride.NuGetResolver\NuGetResolverCache.cs" Link="Shared\NuGetResolverCache.cs" />
    <!-- The bundle packer of the asset compiler, which is a program -->
    <Compile Include="..\Stride.AssetCompiler\BundlePacker.cs" Link="Shared\BundlePacker.cs" />
    <Compile Include="..\Stride.AssetCompiler\ResolvedBundle.cs" Link="Shared\ResolvedBundle.cs" />
    <!-- The pack step of the asset compiler, which is a program: compile it here, as Stride.Core.Tasks does -->
    <Compile Include="..\Stride.AssetCompiler\Tasks\PackAssets.cs" Link="Shared\PackAssets.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Assets\Stride.Assets.csproj" />
    <ProjectReference Include="..\..\tests\Stride.XunitRunner\Stride.XunitRunner.csproj" />
    <ProjectReference Include="..\Stride.Core.Assets\Stride.Core.Assets.csproj" />
    <!-- The test upgraders change the loaded project; MSBuild itself comes from the SDK at run time -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="data\TestPackage\SubPackage\SubPackage.sdpkg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="data\TestPackage\SubFolder\TestAsset.sdtest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data\TestPackage\TestAsset.sdtest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="data\TestPackage\TestPackageLoadingWithAssets.sdpkg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="data\TestSerializing\TestSerializing_TestMyAssetObject_Reference.sdobj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="data\TestFileVersionManager\test.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="data\TestPackage\TestRaw.sdraw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="data\TestBasicPackageCreateSaveLoad\TestPackage_TestBasicPackageCreateSaveLoad_Reference.sdpkg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.targets" />
</Project>
