<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 
  *****************************************************************************************************************************
  User documentation file (.usrdoc) generation
  *****************************************************************************************************************************
  -->

  <PropertyGroup Condition="'$(DocumentationFile)' != '' AND '$(GenerateDocumentationFile)' == 'true'">
    <StrideUserDocumentationFile>$([System.IO.Path]::ChangeExtension('$(DocumentationFile)', '.usrdoc'))</StrideUserDocumentationFile>
  </PropertyGroup>

  <UsingTask TaskName="StrideExtractUserDocumentation"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <XmlFile    ParameterType="System.String" Required="true" />
      <TargetFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var result = new Dictionary<string, string>();

        var regex = new Regex("[ ]{2,}", RegexOptions.None);
        var document = XElement.Load(XmlFile);
        foreach (var member in document.Descendants("member"))
        {
            var nameAttribute = member.Attribute("name");
            if (nameAttribute == null)
                continue;

            foreach (var userdocElement in member.Descendants("userdoc"))
            {
                var key = nameAttribute.Value;
                if (!key.StartsWith("P:", StringComparison.Ordinal) && !key.StartsWith("F:", StringComparison.Ordinal))
                    continue;

                if (userdocElement.HasElements)
                {
                    Log.LogWarning("User documentation for {0} in {1} has child elements, which is not supported. Only text content is supported.", key, XmlFile);
                    continue;
                }

                var userdoc = userdocElement.Value;
                userdoc = userdoc.Replace('\t', ' ').Replace('\r', ' ').Replace('\n', ' ').Trim();
                userdoc = regex.Replace(userdoc, " ");// Removes double space.

                if (string.IsNullOrEmpty(userdoc))
                    continue;

                if (result.ContainsKey(key))
                {
                    Log.LogWarning("Duplicate user documentation for {0} in {1}", key, XmlFile);
                }
                else
                {
                    result[key] = userdoc;
                }
            }
        }

        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(TargetFile)));
        using (var writer = new StreamWriter(TargetFile))
        {
            foreach (var entry in result)
            {
                writer.WriteLine("{0}={1}", entry.Key, entry.Value);
            }
        }
        Log.LogMessage(MessageImportance.Low, "Wrote user documentation to " + TargetFile);
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_StrideExtractUserDocumentation"
          AfterTargets="CoreCompile"
          Condition="'$(DocumentationFile)' != '' AND '$(StrideUserDocumentationFile)' != '' AND Exists('$(DocumentationFile)') AND '$(DesignTimeBuild)' != 'true'"
          Inputs="$(DocumentationFile)"
          Outputs="$(StrideUserDocumentationFile)">

    <StrideExtractUserDocumentation XmlFile="$(DocumentationFile)" TargetFile="$(StrideUserDocumentationFile)" />
    <ItemGroup>
      <FileWrites Include="$(StrideUserDocumentationFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_StrideCopyUserDocumentation"
          AfterTargets="_StrideExtractUserDocumentation"
          Condition="'$(StrideUserDocumentationFile)' != '' AND Exists('$(StrideUserDocumentationFile)') AND '$(DesignTimeBuild)' != 'true'">

    <!-- Copy .usrdoc from intermediate to output directory -->
    <Copy SourceFiles="$(StrideUserDocumentationFile)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="$(SkipCopyUnchangedFiles)"
          OverwriteReadOnlyFiles="$(OverwriteReadOnlyFiles)"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          UseHardlinksIfPossible="$(CreateHardLinksForCopyFilesToOutputDirectoryIfPossible)"
          UseSymboliclinksIfPossible="$(CreateSymbolicLinksForCopyFilesToOutputDirectoryIfPossible)">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites"/>
    </Copy>
  </Target>

</Project>
