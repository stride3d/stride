<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 
  *****************************************************************************************************************************
  User documentation file (.usrdoc) generation
  *****************************************************************************************************************************
  -->

  <UsingTask TaskName="ExtractUserDocumentation"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <XmlFile    ParameterType="System.String" Required="true" />
      <TargetFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var result = new Dictionary<string, string>();

        var regex = new Regex("[ ]{2,}", RegexOptions.None);
        var document = XElement.Load(XmlFile);
        foreach (var member in document.Descendants("member"))
        {
            var nameAttribute = member.Attribute("name");
            if (nameAttribute == null)
                continue;

            foreach (var userdocElement in member.Descendants("userdoc"))
            {
                var key = nameAttribute.Value;
                if (!key.StartsWith("P:", StringComparison.Ordinal) && !key.StartsWith("F:", StringComparison.Ordinal))
                    continue;

                var userdoc = userdocElement.Value;
                userdoc = userdoc.Replace('\t', ' ').Replace('\r', ' ').Replace('\n', ' ').Trim();
                userdoc = regex.Replace(userdoc, " ");// Removes double space.

                result[key] = userdoc;
            }
        }

        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(TargetFile)));
        using (var writer = new StreamWriter(TargetFile))
        {
            foreach (var entry in result)
            {
                writer.WriteLine("{0}={1}", entry.Key, entry.Value);
            }
        }
        Log.LogMessage(MessageImportance.High, "Wrote user documentation to " + TargetFile);
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ExtractUserDocumentation"
          AfterTargets="CoreCompile"
          Condition="'$(DocumentationFile)' != '' AND '$(GenerateDocumentationFile)' == 'true' AND Exists('$(DocumentationFile)')"
          Inputs="$(DocumentationFile)"
          Outputs="$(IntermediateOutputPath)$(AssemblyName).usrdoc">

    <ExtractUserDocumentation XmlFile="$(DocumentationFile)" TargetFile="$(IntermediateOutputPath)$(AssemblyName).usrdoc" />
  </Target>

  <Target Name="AddUserDocumentationToOutput"
          AfterTargets="ExtractUserDocumentation"
          Condition="'$(DocumentationFile)' != '' AND '$(GenerateDocumentationFile)' == 'true' AND Exists('$(IntermediateOutputPath)$(AssemblyName).usrdoc')">
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)$(AssemblyName).usrdoc"
            Link="$(AssemblyName).usrdoc"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
