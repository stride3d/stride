<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Derived asset-build manifest (.sdbuild): per-TFM artifact in obj/ describing what the
       asset compiler needs from this project (authored package, asset items, assemblies to
       load, referenced manifests, NuGet lock file). Regenerated on every build, written only
       when content changes so downstream timestamps stay stable. -->

  <PropertyGroup>
    <StrideAssetBuildManifest Condition="'$(StrideAssetBuildManifest)' == ''">true</StrideAssetBuildManifest>
    <!-- Project-source asset extensions captured into the manifest. Declared by the asset-owning
         layer next to where it globs the files (shaders in Stride.targets / Sdk.targets); a plugin
         appends its own in its buildTransitive .targets. -->
    <!-- A companion package (StridePackageKind: Assets or Editor) is loaded by a host by definition. -->
    <StrideContainsAssetTypes Condition="'$(StrideContainsAssetTypes)' == '' And '$(StridePackageKind)' != ''">true</StrideContainsAssetTypes>
    <!-- Game/code projects' scripts are asset types, so the asset compiler must load their assembly;
         default it on for consumers (StrideRoot empty, or dev-redirect where the stub also sets
         StrideDevRoot). The engine source tree and test SDK set it explicitly; opt out =false. -->
    <StrideContainsAssetTypes Condition="'$(StrideContainsAssetTypes)' == '' And ('$(StrideRoot)' == '' Or '$(StrideDevRoot)' != '')">true</StrideContainsAssetTypes>
  </PropertyGroup>

  <!-- Expose the extension list to the STRDIAG011 analyzer as a comma-separated copy (editorconfig
       treats ';' as a comment). Computed in a target so it sees the fully-appended value. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="StrideProjectAssetExtensionsForAnalyzer" />
  </ItemGroup>
  <Target Name="_StrideExposeProjectAssetExtensions" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
    <PropertyGroup>
      <StrideProjectAssetExtensionsForAnalyzer>$(StrideProjectAssetExtensions.Replace(';', ','))</StrideProjectAssetExtensionsForAnalyzer>
    </PropertyGroup>
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <StrideAssetBuildManifestPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).sdbuild'))</StrideAssetBuildManifestPath>
  </PropertyGroup>

  <Target Name="GetStrideAssetBuildManifestPath" Returns="$(StrideAssetBuildManifestPath)" />

  <!-- This project's declared project-asset extensions, harvested across ProjectReferences below
       (a ProjectReference doesn't import the referenced project's buildTransitive targets, so its
       extensions don't otherwise reach the consumer). -->
  <Target Name="GetStrideProjectAssetExtensions" Returns="$(StrideProjectAssetExtensions)" />

  <!-- Companion packages: a package lists the projects (StrideCompanionProject items) and packages
       (StrideCompanionPackage items, with Version and Kind) a host loads on its behalf; a companion project
       states what it carries (StridePackageKind: Assets or Editor). A project's package id, version and kind
       are read from the project itself, so the packed sdpkg and the build manifest declare the real ids; the
       manifest keeps the project paths too. A Replaces list (';'-separated ids) on either item names companion
       packages declared elsewhere that this one stands in for.
       GetPackageVersionDependsOn is NuGet's hook for targets that change PackageVersion before it is read
       (the Stride worktree suffix is appended there), so the version matches the packed nupkg. -->
  <Target Name="GetStridePackageIdentity" DependsOnTargets="$(GetPackageVersionDependsOn)" Returns="@(_StridePackageIdentity)">
    <PropertyGroup>
      <_StridePackageIdentityId>$(PackageId)</_StridePackageIdentityId>
      <_StridePackageIdentityId Condition="'$(_StridePackageIdentityId)' == ''">$(AssemblyName)</_StridePackageIdentityId>
      <_StridePackageIdentityId Condition="'$(_StridePackageIdentityId)' == ''">$(MSBuildProjectName)</_StridePackageIdentityId>
      <_StridePackageIdentityVersion>$(PackageVersion)</_StridePackageIdentityVersion>
      <_StridePackageIdentityVersion Condition="'$(_StridePackageIdentityVersion)' == ''">$(Version)</_StridePackageIdentityVersion>
      <_StridePackageIdentityVersion Condition="'$(_StridePackageIdentityVersion)' == ''">1.0.0</_StridePackageIdentityVersion>
      <_StridePackageIdentityKind>$(StridePackageKind)</_StridePackageIdentityKind>
      <_StridePackageIdentityKind Condition="'$(_StridePackageIdentityKind)' == ''">Runtime</_StridePackageIdentityKind>
    </PropertyGroup>
    <ItemGroup>
      <_StridePackageIdentity Include="$(_StridePackageIdentityId)" Version="$(_StridePackageIdentityVersion)" Kind="$(_StridePackageIdentityKind)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <_StrideCompanionProject Include="@(StrideCompanionProject->'%(FullPath)')" />
  </ItemGroup>

  <Target Name="_StrideCheckCompanionDeclarations" Condition="'@(_StrideCompanionProject)' != '' Or '@(StrideCompanionPackage)' != ''">
    <!-- A batched task over an empty list runs once with empty metadata, hence the list guards -->
    <Error Condition="'@(_StrideCompanionProject)' != '' And !Exists('%(_StrideCompanionProject.Identity)')" Text="StrideCompanionProject '%(_StrideCompanionProject.Identity)' does not exist." />
    <Error Condition="'@(StrideCompanionPackage)' != '' And '%(StrideCompanionPackage.Kind)' != 'Assets' And '%(StrideCompanionPackage.Kind)' != 'Editor'" Text="StrideCompanionPackage '%(StrideCompanionPackage.Identity)' must have a Kind of Assets or Editor." />
    <Error Condition="'@(StrideCompanionPackage)' != '' And '%(StrideCompanionPackage.Version)' == ''" Text="StrideCompanionPackage '%(StrideCompanionPackage.Identity)' must have a Version." />
  </Target>

  <!-- Joins the companion projects with the identities they answered (by MSBuildSourceProjectFile) and appends the
       companions declared by package: one _StrideCompanion item each, with Project (empty for a package), PackageId,
       PackageVersion, Kind and Replaces. -->
  <UsingTask TaskName="StrideJoinCompanionPackages"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CompanionProjects ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <CompanionPackages ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Identities ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Companions ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var result = new List<Microsoft.Build.Framework.ITaskItem>();
        var identities = Identities ?? new Microsoft.Build.Framework.ITaskItem[0];
        foreach (var project in CompanionProjects ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var path = Path.GetFullPath(project.GetMetadata("FullPath"));
            var identity = identities.FirstOrDefault(i => string.Equals(Path.GetFullPath(i.GetMetadata("MSBuildSourceProjectFile")), path, StringComparison.OrdinalIgnoreCase));
            var item = new Microsoft.Build.Utilities.TaskItem(path);
            item.SetMetadata("Project", path);
            item.SetMetadata("PackageId", identity != null ? identity.ItemSpec : "");
            item.SetMetadata("PackageVersion", identity != null ? identity.GetMetadata("Version") : "");
            item.SetMetadata("Kind", identity != null ? identity.GetMetadata("Kind") : "");
            item.SetMetadata("Replaces", project.GetMetadata("Replaces"));
            result.Add(item);
        }
        foreach (var package in CompanionPackages ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var item = new Microsoft.Build.Utilities.TaskItem(package.ItemSpec);
            item.SetMetadata("Project", "");
            item.SetMetadata("PackageId", package.ItemSpec);
            item.SetMetadata("PackageVersion", package.GetMetadata("Version"));
            item.SetMetadata("Kind", package.GetMetadata("Kind"));
            item.SetMetadata("Replaces", package.GetMetadata("Replaces"));
            result.Add(item);
        }
        Companions = result.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The companion list (_StrideCompanion) for the manifest and the packed sdpkg: every entry with its id, version
       and kind. A companion project that was never restored (only a solution restore covers it: it is no project
       reference of anything) has no Stride targets and answers nothing: it is restored here, then asked again.
       A restore inside a build needs an evaluation of its own (MSBuildRestoreSessionId), and so does the second
       question (another _StrideCompanionEvaluation), since the first one is cached without the Stride targets. The
       first question also gets an evaluation of its own, so the build's evaluation of the companion, when an
       executable below builds it, is never one cached before the restore. The values are fixed, not unique: every
       inner build of a multi-target project asks the same, so MSBuild restores and reads each companion once and
       the other inner builds wait for that result instead of restoring it in parallel. -->
  <Target Name="_StrideResolveCompanionProjects" DependsOnTargets="_StrideCheckCompanionDeclarations" Condition="'@(_StrideCompanionProject)' != '' Or '@(StrideCompanionPackage)' != ''">
    <MSBuild Projects="@(_StrideCompanionProject->Distinct())"
             Targets="GetStridePackageIdentity"
             Properties="_StrideCompanionEvaluation=identity"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             SkipNonexistentTargets="true"
             Condition="'@(_StrideCompanionProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideCompanionIdentity" />
    </MSBuild>
    <ItemGroup>
      <_StrideCompanion Remove="@(_StrideCompanion)" />
    </ItemGroup>
    <StrideJoinCompanionPackages CompanionProjects="@(_StrideCompanionProject)" CompanionPackages="@(StrideCompanionPackage)" Identities="@(_StrideCompanionIdentity)">
      <Output TaskParameter="Companions" ItemName="_StrideCompanion" />
    </StrideJoinCompanionPackages>

    <ItemGroup>
      <_StrideUnrestoredCompanion Include="@(_StrideCompanion)" Condition="'%(_StrideCompanion.Project)' != '' And '%(_StrideCompanion.PackageId)' == ''" />
    </ItemGroup>
    <MSBuild Projects="@(_StrideUnrestoredCompanion)"
             Targets="Restore"
             Properties="MSBuildRestoreSessionId=StrideCompanionRestore"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             Condition="'@(_StrideUnrestoredCompanion)' != ''" />
    <MSBuild Projects="@(_StrideUnrestoredCompanion)"
             Targets="GetStridePackageIdentity"
             Properties="_StrideCompanionEvaluation=restored"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             SkipNonexistentTargets="true"
             Condition="'@(_StrideUnrestoredCompanion)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideRestoredCompanionIdentity" />
    </MSBuild>
    <StrideJoinCompanionPackages CompanionProjects="@(_StrideUnrestoredCompanion)" Identities="@(_StrideRestoredCompanionIdentity)" Condition="'@(_StrideUnrestoredCompanion)' != ''">
      <Output TaskParameter="Companions" ItemName="_StrideRestoredCompanion" />
    </StrideJoinCompanionPackages>
    <ItemGroup>
      <_StrideCompanion Remove="@(_StrideUnrestoredCompanion)" />
      <_StrideCompanion Include="@(_StrideRestoredCompanion)" />
    </ItemGroup>

    <Error Condition="'%(_StrideCompanion.Project)' != '' And '%(_StrideCompanion.PackageId)' == ''"
           Text="The package id and version of companion project '%(_StrideCompanion.Project)' could not be read; the project must reference Stride packages." />
    <Error Condition="'%(_StrideCompanion.Kind)' != 'Assets' And '%(_StrideCompanion.Kind)' != 'Editor'"
           Text="Companion project '%(_StrideCompanion.Project)' must declare StridePackageKind as Assets or Editor." />
  </Target>

  <!-- In-solution companions: a game references a plugin's runtime project only, like it references its package.
       The companions declared by this project and, recursively, by the projects it references (the same project
       references the manifest chain follows), for an executable to build below. -->
  <Target Name="GetStrideCompanionProjects" DependsOnTargets="_StrideResolveCompanionProjects;PrepareProjectReferences" Returns="@(_StrideDeclaredCompanion)">
    <ItemGroup>
      <_StrideDeclaredCompanion Include="@(_StrideCompanion)" />
      <_StrideCompanionSourceProjectReference Include="@(_MSBuildProjectReferenceExistent)"
                                              Condition="'%(_MSBuildProjectReferenceExistent.ReferenceOutputAssembly)' != 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_StrideCompanionSourceProjectReference)"
             Targets="GetStrideCompanionProjects"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_StrideCompanionSourceProjectReference.SetConfiguration); %(_StrideCompanionSourceProjectReference.SetPlatform); %(_StrideCompanionSourceProjectReference.SetTargetFramework)"
             RemoveProperties="%(_StrideCompanionSourceProjectReference.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true"
             Condition="'@(_StrideCompanionSourceProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideDeclaredCompanion" />
    </MSBuild>
  </Target>

  <!-- Picks the companion projects an executable builds out of the declarations: each project once, not one that
       a declaration replaces (Replaces of any entry), Assets kind only (the asset compiler never loads an Editor
       companion). -->
  <UsingTask TaskName="StrideSelectCompanionProjects"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Companions ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Selected ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var companions = Companions ?? new Microsoft.Build.Framework.ITaskItem[0];
        var replaced = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var companion in companions)
        {
            foreach (var name in companion.GetMetadata("Replaces").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                replaced.Add(name.Trim());
        }
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var result = new List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var companion in companions)
        {
            var project = companion.GetMetadata("Project");
            if (string.IsNullOrWhiteSpace(project))
                continue;
            var path = Path.GetFullPath(project);
            if (!seen.Add(path))
                continue;
            if (replaced.Contains(companion.GetMetadata("PackageId")) || !string.Equals(companion.GetMetadata("Kind"), "Assets", StringComparison.OrdinalIgnoreCase))
                continue;
            // Only the companion metadata: an item that came back from another project's targets also carries
            // MSBuildSourceProjectFile, which the answers to the calls below would keep (the join goes by it)
            var item = new Microsoft.Build.Utilities.TaskItem(path);
            foreach (var name in new[] { "Project", "PackageId", "PackageVersion", "Kind", "Replaces" })
                item.SetMetadata(name, companion.GetMetadata(name));
            result.Add(item);
        }
        Selected = result.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- An executable (the project whose build runs the asset compiler; StrideBuildCompanionProjects overrides)
       builds the Assets companions declared along its project references and lists their manifests in its own,
       so the asset compiler finds them like referenced projects. A library never does: a companion references
       its runtime, and a runtime's dependency building the companion would be a project cycle. -->
  <PropertyGroup>
    <_StrideCompanionBuildRemoveProperties>TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;OutputType;StrideIsExecutable;PublishDir;_IsPublishing</_StrideCompanionBuildRemoveProperties>
  </PropertyGroup>
  <Target Name="_StrideBuildCompanionProjects"
          DependsOnTargets="GetStrideCompanionProjects"
          Condition="'$(StrideBuildCompanionProjects)' == 'true' Or ('$(StrideBuildCompanionProjects)' == '' And '$(StrideIsExecutable)' == 'true')">
    <StrideSelectCompanionProjects Companions="@(_StrideDeclaredCompanion)">
      <Output TaskParameter="Selected" ItemName="_StrideAssetsCompanionProject" />
    </StrideSelectCompanionProjects>

    <!-- No project references a companion, so restoring the executable does not restore it. The restore runs with
         its own global properties, so the build below evaluates the companion after it. -->
    <MSBuild Projects="@(_StrideAssetsCompanionProject)"
             Targets="Restore"
             Properties="MSBuildRestoreSessionId=StrideCompanionBuildRestore"
             RemoveProperties="$(_StrideCompanionBuildRemoveProperties)"
             Condition="'@(_StrideAssetsCompanionProject)' != ''" />
    <MSBuild Projects="@(_StrideAssetsCompanionProject)"
             Targets="Build"
             BuildInParallel="$(BuildInParallel)"
             RemoveProperties="$(_StrideCompanionBuildRemoveProperties)"
             Condition="'@(_StrideAssetsCompanionProject)' != ''" />
    <MSBuild Projects="@(_StrideAssetsCompanionProject)"
             Targets="GetStrideAssetBuildManifestPath"
             RemoveProperties="$(_StrideCompanionBuildRemoveProperties)"
             Condition="'@(_StrideAssetsCompanionProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideCompanionManifest" />
    </MSBuild>
    <Error Condition="'@(_StrideCompanionManifest->Count())' != '@(_StrideAssetsCompanionProject->Count())'"
           Text="A companion project of @(_StrideAssetsCompanionProject, ', ') wrote no build manifest; a companion project targets a single framework." />
  </Target>

  <UsingTask TaskName="StrideWriteAssetBuildManifest"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath Required="true" />
      <ProjectFile />
      <PackagePath />
      <PackageName />
      <PackageVersion />
      <TargetFramework />
      <ProjectAssetsFile />
      <RootNamespace />
      <AssetNamespace />
      <AssetNamespaceUsings />
      <PackageKind />
      <CompanionPackages ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ProjectDirectory Required="true" />
      <ExcludeDirectory />
      <Extensions />
      <HostAssemblies ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ReferencedManifests ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <CompanionManifests ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <CandidateItems ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sep = Path.DirectorySeparatorChar;
        var manifestDir = Path.GetDirectoryName(Path.GetFullPath(ManifestPath));
        var manifestBaseUri = new Uri(manifestDir + sep);
        var projectDirPrefix = Path.GetFullPath(ProjectDirectory).TrimEnd(sep) + sep;
        var extensions = new HashSet<string>(
            Extensions.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries).Select(e => e.Trim().ToLowerInvariant()),
            StringComparer.Ordinal);

        Func<string, string> rel = p => Uri.UnescapeDataString(manifestBaseUri.MakeRelativeUri(new Uri(Path.GetFullPath(p))).ToString());
        Func<string, string> q = s => "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";

        var sb = new StringBuilder();
        sb.AppendLine("!AssetBuildManifest");
        sb.AppendLine("Version: 1");
        if (!string.IsNullOrEmpty(ProjectFile))
            sb.AppendLine("ProjectFile: " + q(rel(ProjectFile)));
        if (!string.IsNullOrEmpty(PackagePath))
            sb.AppendLine("PackageFile: " + q(rel(PackagePath)));
        if (!string.IsNullOrEmpty(PackageName))
            sb.AppendLine("PackageName: " + q(PackageName));
        if (!string.IsNullOrEmpty(PackageVersion))
            sb.AppendLine("PackageVersion: " + q(PackageVersion));
        if (!string.IsNullOrEmpty(TargetFramework))
            sb.AppendLine("TargetFramework: " + q(TargetFramework));
        if (!string.IsNullOrEmpty(ProjectAssetsFile))
            sb.AppendLine("NuGetLockFile: " + q(rel(ProjectAssetsFile)));
        if (!string.IsNullOrEmpty(RootNamespace))
            sb.AppendLine("RootNamespace: " + q(RootNamespace));
        if (!string.IsNullOrEmpty(AssetNamespace))
            sb.AppendLine("AssetNamespace: " + q(AssetNamespace));
        var usings = new SortedSet<string>((AssetNamespaceUsings ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries).Select(u => u.Trim()).Where(u => u.Length > 0), StringComparer.Ordinal);
        if (usings.Count > 0)
        {
            sb.AppendLine("AssetNamespaceUsings:");
            foreach (var entry in usings)
                sb.AppendLine("    - " + q(entry));
        }
        if (!string.IsNullOrWhiteSpace(PackageKind))
            sb.AppendLine("PackageKind: " + PackageKind.Trim());

        // Companions: the project path always for a project, the id, version and kind when known
        var companions = new List<string[]>();
        foreach (var item in CompanionPackages ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var project = item.GetMetadata("Project");
            companions.Add(new[]
            {
                item.GetMetadata("Kind").Trim(),
                string.IsNullOrWhiteSpace(project) ? "" : rel(project),
                item.GetMetadata("PackageId").Trim(),
                item.GetMetadata("PackageVersion").Trim(),
                item.GetMetadata("Replaces"),
            });
        }
        companions.Sort((a, b) => string.CompareOrdinal(a[0] + "|" + a[1] + "|" + a[2], b[0] + "|" + b[1] + "|" + b[2]));
        if (companions.Count > 0)
        {
            sb.AppendLine("CompanionPackages:");
            foreach (var companion in companions)
            {
                var lines = new List<string>();
                if (companion[0].Length > 0)
                    lines.Add("Kind: " + companion[0]);
                if (companion[1].Length > 0)
                    lines.Add("Project: " + q(companion[1]));
                if (companion[2].Length > 0)
                    lines.Add("Package: " + q(companion[2]));
                if (companion[3].Length > 0)
                    lines.Add("Version: " + q(companion[3]));
                var replaces = companion[4].Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries).Select(r => r.Trim()).Where(r => r.Length > 0).ToList();
                if (replaces.Count > 0)
                {
                    lines.Add("Replaces:");
                    foreach (var replaced in replaces)
                        lines.Add("  - " + q(replaced));
                }
                for (var i = 0; i < lines.Count; i++)
                    sb.AppendLine((i == 0 ? "    - " : "      ") + lines[i]);
            }
        }

        var assemblies = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var item in HostAssemblies ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var path = item.GetMetadata("FullPath");
            if (!string.IsNullOrEmpty(path))
                assemblies.Add(rel(path));
        }
        if (assemblies.Count > 0)
        {
            sb.AppendLine("HostAssemblies:");
            foreach (var assembly in assemblies)
                sb.AppendLine("    - " + q(assembly));
        }

        var manifests = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var item in ReferencedManifests ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var path = item.GetMetadata("FullPath");
            if (!string.IsNullOrEmpty(path))
                manifests.Add(rel(path));
        }
        if (manifests.Count > 0)
        {
            sb.AppendLine("ReferencedManifests:");
            foreach (var manifest in manifests)
                sb.AppendLine("    - " + q(manifest));
        }

        var companionManifests = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var item in CompanionManifests ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            var path = item.GetMetadata("FullPath");
            if (!string.IsNullOrEmpty(path))
                companionManifests.Add(rel(path));
        }
        if (companionManifests.Count > 0)
        {
            sb.AppendLine("CompanionManifests:");
            foreach (var manifest in companionManifests)
                sb.AppendLine("    - " + q(manifest));
        }

        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var entries = new List<KeyValuePair<string, string>>();
        var excludePrefix = string.IsNullOrEmpty(ExcludeDirectory) ? null : Path.GetFullPath(ExcludeDirectory).TrimEnd(sep) + sep;
        foreach (var item in CandidateItems ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            if (!string.IsNullOrEmpty(item.GetMetadata("AutoGen")))
                continue;
            var full = item.GetMetadata("FullPath");
            if (string.IsNullOrEmpty(full))
                continue;
            var extension = Path.GetExtension(full);
            if (extension == null || !extensions.Contains(extension.ToLowerInvariant()))
                continue;
            full = Path.GetFullPath(full);
            if (excludePrefix != null && full.StartsWith(excludePrefix, StringComparison.OrdinalIgnoreCase))
                continue;
            if (!seen.Add(full))
                continue;
            var link = item.GetMetadata("Link");
            // Items outside the project directory get a link
            if (string.IsNullOrEmpty(link) && !full.StartsWith(projectDirPrefix, StringComparison.OrdinalIgnoreCase))
                link = Path.GetFileName(full);
            entries.Add(new KeyValuePair<string, string>(rel(full), string.IsNullOrEmpty(link) ? null : link.Replace('\\', '/')));
        }
        entries.Sort((a, b) => string.CompareOrdinal(a.Key, b.Key));
        if (entries.Count > 0)
        {
            sb.AppendLine("ProjectAssets:");
            foreach (var entry in entries)
            {
                sb.AppendLine("    - Path: " + q(entry.Key));
                if (entry.Value != null)
                    sb.AppendLine("      Link: " + q(entry.Value));
            }
        }

        var text = sb.ToString();
        if (!File.Exists(ManifestPath) || File.ReadAllText(ManifestPath) != text)
        {
            Directory.CreateDirectory(manifestDir);
            File.WriteAllText(ManifestPath, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StrideWriteAssetBuildManifest"
          AfterTargets="ResolveProjectReferences"
          DependsOnTargets="$(GetPackageVersionDependsOn);_StrideResolveCompanionProjects;_StrideBuildCompanionProjects"
          Condition="'$(StrideAssetBuildManifest)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(StrideAssetBuildManifestPath)' != '' And '$(_ComputeFilesToPublishForRuntimeIdentifiers)' != 'true'">
    <ItemGroup>
      <_StrideManifestProjectReference Include="@(_MSBuildProjectReferenceExistent)"
                                       Condition="'%(_MSBuildProjectReferenceExistent.ReferenceOutputAssembly)' != 'false'" />
    </ItemGroup>

    <MSBuild Projects="@(_StrideManifestProjectReference)"
             Targets="GetStrideAssetBuildManifestPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_StrideManifestProjectReference.SetConfiguration); %(_StrideManifestProjectReference.SetPlatform); %(_StrideManifestProjectReference.SetTargetFramework)"
             RemoveProperties="%(_StrideManifestProjectReference.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true"
             RebaseOutputs="true">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideReferencedManifest" />
    </MSBuild>

    <!-- Union project-asset extensions declared by ProjectReferences into the local set (see the
         GetStrideProjectAssetExtensions target above). The write task dedups, so repeats are fine. -->
    <MSBuild Projects="@(_StrideManifestProjectReference)"
             Targets="GetStrideProjectAssetExtensions"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_StrideManifestProjectReference.SetConfiguration); %(_StrideManifestProjectReference.SetPlatform); %(_StrideManifestProjectReference.SetTargetFramework)"
             RemoveProperties="%(_StrideManifestProjectReference.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideReferencedProjectAssetExtension" />
    </MSBuild>

    <PropertyGroup>
      <_StrideManifestExtensions>$(StrideProjectAssetExtensions);@(_StrideReferencedProjectAssetExtension)</_StrideManifestExtensions>
    </PropertyGroup>

    <PropertyGroup>
      <!-- StrideCurrentPackagePath points a project at its sdpkg when the name doesn't follow the
           convention; otherwise the conventional sdpkg next to the project (.csproj -> .sdpkg). Only
           an existing file counts: a platform project (e.g. MyGame.Windows) may carry a dangling path
           from an older layout, and must stay an implicit package named after itself (assets flow in
           from the referenced game library) rather than resurrect a package at the missing path. -->
      <_StrideAuthoredPackagePath Condition="'$(StrideCurrentPackagePath)' != '' And Exists('$(StrideCurrentPackagePath)')">$(StrideCurrentPackagePath)</_StrideAuthoredPackagePath>
      <_StrideAuthoredPackagePath Condition="'$(_StrideAuthoredPackagePath)' == ''">$(MSBuildProjectDirectory)\$(MSBuildProjectName).sdpkg</_StrideAuthoredPackagePath>
      <_StrideManifestHostFramework>$(StrideFramework)</_StrideManifestHostFramework>
      <_StrideManifestHostFramework Condition="'$(_StrideManifestHostFramework)' == ''">$(TargetFramework)</_StrideManifestHostFramework>
      <_StrideManifestProjectAssetsFile Condition="Exists('$(ProjectAssetsFile)')">$(ProjectAssetsFile)</_StrideManifestProjectAssetsFile>
      <_StrideManifestIsHostFramework Condition="'$(TargetFramework)' == '$(_StrideManifestHostFramework)'">true</_StrideManifestIsHostFramework>
      <!-- Package identity: PackageId ?? AssemblyName -->
      <_StrideManifestPackageName>$(PackageId)</_StrideManifestPackageName>
      <_StrideManifestPackageName Condition="'$(_StrideManifestPackageName)' == ''">$(AssemblyName)</_StrideManifestPackageName>
      <_StrideManifestPackageName Condition="'$(_StrideManifestPackageName)' == ''">$(MSBuildProjectName)</_StrideManifestPackageName>
    </PropertyGroup>

    <!-- The asset compiler loads host builds: non-host manifests reference their host-TFM
         sibling (which carries the HostAssemblies entry) instead of naming assemblies -->
    <MSBuild Condition="'$(StrideContainsAssetTypes)' == 'true' And '$(_StrideManifestIsHostFramework)' != 'true'"
             Projects="$(MSBuildProjectFullPath)"
             Targets="GetStrideAssetBuildManifestPath"
             Properties="TargetFramework=$(_StrideManifestHostFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_StrideReferencedManifest" />
    </MSBuild>

    <ItemGroup>
      <_StrideAssetBuildManifestAssembly Include="$(TargetPath)" Condition="'$(StrideContainsAssetTypes)' == 'true' And '$(_StrideManifestIsHostFramework)' == 'true'" />
      <_StrideAssetBuildManifestAssembly Include="@(StrideAssetBuildManifestAssembly)" />
      <_StrideAssetBuildManifestCandidate Include="@(Compile);@(None);@(AdditionalFiles)" />
    </ItemGroup>

    <StrideWriteAssetBuildManifest
        ManifestPath="$(StrideAssetBuildManifestPath)"
        ProjectFile="$(MSBuildProjectFullPath)"
        PackagePath="$(_StrideAuthoredPackagePath)"
        PackageName="$(_StrideManifestPackageName)"
        PackageVersion="$(PackageVersion)"
        TargetFramework="$(TargetFramework)"
        ProjectAssetsFile="$(_StrideManifestProjectAssetsFile)"
        RootNamespace="$(RootNamespace)"
        AssetNamespace="$(StrideAssetNamespace)"
        AssetNamespaceUsings="@(StrideAssetNamespaceUsing)"
        PackageKind="$(StridePackageKind)"
        CompanionPackages="@(_StrideCompanion)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        ExcludeDirectory="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))"
        Extensions="$(_StrideManifestExtensions)"
        HostAssemblies="@(_StrideAssetBuildManifestAssembly)"
        ReferencedManifests="@(_StrideReferencedManifest)"
        CompanionManifests="@(_StrideCompanionManifest)"
        CandidateItems="@(_StrideAssetBuildManifestCandidate)" />
  </Target>

</Project>
