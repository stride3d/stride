// PSMain(ExpectedResult=#336699FF, cbuffer.LitValues=(Positive=0.5, Negative=-0.5, Power=2))

namespace Stride.Shaders.Tests;

// lit(n_dot_l, n_dot_h, m) returns (1, diffuse, specular, 1)
shader Lit
{
    stream float4 ColorTarget : SV_Target0;

    cbuffer LitValues
    {
        float Positive;
        float Negative;
        float Power;
    }

    bool Matches(float4 value, float4 expected)
    {
        return all(abs(value - expected) < 0.0001);
    }

    void PSMain()
    {
        // Both positive: diffuse = n_dot_l, specular = n_dot_h ^ m
        bool front = Matches(lit(Positive, Positive, Power), float4(1, 0.5, 0.25, 1));
        // n_dot_l < 0: no diffuse and no specular
        bool backFacing = Matches(lit(Negative, Positive, Power), float4(1, 0, 0, 1));
        // n_dot_h < 0: diffuse only; int arguments are converted
        bool noSpecular = Matches(lit(Positive, Negative, Power), float4(1, 0.5, 0, 1)) && Matches(lit(1, 1, 3), float4(1, 1, 1, 1));

        streams.ColorTarget = float4(front ? 0.2 : 0, backFacing ? 0.4 : 0, noSpecular ? 0.6 : 0, 1);
    }
};
