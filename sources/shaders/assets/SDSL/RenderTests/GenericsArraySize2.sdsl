shader GenericsArrayBase3<int TArraySizeHalf> : GenericsArrayBase4<1, 2, TArraySizeHalf>
{
    stream float4 ColorTarget : SV_Target0;
    static const int TArraySize2 = TArraySize;

    void PSMain()
