// PSMain(ExpectedResult=#336699FF, cbuffer.Test=(Test1=1))
// PSMain(ExpectedResult=#336699FF, cbuffer.Test=(Test1=0))

namespace Stride.Shaders.Tests;

// Control: the read comes first, so the value must be carried. Same shape as StreamCarryConditionalWrite otherwise.
shader StreamCarryReadThenWrite
{
    stream float4 Position : POSITION;
    stream float4 ShadingPosition : SV_Position;
    stream float4 ColorTarget : SV_Target0;
    stream float4 X;

    cbuffer Test
    {
        int Test1;
    }

    void VSMain()
    {
        streams.ShadingPosition = streams.Position;
        streams.X = float4(0.2, 0.4, 0.6, 1.0);
    }

    void PSMain()
    {
        float4 y = streams.X;
        if (Test1 != 0)
            streams.X = float4(1.0, 1.0, 1.0, 1.0);
        streams.ColorTarget = y;
    }
}
