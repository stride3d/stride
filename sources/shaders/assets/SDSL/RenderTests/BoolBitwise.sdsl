// PSMain(ExpectedResult=#336699FF)

namespace Stride.Shaders.Tests;

shader BoolBitwise
{
    stream float4 ColorTarget : SV_Target0;

    void PSMain()
    {
        bool a = true;
        bool b = false;
        float y = 0.75;
        float border = 0.5;

        // > is computed first: (y > border) & !b (warning SDSL0232)
        bool mirror = y > border & !b;

        // On each component
        bool2 v = bool2(true, false);
        bool2 w = bool2(true, true);
        bool2 x = v ^ w;

        // As in HLSL, the result is an int
        int both = a & b;
        int either = a | b;

        bool c = a;
        c &= b;
        bool d = b;
        d |= a;
        bool e = a;
        e ^= a;

        streams.ColorTarget = float4(mirror ? 0.2 : 0, (!x.x && x.y) ? 0.4 : 0, (both == 0 && either == 1) ? 0.6 : 0, (!c && d && !e) ? 1 : 0);
    }
};
