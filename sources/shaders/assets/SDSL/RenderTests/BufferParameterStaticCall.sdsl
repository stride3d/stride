// PSMain(ExpectedResult=#336699FF, structuredbuffer.Values="16: 0 0 0 0 0 0 0 0")

namespace Stride.Shaders.Tests;

// Helpers in another shader, called statically with this shader's buffer (as VL.Fuse calls its buffer helpers)
shader BufferParameterStaticCallUtils
{
    static void Put(RWStructuredBuffer<float4> target, uint index, float4 value)
    {
        target[index] = value;
    }

    static float4 Get(RWStructuredBuffer<float4> source, uint index)
    {
        return source[index];
    }
};

shader BufferParameterStaticCall
{
    stream float4 ColorTarget : SV_Target0;

    RWStructuredBuffer<float4> Values;

    void PSMain()
    {
        BufferParameterStaticCallUtils.Put(Values, 1, float4(0.2, 0.4, 0.6, 1));
        streams.ColorTarget = BufferParameterStaticCallUtils.Get(Values, 1);
    }
};
