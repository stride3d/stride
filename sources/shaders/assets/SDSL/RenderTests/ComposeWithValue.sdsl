// PSMain(ExpectedResult=#336699FF)

namespace Stride.Shaders.Tests;

shader ComposeWithValueColor
{
    float4 Compute()
    {
        return float4(0.2, 0.4, 0.6, 1.0);
    }
};

shader ComposeWithValue
{
    stream float4 ColorTarget : SV_Target0;

    // The values are ignored (SDSL0236): a composition gets its shader from the effect, here the default one
    compose ComposeWithValueColor Color = float4(1.0, 0.0, 0.0, 1.0);
    compose ComposeWithValueColor Scale = 0.5f;
    compose ComposeWithValueColor Count = 1;

    void PSMain()
    {
        streams.ColorTarget = Color.Compute() * Scale.Compute().a * Count.Compute().a;
    }
};
