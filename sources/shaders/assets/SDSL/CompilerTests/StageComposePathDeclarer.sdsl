// Declares the stage slot. Having a stage member is what gets this shader promoted to the root,
// away from the composition that supplies its value.
namespace Stride.Shaders.Tests;

shader StageComposePathDeclarer
{
    stage compose StageComposePathBase Samplers[];

    float4 ConsumeIndexed()
    {
        return Samplers[0].Sample();
    }
};
