namespace Stride.Shaders.Tests
{
    params EffectDiscardParameters
    {
        bool IsError;
    }

    // Same shape as the editor's error fallback (StrideEditorForwardShadingEffect): a short effect, then `discard;`
    effect EffectDiscard
    {
        using params EffectDiscardParameters;

        if (EffectDiscardParameters.IsError)
        {
            mixin ErrorShader;
            discard;
        }

        mixin FullShader;
    };
}
