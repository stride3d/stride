// The value supplied for the stage slot. It owns a resource, which is the point of the test: the
// resource's link name is what the engine matches its parameter key against.
namespace Stride.Shaders.Tests;

shader StageComposePathImpl : StageComposePathBase
{
    Texture2D Tex;

    override float4 Sample()
    {
        return Tex.Load(int3(0, 0, 0));
    }
};
