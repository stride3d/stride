namespace Stride.Shaders.Tests;

shader SwitchGenericDuplicateLabelBase<int TMode>
{
    float Pick(int selector)
    {
        float v = 0.0;
        switch (selector)
        {
            case TMode:
                v = 1.0;
                break;
            case 3:
                v = 0.5;
                break;
        }
        return v;
    }
}

shader SwitchGenericDuplicateLabel : SwitchGenericDuplicateLabelBase<3>
{
    stream float4 ColorTarget : SV_Target0;

    cbuffer Test
    {
        int Selector;
    }

    void PSMain()
    {
        float v = Pick(Selector);
        streams.ColorTarget = float4(v, v, v, v);
    }
}
