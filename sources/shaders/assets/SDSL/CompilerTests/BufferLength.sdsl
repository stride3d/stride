// HLSL buffers have no Length member (FXC accepted it, DXC doesn't): error SDSL0150
namespace Stride.Shaders.Tests;

shader BufferLength
{
    StructuredBuffer<int> Indices;
    RWBuffer<float> Values;
    RWStructuredBuffer<uint> Output;

    [numthreads(1, 1, 1)]
    void CSMain()
    {
        if (Output[0] < Indices.Length)
            Output[1] = Values.Count;
    }
};
