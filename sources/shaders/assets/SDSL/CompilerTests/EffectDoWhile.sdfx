namespace Stride.Shaders.Tests
{
    params EffectDoWhileParameters
    {
        int Count;
    }

    // The body runs once before the condition is checked: with Count = 0, i ends at 1
    effect EffectDoWhile
    {
        using params EffectDoWhileParameters;

        int i = 0;
        do
        {
            i++;
        }
        while (i < EffectDoWhileParameters.Count);

        if (i == 1)
            mixin OneShader;
        else if (i == 3)
            mixin ThreeShader;
        else
            mixin OtherShader;
    };
}
