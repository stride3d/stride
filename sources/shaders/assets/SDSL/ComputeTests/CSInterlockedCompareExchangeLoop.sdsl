// CSMain(structuredbuffer.Values="4: 0 0", expected.Values="1153433600 1024")

namespace Stride.Shaders.Tests;

// The compare-exchange loop that adds a float to an int buffer element (VL.Fuse's AtomicAddFloat), from 1024 threads
// (32 x 32 groups of one) in a helper that takes the buffer: 1024 * 1.5 = 1536.0 (bits 0x44C00000). The loop condition reads
// the atomic's result: Direct3D 11 needs SPIRV-Cross to declare it once
shader CSInterlockedCompareExchangeLoop
{
    stage stream uint3 DispatchThreadId : SV_DispatchThreadID;

    RWStructuredBuffer<int> Values;

    void AddFloat(RWStructuredBuffer<int> target, uint index, float value)
    {
        int expected, original;
        do
        {
            expected = target[index];
            InterlockedCompareExchange(target[index], expected, asint(asfloat(expected) + value), original);
        } while (original != expected);
    }

    [numthreads(1, 1, 1)]
    void CSMain()
    {
        AddFloat(Values, 0, 1.5);
        InterlockedAdd(Values[1], 1);
    }
}
