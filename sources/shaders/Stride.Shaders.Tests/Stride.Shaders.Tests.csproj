<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <StrideBuildTags>*</StrideBuildTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <StrideGraphicsApiDependent>false</StrideGraphicsApiDependent>
    <OutputPath>$(StrideRoot)bin\Tests\$(MSBuildProjectName)\$(StridePlatform)\</OutputPath>
    <StrideEnableTestLauncher>false</StrideEnableTestLauncher>
    <SkipXunitReference>true</SkipXunitReference>
    <IncludeXunitLauncher>false</IncludeXunitLauncher>

    <!-- Force msbuild to check to rebuild so that unit tests SDSL files are properly copied -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <RootNamespace>Stride.Shaders.Parsers.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" />
    <!-- Vulkan test renderer uses Vortice, like the engine's Vulkan backend -->
    <PackageReference Include="Vortice.Vulkan" />
    <PackageReference Include="Silk.NET.Direct3D11" />
    <!-- Direct reference so Vulkan-only builds keep the DLL (Stride's graphics API filter strips
         it as D3D-only otherwise); xunit v3 discovery force-loads it through GetExportedTypes
         because FrameRenderer.D3D11 exposes DXGI types. -->
    <PackageReference Include="Silk.NET.DXGI" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" />
    <!-- Native spirv-cross.dll comes from Stride.Dependencies.SpirvCross (via Stride.Shaders.Compilers), not Silk -->
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Software Vulkan for GPU-less CI runners and reproducible rasterization (see Module) -->
    <PackageReference Include="Stride.Dependencies.Lavapipe" />
    <!-- Pin WARP to a fixed version side-loaded next to the test host, for reproducible
         rasterization across CI/dev (same as Stride.Graphics.Regression). Windows-only. -->
    <PackageReference Include="Microsoft.Direct3D.WARP" GeneratePathProperty="true"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Content Include="$(PkgMicrosoft_Direct3D_WARP)\build\native\bin\x64\d3d10warp.dll"
             Condition="'$(PkgMicrosoft_Direct3D_WARP)' != ''"
             Link="d3d10warp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\engine\Stride.Graphics\Stride.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <StrideShaderFiles Include="..\assets\SDSL\Common\**" LinkBase="assets\SDSL\Common\" />
    <Content Include="..\assets\SDSL\Common\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\Common\" />
    <StrideShaderFiles Include="..\assets\SDSL\CompilerTests\**" LinkBase="assets\SDSL\CompilerTests\" />
    <StrideShaderFiles Include="..\assets\SDSL\RenderTests\**" LinkBase="assets\SDSL\RenderTests\" />
    <StrideShaderFiles Include="..\assets\SDSL\ComputeTests\**" LinkBase="assets\SDSL\ComputeTests\" />
    <StrideShaderFiles Include="..\assets\SDSL\StreamOutTests\**" LinkBase="assets\SDSL\StreamOutTests\" />
    <Content Include="..\assets\SDSL\CompilerTests\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\CompilerTests\" />
    <Content Include="..\assets\SDSL\RenderTests\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\RenderTests\" />
    <Content Include="..\assets\SDSL\ComputeTests\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\ComputeTests\" />
    <Content Include="..\assets\SDSL\StreamOutTests\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\StreamOutTests\" />
    <Content Include="..\assets\SDSL\ParserTests\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\SDSL\ParserTests\" />
    <Content Include="..\..\engine\Stride.Graphics\**\*.sdsl" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDSL\%(Filename)%(Extension)" />
    <Content Include="..\..\engine\Stride.Graphics\**\*.sdfx" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDFX\%(Filename)%(Extension)" />
    <Content Include="..\..\engine\Stride.Rendering\**\*.sdsl" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDSL\%(Filename)%(Extension)" />
    <Content Include="..\..\engine\Stride.Rendering\**\*.sdfx" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDFX\%(Filename)%(Extension)" />
    <Content Include="..\..\engine\Stride.Engine\**\*.sdsl" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDSL\%(Filename)%(Extension)" />
    <Content Include="..\..\engine\Stride.Engine\**\*.sdfx" Exclude="**\obj\**;**\bin\**" CopyToOutputDirectory="PreserveNewest" Link="assets\Stride\SDFX\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stride.Shaders.Compilers\Stride.Shaders.Compilers.csproj" />
    <ProjectReference Include="..\Stride.Shaders.Parsers\Stride.Shaders.Parsers.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.targets" />
</Project>
