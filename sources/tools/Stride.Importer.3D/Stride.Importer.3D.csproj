<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--parameter-key --auto-module-initializer --serialization</StrideAssemblyProcessorOptions>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Analysis\" />
    <Folder Include="Material\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Assimp: we use the managed bindings from Silk.NET but replace the native library with our own build,
         which has fixes not upstream. See deps/assimp and the dep-assimp.yml workflow. -->
    <PackageReference Include="Silk.NET.Assimp" />
    <PackageReference Include="Ultz.Native.Assimp" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Stride.Dependencies.Assimp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Importer.Common\Stride.Importer.Common.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
