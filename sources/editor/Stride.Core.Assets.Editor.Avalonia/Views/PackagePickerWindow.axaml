<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
        xmlns:caevm="using:Stride.Core.Assets.Editor.ViewModels"
        xmlns:capvm="using:Stride.Core.Assets.Presentation.ViewModels"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="Stride.Core.Assets.Editor.Avalonia.Views.PackagePickerWindow"
        x:DataType="caevm:PackagePickerViewModel"
        Title="{sd:LocalizeString Select a package, Context=Title}"
        Width="480" Height="640"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The package picker, with a search box: the packages that can be added as a dependency, and a note next to the ones
       already available through another dependency -->
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton"
              Content="{sd:LocalizeString OK, Context=Button}"
              ToolTip.Tip="{sd:LocalizeString Select this package, Context=ToolTip}"
              IsDefault="True"
              IsEnabled="{Binding HasSelection}"
              Click="OnOkClick" MinWidth="80"/>
      <Button x:Name="CancelButton"
              Content="{sd:LocalizeString Cancel, Context=Button}"
              ToolTip.Tip="{sd:LocalizeString Cancel (Esc), Context=ToolTip}"
              IsCancel="True"
              Click="OnCancelClick" MinWidth="80"/>
    </StackPanel>
    <TextBox x:Name="SearchBox"
             DockPanel.Dock="Top"
             Margin="0,0,0,6"
             PlaceholderText="{sd:LocalizeString Search packages..., Context=Watermark}"
             Text="{Binding SearchText, Mode=TwoWay}"/>
    <ListBox x:Name="PackageList"
             ItemsSource="{Binding Packages}"
             SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
             DoubleTapped="OnPackageDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="capvm:PickablePackageViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}"/>
            <TextBlock Text="{Binding Note}" Opacity="0.5"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
