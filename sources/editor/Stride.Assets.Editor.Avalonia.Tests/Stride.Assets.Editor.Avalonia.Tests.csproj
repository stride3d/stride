<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.props" />

  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia headless tests run on xunit.v3 (Avalonia.Headless.XUnit), not on the Stride xUnit 2 launcher -->
    <SkipXunitReference>true</SkipXunitReference>
    <IncludeXunitLauncher>false</IncludeXunitLauncher>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Assets.Editor.Avalonia\Stride.Assets.Editor.Avalonia.csproj" />
    <!-- The node view model helpers of the Core.Assets.Editor.Avalonia tests are reused -->
    <ProjectReference Include="..\Stride.Core.Assets.Editor.Avalonia.Tests\Stride.Core.Assets.Editor.Avalonia.Tests.csproj" />
    <!-- The Avalonia companions of the plugins: their views are tested here with the editor's -->
    <ProjectReference Include="..\..\plugins\Audio\Stride.Audio.Editor.Avalonia\Stride.Audio.Editor.Avalonia.csproj" />
    <ProjectReference Include="..\..\plugins\SpriteStudio\Stride.SpriteStudio.Editor.Avalonia\Stride.SpriteStudio.Editor.Avalonia.csproj" />
    <!-- The cross-platform plugins of the plugin packages, whose registrations are compared with the recorded ones -->
    <ProjectReference Include="..\..\plugins\BulletPhysics\Stride.Physics.Editor\Stride.Physics.Editor.csproj" />
    <ProjectReference Include="..\..\plugins\Particles\Stride.Particles.Editor\Stride.Particles.Editor.csproj" />
    <ProjectReference Include="..\..\plugins\Video\Stride.Video.Editor\Stride.Video.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fake dotnet new template of the Assets.Editor tests (xunit 2, not referenced): the same file -->
    <Compile Include="..\Stride.Assets.Editor.Tests\Helpers\FakeTemplateInfo.cs">
      <Link>Helpers\FakeTemplateInfo.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Editor.Tests\Helpers\PluginRegistrations.cs">
      <Link>Helpers\PluginRegistrations.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Editor.Tests\Helpers\RegistrationsGolden.cs">
      <Link>Helpers\RegistrationsGolden.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Editor.Tests\Helpers\SessionRegistrations.cs">
      <Link>Helpers\SessionRegistrations.cs</Link>
    </Compile>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.targets" />
</Project>
