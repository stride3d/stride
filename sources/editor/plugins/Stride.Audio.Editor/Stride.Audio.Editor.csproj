<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideEditorTargetFramework)</TargetFramework>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--serialization --parameter-key</StrideAssemblyProcessorOptions>
    <StridePackageKind>Editor</StridePackageKind>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sound preview's WPF view: the WPF Game Studio loads it, another toolkit's editor does not -->
    <StrideCompanionProject Include="..\Stride.Audio.Editor.Wpf\Stride.Audio.Editor.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Stride.Assets.Presentation.Wpf\Stride.Assets.Presentation.Wpf.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Audio.Assets\Stride.Audio.Assets.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Audio\Stride.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\*.png" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
