<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.props" />

  <!-- The tests of the agnostic Stride.Assets.Presentation and Stride.Assets.Editor (asset view models, node updaters, commands, plugins) -->
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tests\xunit.runner.stride\xunit.runner.stride.csproj" />
    <!-- The session fakes (dialogs, clipboard, main view model, thumbnails) of the Core.Assets.Editor tests are reused -->
    <ProjectReference Include="..\Stride.Core.Assets.Editor.Tests\Stride.Core.Assets.Editor.Tests.csproj" />
    <ProjectReference Include="..\Stride.Assets.Editor\Stride.Assets.Editor.csproj" />
    <!-- The curve editor tests edit the curves of a particle system -->
    <ProjectReference Include="..\..\plugins\Particles\Stride.Particles\Stride.Particles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build order only: TestEditorPackageToolkit reads the build manifests of the toolkit-neutral plugin Editor packages,
         so they are built before the tests run; their assemblies are not referenced -->
    <ProjectReference Include="..\..\plugins\Audio\Stride.Audio.Editor\Stride.Audio.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\BulletPhysics\Stride.Physics.Editor\Stride.Physics.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Particles\Stride.Particles.Editor\Stride.Particles.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\SpriteStudio\Stride.SpriteStudio.Editor\Stride.SpriteStudio.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\UI\Stride.UI.Editor\Stride.UI.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Video\Stride.Video.Editor\Stride.Video.Editor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Voxels\Stride.Voxels.Editor\Stride.Voxels.Editor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The new game generation test skips when the template package is not installed -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.targets" />
</Project>
