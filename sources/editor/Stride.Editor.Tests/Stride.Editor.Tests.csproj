<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.props" />

  <!-- The tests of the agnostic Stride.Editor (the WPF screenshot host is tests/editor/Stride.Editor.Wpf.Tests) -->
  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tests\xunit.runner.stride\xunit.runner.stride.csproj" />
    <!-- The session fixture and fakes of the Core.Assets.Editor tests are reused -->
    <ProjectReference Include="..\Stride.Core.Assets.Editor.Tests\Stride.Core.Assets.Editor.Tests.csproj" />
    <ProjectReference Include="..\Stride.Editor\Stride.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\StaticThumbnail.png" LogicalName="Stride.Editor.Tests.Resources.StaticThumbnail.png" />
  </ItemGroup>

  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Tests/Sdk/Sdk.targets" />
</Project>
