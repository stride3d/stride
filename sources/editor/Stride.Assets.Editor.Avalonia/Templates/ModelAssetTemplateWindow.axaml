<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
        xmlns:tpl="using:Stride.Assets.Editor.Templates"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="400"
        x:Class="Stride.Assets.Editor.Avalonia.Templates.ModelAssetTemplateWindow"
        x:DataType="tpl:ImportModelFromFileViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="6">
    <TextBlock Text="{sd:LocalizeString Materials and textures}" FontWeight="SemiBold"/>
    <CheckBox x:Name="ImportMaterialsBox" Content="{sd:LocalizeString Import materials}" IsChecked="{Binding ImportMaterials}"/>
    <CheckBox x:Name="DeduplicateMaterialsBox" Margin="24,0,0,0"
              Content="{sd:LocalizeString Deduplicate materials}"
              IsChecked="{Binding DeduplicateMaterials}"
              IsEnabled="{Binding ImportMaterials}"
              IsVisible="{Binding ShowDeduplicateMaterialsCheckBox}"/>
    <TextBlock x:Name="FbxWarning" Margin="24,0,0,0" TextWrapping="Wrap" Opacity="0.7"
               Text="{sd:LocalizeString Material deduplication is not supported for FBX files.}"
               IsVisible="{Binding ShowFbxDedupeNotSupportedWarning}"/>
    <CheckBox x:Name="ImportTexturesBox" Content="{sd:LocalizeString Import textures}" IsChecked="{Binding ImportTextures}"/>
    <CheckBox x:Name="ImportAnimationsBox" Content="{sd:LocalizeString Import animations}" IsChecked="{Binding ImportAnimations}"/>

    <TextBlock Text="{sd:LocalizeString Skeleton}" FontWeight="SemiBold" Margin="0,10,0,0"/>
    <RadioButton x:Name="ImportSkeletonButton" GroupName="Skeleton"
                 Content="{sd:LocalizeString Import the skeleton of the model}"
                 IsChecked="{Binding ImportSkeleton}"/>
    <RadioButton x:Name="DontImportSkeletonButton" GroupName="Skeleton"
                 Content="{sd:LocalizeString Do not import a skeleton}"
                 IsChecked="{Binding DontImportSkeleton}"/>
    <RadioButton x:Name="ReuseSkeletonButton" GroupName="Skeleton"
                 Content="{sd:LocalizeString Use an existing skeleton:}"
                 IsChecked="{Binding ReuseSkeleton}"/>
    <DockPanel Margin="24,0,0,0" LastChildFill="True">
      <Button x:Name="ClearSkeletonButton" DockPanel.Dock="Right" Margin="4,0,0,0"
              Content="{sd:LocalizeString Clear, Context=Button}"
              Command="{Binding ClearSkeletonCommand}"
              ToolTip.Tip="{sd:LocalizeString Use no skeleton asset}"/>
      <Button x:Name="BrowseSkeletonButton" DockPanel.Dock="Right"
              Content="{sd:LocalizeString Browse..., Context=Button}"
              Command="{Binding BrowseSkeletonCommand}"
              ToolTip.Tip="{sd:LocalizeString Pick a skeleton asset of the project}"/>
      <TextBlock x:Name="SkeletonNameText" VerticalAlignment="Center" Margin="0,0,8,0"
                 TextTrimming="CharacterEllipsis"
                 Text="{Binding SkeletonName}"
                 ToolTip.Tip="{Binding SkeletonName}"/>
    </DockPanel>

    <Grid ColumnDefinitions="*,20,*" Margin="0,14,0,0">
      <Button x:Name="OkButton" Grid.Column="0" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{sd:LocalizeString OK, Context=Button}"
              IsDefault="True"
              Click="OnOkClick"/>
      <Button x:Name="CancelButton" Grid.Column="2" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{sd:LocalizeString Cancel, Context=Button}"
              IsCancel="True"
              Click="OnCancelClick"/>
    </Grid>
  </StackPanel>
</Window>
