<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
        xmlns:tpl="using:Stride.Assets.Editor.Templates"
        xmlns:templates="using:Stride.Core.Assets.Templates"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="300"
        x:Class="Stride.Assets.Editor.Avalonia.Templates.ScriptNameWindow"
        x:DataType="tpl:ScriptNameViewModel"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="6">
    <TextBlock Text="{sd:LocalizeString Class name:}"/>
    <TextBox x:Name="ClassNameBox" Text="{Binding ClassName}"/>
    <TextBlock Text="{sd:LocalizeString Template:}" Margin="0,10,0,0" IsVisible="{Binding EnableTemplateSelect}"/>
    <ComboBox x:Name="TemplateBox" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
              IsVisible="{Binding EnableTemplateSelect}">
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="templates:TemplateAssetDescription">
          <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{sd:LocalizeString Namespace:}" Margin="0,10,0,0"/>
    <TextBox x:Name="NamespaceBox" Text="{Binding Namespace}"/>
    <TextBlock x:Name="ErrorLabel" Foreground="Tomato" TextWrapping="Wrap" IsVisible="False"/>
    <Grid ColumnDefinitions="*,20,*" Margin="0,14,0,0">
      <Button x:Name="OkButton" Grid.Column="0" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{sd:LocalizeString Create script, Context=Button}"
              IsDefault="True"
              Click="OnOkClick"/>
      <Button x:Name="CancelButton" Grid.Column="2" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{sd:LocalizeString Cancel, Context=Button}"
              IsCancel="True"
              Click="OnCancelClick"/>
    </Grid>
  </StackPanel>
</Window>
