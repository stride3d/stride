<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:cmd="using:Stride.Core.Assets.Editor.Avalonia.Commands"
             xmlns:scmd="using:Stride.Assets.Editor.Commands"
             xmlns:vm="using:Stride.Assets.Editor.ViewModels"
             xmlns:vm2="using:Stride.Assets.Presentation.ViewModels"
             xmlns:ae="using:Stride.Assets.Editor.AssetEditors"
             xmlns:eh="using:Stride.Assets.Editor.AssetEditors.EntityHierarchyEditor"
             xmlns:ehvm="using:Stride.Assets.Editor.AssetEditors.EntityHierarchyEditor.ViewModels"
             xmlns:gevm="using:Stride.Assets.Editor.AssetEditors.GameEditor.ViewModels"
             xmlns:conv="using:Stride.Assets.Editor.Avalonia.Converters"
             xmlns:local="using:Stride.Assets.Editor.Avalonia.Views"
             xmlns:dd="using:Stride.Core.Assets.Editor.Avalonia.DragDrop"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stride.Assets.Editor.Avalonia.Views.EntityHierarchyEditorView"
             x:DataType="vm:EntityHierarchyEditorViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
        <ResourceInclude Source="avares://Stride.Assets.Editor.Avalonia/Views/SceneEditorImages.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- The context menus of the editor bind the commands of the registry by their identifier: the editor's commands act
           on the editor they opened in, the Edit commands on the control they opened on. -->
      <!-- The context menu of an empty area of the tree: the creation and the paste go to
           the root -->
      <ContextMenu x:Key="RootContextMenu" x:DataType="vm:EntityHierarchyEditorViewModel"
                   cmd:CommandSlot.Location="{x:Static scmd:SceneLocations.EntityTreeContext}">
        <MenuItem Header="{sd:LocalizeString Create, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Folder, Context=Menu}" Command="{cmd:Command Stride.Scene.NewFolderInRoot}">
          <MenuItem.Icon><Image Source="{StaticResource ImageNewFolder}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{sd:LocalizeString Empty entity, Context=Menu}" Command="{cmd:Command Stride.Scene.NewEntityInRoot}"/>
        <!-- The categories of entity factories go here (see EntityHierarchyEditorView.AddFactoryItems) -->
        <Separator Tag="Factories" IsVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Actions, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <MenuItem Command="{cmd:Command Stride.Scene.OpenPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.SelectPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.BreakLinkToPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.CreatePrefabFromSelection}"/>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Scene.Duplicate}"/>
        <MenuItem Command="{cmd:Command Stride.Edit.Cut}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCut}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Copy}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCopy}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{sd:LocalizeString Paste, Context=Menu}" Command="{cmd:Command Stride.Scene.PasteInRoot}">
          <MenuItem.Icon><Image Source="{StaticResource ImagePaste}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Delete}">
          <MenuItem.Icon><Image Source="{StaticResource ImageDelete}"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Edit.Rename}">
          <MenuItem.Icon><Image Source="{StaticResource ImageRename}"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>

      <!-- The built-in entries of the context menu of the scene view: they come after the
           entries of the active tool and before the commands of the plugins (see OnSceneViewContextMenuRequested). The
           entities are created at the cursor. -->
      <ContextMenu x:Key="SceneViewMenu" x:DataType="vm:EntityHierarchyEditorViewModel">
        <MenuItem Header="{sd:LocalizeString Create, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Empty entity, Context=Menu}" Command="{cmd:Command Stride.Scene.NewEntityAtCursor}"/>
        <!-- The categories of entity factories go here (see EntityHierarchyEditorView.AddFactoryItems) -->
        <Separator Tag="Factories" IsVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Actions, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <MenuItem Command="{cmd:Command Stride.Scene.OpenPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.SelectPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.BreakLinkToPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.CreatePrefabFromSelection}"/>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Scene.Duplicate}"/>
        <MenuItem Command="{cmd:Command Stride.Edit.Cut}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCut}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Copy}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCopy}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Delete}">
          <MenuItem.Icon><Image Source="{StaticResource ImageDelete}"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Edit.Rename}">
          <MenuItem.Icon><Image Source="{StaticResource ImageRename}"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>

      <!-- The context menu of an item of the tree: the creation and the paste go into
           the selection -->
      <ContextMenu x:Key="ItemContextMenu" x:DataType="vm:EntityHierarchyEditorViewModel"
                   cmd:CommandSlot.Location="{x:Static scmd:SceneLocations.EntityTreeContext}"
                   cmd:CommandSlot.Selection="{Binding SelectedContent}">
        <MenuItem Header="{sd:LocalizeString Create, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Folder, Context=Menu}" Command="{cmd:Command Stride.Scene.NewFolder}">
          <MenuItem.Icon><Image Source="{StaticResource ImageNewFolder}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{sd:LocalizeString Empty entity, Context=Menu}" Command="{cmd:Command Stride.Scene.NewEntity}"/>
        <!-- The categories of entity factories go here (see EntityHierarchyEditorView.AddFactoryItems) -->
        <Separator Tag="Factories" IsVisible="False"/>
        <MenuItem Header="{sd:LocalizeString Actions, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
        <!-- On a child scene only, checked on the active one: new entities go to the active scene (see OnTreeContextRequested) -->
        <MenuItem Tag="SetActiveRoot" Header="{sd:LocalizeString Set as active scene, Context=Menu}" ToggleType="CheckBox"
                  Command="{cmd:Command Stride.Scene.SetActiveScene}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.OpenPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.SelectPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.BreakLinkToPrefab}"/>
        <MenuItem Command="{cmd:Command Stride.Scene.CreatePrefabFromSelection}"/>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Scene.Duplicate}"/>
        <MenuItem Command="{cmd:Command Stride.Edit.Cut}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCut}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Copy}">
          <MenuItem.Icon><Image Source="{StaticResource ImageCopy}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Paste}">
          <MenuItem.Icon><Image Source="{StaticResource ImagePaste}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{cmd:Command Stride.Edit.Delete}">
          <MenuItem.Icon><Image Source="{StaticResource ImageDelete}"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Edit.Rename}">
          <MenuItem.Icon><Image Source="{StaticResource ImageRename}"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*, 4, 3*">
    <!-- Delete and Paste work wherever the focus is in the editor (the tree or the view) -->
    <sd:EditCommands.Bindings>
      <sd:EditCommandBinding Kind="Delete" Command="{Binding DeleteCommand}"/>
      <sd:EditCommandBinding Kind="Paste" Command="{Binding PasteCommand}" CommandParameter="{sd:False}"/>
    </sd:EditCommands.Bindings>
    <DockPanel Grid.Column="0">
      <!-- The toolbar of the hierarchy -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="2">
        <Button x:Name="CreateButton" Focusable="False" Background="Transparent" Padding="4"
                ToolTip.Tip="{sd:LocalizeString Create a new entity, Context=ToolTip}">
          <Image Source="{StaticResource ImageNewAsset}" Width="16" Height="16"/>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnCreateFlyoutOpening">
              <MenuItem Header="{sd:LocalizeString Create, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
              <MenuItem Header="{sd:LocalizeString New folder, Context=Menu}" Command="{Binding CreateFolderInRootCommand}">
                <MenuItem.Icon><Image Source="{StaticResource ImageNewFolder}"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{sd:LocalizeString Empty entity, Context=Menu}" Command="{Binding CreateEntityInRootCommand}"/>
              <Separator Tag="Factories" IsVisible="False"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBox Width="120" PlaceholderText="{sd:LocalizeString Filter}" VerticalAlignment="Center"
                 Text="{Binding FilterPattern, Delay=300}"
                 ToolTip.Tip="{sd:LocalizeString Filter entities by name, Context=ToolTip}"/>
        <Button Focusable="False" Background="Transparent" Padding="4" Click="OnExpandAllClick"
                ToolTip.Tip="{sd:LocalizeString Expand all entities, Context=ToolTip}">
          <Image Source="{StaticResource ImageExpandAllFolders}" Width="16" Height="16"/>
        </Button>
        <Button Focusable="False" Background="Transparent" Padding="4" Click="OnCollapseAllClick"
                ToolTip.Tip="{sd:LocalizeString Collapse all entities, Context=ToolTip}">
          <Image Source="{StaticResource ImageCollapseAllFolders}" Width="16" Height="16"/>
        </Button>
      </StackPanel>
      <TreeView x:Name="HierarchyTree"
                Focusable="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ItemsSource="{Binding HierarchyRoot, Mode=OneWay, Converter={sd:Yield}}"
                SelectedItems="{Binding SelectedContent}"
                SelectionMode="Multiple">
        <!-- Drag and drop: entities, folders and child scenes are dragged (the selection when the
             drag starts on it); a drop on a row adds as children, between two rows inserts there, on the empty area adds
             assets to the scene; the assets of the asset view drop too (a prefab, a model, a scene onto a scene...) -->
        <Interaction.Behaviors>
          <dd:TreeViewDragDropBehavior CanInsert="True" AllowDropOnEmptyArea="True"/>
        </Interaction.Behaviors>
        <!-- Cut, Copy and Rename only while the tree has the focus -->
        <sd:EditCommands.Bindings>
          <sd:EditCommandBinding Kind="Cut" Command="{Binding CutCommand}"/>
          <sd:EditCommandBinding Kind="Copy" Command="{Binding CopyCommand}"/>
          <sd:EditCommandBinding Kind="Rename" Command="{Binding RenameCommand}"/>
        </sd:EditCommands.Bindings>
        <Control.DataTemplates>
          <!-- Entity template -->
          <TreeDataTemplate DataType="{x:Type vm2:EntityViewModel}"
                            ItemsSource="{Binding Children}">
            <DockPanel>
              <!-- Focus button (the camera frames the entity) -->
              <Button DockPanel.Dock="Right" Classes="row" Focusable="False" Background="Transparent" Padding="2" Margin="8,0,0,0"
                      Command="{Binding $parent[TreeView].((vm:EntityHierarchyEditorViewModel)DataContext).FocusOnEntityCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsLoaded}"
                      ToolTip.Tip="{sd:LocalizeString Focus on this entity (F), Context=ToolTip}">
                <!-- The focus icon -->
                <Path Width="16" Height="16" Stretch="None" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                      Data="F1M10.167,9.667C8.053,9.667 6.334,7.947 6.334,5.834 6.334,3.72 8.053,2 10.167,2 12.28,2 14,3.72 14,5.834 14,7.947 12.28,9.667 10.167,9.667 M10.167,1C7.502,1 5.334,3.168 5.334,5.834 5.334,6.985 5.755,8.03 6.431,8.862L1.147,14.146C0.951000000000001,14.342 0.951000000000001,14.658 1.147,14.854 1.244,14.951 1.372,15 1.5,15 1.628,15 1.756,14.951 1.854,14.854L7.138,9.569C7.969,10.245 9.015,10.667 10.167,10.667 12.832,10.667 15,8.499 15,5.834 15,3.168 12.832,1 10.167,1" />
              </Button>
              <!-- Lock button: a locked entity cannot be selected in the view. Ctrl applies to the children. -->
              <Button DockPanel.Dock="Right" Classes="row" Command="{Binding LockCommand}" Click="OnLoadOrLockClick" IsEnabled="{Binding IsLoaded}">
                <ToolTip.Tip>
                  <StackPanel>
                    <TextBlock Text="{sd:LocalizeString Lock/unlock this entity, Context=ToolTip}"/>
                    <TextBlock Text="{sd:LocalizeString (Hold Ctrl to apply to child entities recursively), Context=ToolTip}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <Panel>
                  <Image Source="{StaticResource ImageLockEntity}" Width="16" Height="16" IsVisible="{Binding IsLocked}"/>
                  <Image Source="{StaticResource ImageUnlockEntity}" Width="16" Height="16" IsVisible="{Binding !IsLocked}"/>
                </Panel>
              </Button>
              <!-- Clipped: a long name goes under the buttons rather than over them -->
              <StackPanel Orientation="Horizontal" ClipToBounds="True">
                <Image Source="{Binding Components, Converter={conv:EntityComponentToResource}}" Width="16" Height="16"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding !IsEditing}"
                           Classes.unloaded="{Binding !Owner.IsLoaded}" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"/>
                <!-- Renaming in place (F2): the box replaces the name while the item is editing -->
                <TextBox Text="{Binding Name, Mode=OneWay}" IsVisible="{Binding IsEditing}" MinWidth="80">
                  <Interaction.Behaviors>
                    <sd:InlineEditBehavior Name="{Binding Name, Mode=TwoWay}" IsEditing="{Binding IsEditing, Mode=TwoWay}"/>
                  </Interaction.Behaviors>
                </TextBox>
                <TextBlock Text="{Binding SourcePrefab.Name, StringFormat=(Prefab: \{0\}), FallbackValue=''}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                           IsVisible="{Binding SourcePrefab, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              </StackPanel>
            </DockPanel>
          </TreeDataTemplate>
          <!-- Folder template -->
          <TreeDataTemplate DataType="{x:Type vm2:EntityFolderViewModel}"
                            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource FolderIcon}" Width="16" Height="16" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding !IsEditing}"
                         Classes.unloaded="{Binding !Owner.IsLoaded}" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"/>
              <!-- Renaming in place (F2): the box replaces the name while the item is editing -->
              <TextBox Text="{Binding Name, Mode=OneWay}" IsVisible="{Binding IsEditing}" MinWidth="80">
                <Interaction.Behaviors>
                  <sd:InlineEditBehavior Name="{Binding Name, Mode=TwoWay}" IsEditing="{Binding IsEditing, Mode=TwoWay}"/>
                </Interaction.Behaviors>
              </TextBox>
            </StackPanel>
          </TreeDataTemplate>
          <!-- Scene template -->
          <TreeDataTemplate DataType="{x:Type vm2:SceneRootViewModel}"
                            ItemsSource="{Binding Children}">
            <DockPanel>
              <!-- Where the focus button of an entity is, so that the lock buttons of scenes and entities line up -->
              <Panel DockPanel.Dock="Right" Width="20" Margin="8,0,0,0"/>
              <!-- Lock button: a locked entity cannot be selected in the view. Ctrl applies to the children. -->
              <Button DockPanel.Dock="Right" Classes="row" Command="{Binding LockCommand}" Click="OnLoadOrLockClick" IsEnabled="{Binding IsLoaded}">
                <ToolTip.Tip>
                  <StackPanel>
                    <TextBlock Text="{sd:LocalizeString Lock/unlock all entities, Context=ToolTip}"/>
                    <TextBlock Text="{sd:LocalizeString (Hold Ctrl to apply to child scenes recursively), Context=ToolTip}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <Panel>
                  <Image Source="{StaticResource ImageLockEntity}" Width="16" Height="16" IsVisible="{Binding IsLocked}"/>
                  <Image Source="{StaticResource ImageUnlockEntity}" Width="16" Height="16" IsVisible="{Binding !IsLocked}"/>
                </Panel>
              </Button>
              <!-- Load button: loads or unloads the scene and its entities in the editor game. Ctrl applies to the
                   child scenes. The parent scenes of a scene are loaded with it. -->
              <Button DockPanel.Dock="Right" Classes="row" Command="{Binding LoadCommand}" Click="OnLoadOrLockClick">
                <ToolTip.Tip>
                  <StackPanel>
                    <TextBlock Text="{sd:LocalizeString Load/unload all entities, Context=ToolTip}"/>
                    <TextBlock Text="{sd:LocalizeString (Hold Ctrl to apply to child scenes recursively), Context=ToolTip}"
                               IsVisible="{Binding !IsLoaded}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <Panel>
                  <Image Source="{StaticResource ImageLoadEntity}" Width="16" Height="16" IsVisible="{Binding IsLoaded}"/>
                  <Image Source="{StaticResource ImageUnloadEntity}" Width="16" Height="16" IsVisible="{Binding !IsLoaded}"/>
                </Panel>
              </Button>
              <StackPanel Orientation="Horizontal" ClipToBounds="True">
                <Image Source="{StaticResource SceneIcon}" Width="16" Height="16"/>
                <!-- The active scene, where new entities go, is in bold -->
                <TextBlock Text="{Binding Name}" Margin="4,0" VerticalAlignment="Center" Classes.unloaded="{Binding !IsLoaded}" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                           Classes.active="{sd:MultiBinding {Binding}, {Binding $parent[TreeView].((vm:EntityHierarchyEditorViewModel)DataContext).ActiveRoot}, Converter={sd:AllEqualMulti}}"/>
                <!-- While the scene loads or unloads -->
                <TextBlock Classes="loading" Margin="4,0" VerticalAlignment="Center" Text="{sd:LocalizeString Loading...}"
                           IsVisible="{sd:MultiBinding {Binding IsLoading}, {Binding !IsLoaded}, Converter={sd:AndMulti}}"/>
                <TextBlock Classes="loading" Margin="4,0" VerticalAlignment="Center" Text="{sd:LocalizeString Unloading...}"
                           IsVisible="{sd:MultiBinding {Binding IsLoading}, {Binding IsLoaded}, Converter={sd:AndMulti}}"/>
                <TextBlock Classes="unloaded" Margin="4,0" VerticalAlignment="Center" Text="{sd:LocalizeString (Unloaded)}"
                           Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                           IsVisible="{sd:MultiBinding {Binding !IsLoaded}, {Binding !IsLoading}, Converter={sd:AndMulti}}"/>
              </StackPanel>
            </DockPanel>
          </TreeDataTemplate>
          <!-- Default template, last: the first template that matches is used, and the items above derive from this type -->
          <TreeDataTemplate DataType="{x:Type vm2:EntityHierarchyItemViewModel}"
                            ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
          </TreeDataTemplate>
        </Control.DataTemplates>
        <StyledElement.Styles>
          <!-- The items remember whether they are expanded: the root is expanded when the
               editor opens, and a new entity or folder expands its parent -->
          <Style Selector="TreeViewItem" x:DataType="vm2:EntityHierarchyItemViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- The filter of the toolbar -->
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
          </Style>
          <!-- The entities of an unloaded scene, and the scene itself, are grey, unless the row is selected -->
          <Style Selector="TextBlock.unloaded:not(.selected)">
            <Setter Property="Foreground" Value="Gray"/>
          </Style>
          <Style Selector="TextBlock.active">
            <Setter Property="FontWeight" Value="Bold"/>
          </Style>
          <!-- "Loading..." blinks while the scene loads -->
          <Style Selector="TextBlock.loading">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}"/>
            <Style.Animations>
              <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
          <Style Selector="Button.row">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
          </Style>
          <!-- The buttons of the entities of an unloaded scene are off: faded, without the grey box of a disabled button -->
          <Style Selector="Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.4"/>
          </Style>
        </StyledElement.Styles>
      </TreeView>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Auto" />

    <DockPanel Grid.Column="2">
      <!-- The transformation toolbar: the tools, the space of the gizmos, the material selection mode and the selection
           mask. Its items don't take the focus, so that the keys keep going to the view. -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="2"
                  x:DataType="vm:EditorViewToolbarViewModel"
                  DataContext="{Binding $parent[local:EntityHierarchyEditorView].((vm:EntityHierarchyEditorViewModel)DataContext).ViewOptions}"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel.Styles>
          <Style Selector="ListBox.toolbar">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemsPanel">
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </Setter>
          </Style>
          <Style Selector="ListBox.toolbar > ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}" />
            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding ToolTip}" />
          </Style>
          <Style Selector="Path.icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          </Style>
        </StackPanel.Styles>
        <ListBox Classes="toolbar" x:DataType="vm:EditorViewToolbarViewModel"
                 ItemsSource="{Binding Tools}" SelectedItem="{Binding ActiveTool}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorViewToolViewModel">
              <Panel Width="16" Height="16">
                <Path Classes="icon" Data="{Binding IconPath, Converter={conv:PathDataToGeometry}}" />
                <!-- A tool with no icon shows its initial -->
                <TextBlock Text="{Binding Initial}" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Separator Width="1" Height="20" Margin="2,0" />
        <ListBox Classes="toolbar" x:DataType="vm:EditorViewToolbarViewModel"
                 ItemsSource="{Binding Spaces}" SelectedItem="{Binding Space}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorViewSpaceViewModel">
              <Path Classes="icon" Data="{Binding IconPath, Converter={conv:PathDataToGeometry}}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Separator Width="1" Height="20" Margin="2,0" />
        <ToggleButton x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                      IsChecked="{Binding MaterialSelectionMode}"
                      ToolTip.Tip="{sd:LocalizeString Toggle material selection (click a selected asset to select its material), Context=ToolTip}">
          <!-- The material selection icon -->
          <Panel Width="16" Height="16">
            <Path Classes="icon" Data="F1M8,14L8,2C11.313,2 14,4.687 14,8 14,11.313 11.313,14 8,14 M8,1C4.134,1 1,4.134 1,8 1,11.866 4.134,15 8,15 11.866,15 15,11.866 15,8 15,4.134 11.866,1 8,1" />
            <Path Width="16" Height="16" Stretch="None" Fill="#FFA1260D" Data="F1M8,2L8,14C11.313,14 14,11.313 14,8 14,4.687 11.313,2 8,2" />
          </Panel>
        </ToggleButton>
        <ToggleButton x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                      IsChecked="{Binding DisplaySelectionMask}"
                      ToolTip.Tip="{sd:LocalizeString Show or hide selection mask, Context=ToolTip}">
          <!-- The selection mask icon -->
          <Path Width="16" Height="16" Stretch="None" Fill="#FF0095D7"
                Data="F1M9.3838,13.5752C9.9298,12.4292 10.3508,11.3602 10.6218,10.3822 11.5158,10.2662 12.4668,10.0392 13.5078,9.6472 12.9298,11.5842 11.3578,13.0872 9.3838,13.5752 M2.4868,9.6252C3.2838,9.8692 4.1978,10.1032 5.2308,10.2692 5.4368,11.3162 5.7728,12.3862 6.2118,13.4632 4.4218,12.8772 3.0208,11.4382 2.4868,9.6252 M2.2498,8.0002C2.2498,7.1802 2.4238,6.4032 2.7328,5.6972 3.4178,5.8992 4.1808,6.0912 5.0318,6.2362 4.9898,6.6412 4.9598,7.0562 4.9548,7.4942 4.9488,8.0292 4.9888,8.5772 5.0538,9.1312 3.9778,8.9352 3.0478,8.6672 2.2708,8.4032 2.2608,8.2692 2.2498,8.1372 2.2498,8.0002 M5.9168,2.6452C5.6268,3.3682 5.3618,4.1992 5.1848,5.1532 4.4928,5.0332 3.8608,4.8812 3.2818,4.7182 3.9298,3.7882 4.8458,3.0622 5.9168,2.6452 M7.9998,2.2502C8.1648,2.2502 8.3268,2.2612 8.4878,2.2742 8.9558,3.0862 9.4318,4.1202 9.7088,5.3822 9.1378,5.4212 8.5758,5.4262 8.0058,5.4212 7.4058,5.4142 6.8248,5.3732 6.2668,5.3102 6.4998,4.0952 6.8848,3.0962 7.2678,2.3022 7.5078,2.2712 7.7508,2.2502 7.9998,2.2502 M8.0058,9.4212C7.3698,9.4142 6.7578,9.3672 6.1678,9.2982 6.0838,8.6882 6.0388,8.0892 6.0448,7.5062 6.0488,7.1192 6.0758,6.7502 6.1128,6.3902 6.7148,6.4592 7.3428,6.5042 7.9938,6.5112 8.1288,6.5122 8.2628,6.5132 8.3978,6.5132 8.8858,6.5132 9.3798,6.4982 9.8848,6.4592 9.9228,6.7992 9.9508,7.1442 9.9548,7.5062 9.9608,8.0832 9.8868,8.7082 9.7458,9.3752 9.1618,9.4162 8.5878,9.4242 8.0058,9.4212 M7.9998,13.7502C7.8298,13.7502 7.6618,13.7392 7.4958,13.7242 6.9928,12.6082 6.6088,11.5002 6.3678,10.4192 6.8918,10.4712 7.4348,10.5052 7.9938,10.5112 8.1288,10.5122 8.2628,10.5122 8.3978,10.5122 8.7448,10.5122 9.0968,10.5032 9.4508,10.4852 9.1458,11.4762 8.6928,12.5622 8.0988,13.7452 8.0658,13.7462 8.0328,13.7502 7.9998,13.7502 M12.7488,4.7602C12.0628,4.9962 11.4148,5.1602 10.7978,5.2562 10.5838,4.2242 10.2468,3.3372 9.8808,2.5712 11.0568,2.9782 12.0598,3.7512 12.7488,4.7602 M10.9688,6.3382C11.6958,6.2242 12.4628,6.0302 13.2848,5.7342 13.5838,6.4292 13.7498,7.1952 13.7498,8.0002 13.7498,8.1262 13.7398,8.2502 13.7318,8.3742 12.6938,8.8262 11.7598,9.0962 10.8838,9.2372 10.9938,8.6252 11.0508,8.0432 11.0448,7.4942 11.0408,7.0942 11.0098,6.7122 10.9688,6.3382 M14.9998,8.0002C14.9998,7.9202 14.9898,7.8432 14.9888,7.7632 14.8628,4.0082 11.7858,1.0002 7.9998,1.0002 4.1338,1.0002 0.9998,4.1342 0.9998,8.0002 0.9998,8.2042 1.0118,8.4052 1.0298,8.6032 1.0458,8.7832 1.0708,8.9612 1.1008,9.1362 1.1018,9.1412 1.1018,9.1472 1.1028,9.1532 1.5918,12.0962 3.9088,14.4112 6.8528,14.8982 6.8598,14.8992 6.8658,14.9002 6.8728,14.9012 7.0468,14.9302 7.2218,14.9542 7.3998,14.9702 7.5978,14.9882 7.7968,15.0002 7.9998,15.0002 8.2318,15.0002 8.4598,14.9872 8.6848,14.9662 12.2298,14.6212 14.9998,11.6352 14.9998,8.0002" />
        </ToggleButton>
        <!-- The snap of the active transformation: always on when checked, while Shift is down otherwise -->
        <Panel x:DataType="vm:EditorViewToolbarViewModel" DataContext="{Binding Snaps[0]}">
          <ToggleButton x:DataType="vm:EditorViewSnapViewModel" Focusable="False" Background="Transparent" Padding="4,2"
                        IsChecked="{Binding IsActive}" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Image Source="{StaticResource ImageTranslateSnap}" Width="16" Height="16"/>
              <sd:NumericTextBox Width="50" Value="{Binding Value}" Minimum="0" DecimalPlaces="3"/>
            </StackPanel>
          </ToggleButton>
        </Panel>
        <Panel x:DataType="vm:EditorViewToolbarViewModel" DataContext="{Binding Snaps[1]}">
          <ToggleButton x:DataType="vm:EditorViewSnapViewModel" Focusable="False" Background="Transparent" Padding="4,2"
                        IsChecked="{Binding IsActive}" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Image Source="{StaticResource ImageRotateSnap}" Width="16" Height="16"/>
              <sd:NumericTextBox Width="50" Value="{Binding Value}" Minimum="0" DecimalPlaces="3"/>
            </StackPanel>
          </ToggleButton>
        </Panel>
        <Panel x:DataType="vm:EditorViewToolbarViewModel" DataContext="{Binding Snaps[2]}">
          <ToggleButton x:DataType="vm:EditorViewSnapViewModel" Focusable="False" Background="Transparent" Padding="4,2"
                        IsChecked="{Binding IsActive}" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Image Source="{StaticResource ImageScaleSnap}" Width="16" Height="16"/>
              <sd:NumericTextBox Width="50" Value="{Binding Value}" Minimum="0" DecimalPlaces="3"/>
            </StackPanel>
          </ToggleButton>
        </Panel>
        <Separator Width="1" Height="20" Margin="2,0" />
        <!-- Grid: the grid of the view -->
        <Button x:Name="GridButton" x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Grid, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{sd:LocalizeString Viewport grid settings..., Context=ToolTip}">
          <Image Source="{StaticResource ImageGrid}" Width="16" Height="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel x:DataType="gevm:EditorGridViewModel" DataContext="{Binding Grid}" MinWidth="130" Spacing="4">
                <CheckBox Content="{sd:LocalizeString Show grid, Context=Button}" IsChecked="{Binding IsVisible}"/>
                <TextBlock Text="{sd:LocalizeString Grid axis}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="X" IsChecked="{Binding IsXAxisVisible}"/>
                  <CheckBox Content="Y" IsChecked="{Binding IsYAxisVisible}"/>
                  <CheckBox Content="Z" IsChecked="{Binding IsZAxisVisible}"/>
                </StackPanel>
                <TextBlock Text="{sd:LocalizeString Grid opacity}" FontWeight="Bold"/>
                <sd:NumericTextBox Value="{Binding Alpha}" SmallChange="0.1" Minimum="0" Maximum="1" DecimalPlaces="3"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Lighting: light probes and cubemaps -->
        <Button x:Name="LightingButton" x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Lighting, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{sd:LocalizeString Light probes and cubemaps..., Context=ToolTip}">
          <Image Source="{StaticResource ImageLighting}" Width="16" Height="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel x:DataType="ehvm:EditorLightingViewModel" DataContext="{Binding Lighting}" MinWidth="180" Spacing="4">
                <TextBlock Text="{sd:LocalizeString Light probes}" FontWeight="Bold"/>
                <DockPanel>
                  <sd:NumericTextBox DockPanel.Dock="Right" Width="60" Value="{Binding LightProbeBounces}" Minimum="0" DecimalPlaces="0"/>
                  <TextBlock Text="{sd:LocalizeString Bounces:}" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid Columns="2">
                  <Button HorizontalAlignment="Stretch" Margin="2" Command="{Binding RequestLightProbesComputeCommand}" ToolTip.Tip="{sd:LocalizeString Compute lighting using light probes, Context=ToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Image Source="{StaticResource ImageLightProbesCompute}" Width="16" Height="16"/>
                      <TextBlock Text="{sd:LocalizeString Compute}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button HorizontalAlignment="Stretch" Margin="2" Command="{Binding RequestLightProbesResetCommand}" ToolTip.Tip="{sd:LocalizeString Reset light probes, Context=ToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Image Source="{StaticResource ImageLightProbesReset}" Width="16" Height="16"/>
                      <TextBlock Text="{sd:LocalizeString Reset}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>
                <TextBlock Text="{sd:LocalizeString Cubemap}" FontWeight="Bold"/>
                <Button HorizontalAlignment="Stretch" Margin="2" Command="{Binding CaptureCubemapCommand}" ToolTip.Tip="{sd:LocalizeString Generate a cubemap from the scene view and save as a texture, Context=ToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="{StaticResource ImageGenerateCubeMap}" Width="16" Height="16"/>
                    <TextBlock Text="{sd:LocalizeString Capture}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Overlays: what the services of the game draw on request, the navigation meshes of the Physics package for
             instance -->
        <Button x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Overlays.HasSections, FallbackValue=False}" ToolTip.Tip="{sd:LocalizeString Overlays..., Context=ToolTip}">
          <Image Source="{StaticResource ImageNavigation}" Width="16" Height="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <local:EditorViewOverlaysPanel DataContext="{Binding Overlays}"/>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Gizmo options: the size of the gizmos and the gizmos of each type of component, plugins included (the collider
             shapes of the Physics package are hidden until checked) -->
        <Button x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Gizmos, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{sd:LocalizeString Gizmo options..., Context=ToolTip}">
          <Image Source="{StaticResource ImageGizmos}" Width="16" Height="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel>
                <local:EditorViewGizmosPanel DataContext="{Binding Gizmos}"/>
                <CheckBox Content="{sd:LocalizeString Camera preview, Context=Button}" IsChecked="{Binding DisplayCameraPreview}" IsVisible="{Binding HasCameraPreview}" Margin="0,2"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Camera: projection, planes, speed and orientation -->
        <Button x:Name="CameraButton" x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Camera, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{sd:LocalizeString Editor camera options..., Context=ToolTip}">
          <Image Source="{StaticResource ImageCameraSettings}" Width="16" Height="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel x:DataType="gevm:EditorCameraViewModel" DataContext="{Binding Camera}" Width="200" Spacing="4">
                <TextBlock Text="{sd:LocalizeString Projection}" FontWeight="Bold"/>
                <RadioButton GroupName="CameraProjection" Content="{sd:LocalizeString Perspective, Context=Button}" IsChecked="{Binding !OrthographicProjection, Mode=OneWay}"/>
                <RadioButton GroupName="CameraProjection" Content="{sd:LocalizeString Orthographic, Context=Button}" IsChecked="{Binding OrthographicProjection}"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                  <TextBlock Grid.Row="0" Text="{sd:LocalizeString Near plane:}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <sd:NumericTextBox Grid.Row="0" Grid.Column="1" Value="{Binding NearPlane}" DecimalPlaces="4" Minimum="0"/>
                  <TextBlock Grid.Row="1" Text="{sd:LocalizeString Far plane:}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <sd:NumericTextBox Grid.Row="1" Grid.Column="1" Value="{Binding FarPlane}" DecimalPlaces="4" Minimum="0"/>
                  <TextBlock Grid.Row="2" Text="{sd:LocalizeString Field of view:}" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding !OrthographicProjection}"/>
                  <sd:NumericTextBox Grid.Row="2" Grid.Column="1" Value="{Binding FieldOfView}" DecimalPlaces="1" Minimum="0" Maximum="180" IsVisible="{Binding !OrthographicProjection}"/>
                  <Slider Grid.Row="3" Grid.ColumnSpan="2" Minimum="0" Maximum="180" Value="{Binding FieldOfView}" IsVisible="{Binding !OrthographicProjection}"/>
                  <TextBlock Grid.Row="4" Text="{sd:LocalizeString Orthographic size:}" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding OrthographicProjection}"/>
                  <sd:NumericTextBox Grid.Row="4" Grid.Column="1" Value="{Binding OrthographicSize}" DecimalPlaces="4" Minimum="0" IsVisible="{Binding OrthographicProjection}"/>
                </Grid>
                <TextBlock Text="{sd:LocalizeString Movement}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{sd:LocalizeString Speed:}"/>
                  <TextBlock Text="{Binding MoveSpeed}"/>
                  <TextBlock Text="x"/>
                </StackPanel>
                <Slider Minimum="0" Maximum="{Binding AvailableMovementSpeedCount}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding MoveSpeedIndex}"/>
                <TextBlock Text="{sd:LocalizeString Orientation}" FontWeight="Bold"/>
                <UniformGrid Columns="2">
                  <Button Content="{sd:LocalizeString Front, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Front}"/>
                  <Button Content="{sd:LocalizeString Back, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Back}"/>
                  <Button Content="{sd:LocalizeString Top, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Top}"/>
                  <Button Content="{sd:LocalizeString Bottom, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Bottom}"/>
                  <Button Content="{sd:LocalizeString Left, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Left}"/>
                  <Button Content="{sd:LocalizeString Right, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ResetCameraOrientationCommand}" CommandParameter="{x:Static ae:CameraOrientation.Right}"/>
                </UniformGrid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Views: one, two or four views of the scene, each with its camera, and the active one maximized -->
        <Button x:Name="ViewsButton" x:DataType="vm:EditorViewToolbarViewModel" Focusable="False" Background="Transparent" Padding="6"
                IsVisible="{Binding Views, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{sd:LocalizeString Views of the scene..., Context=ToolTip}">
          <Path Classes="icon" Data="M1,2 H7.5 V14 H1 Z M8.5,2 H15 V7.5 H8.5 Z M8.5,8.5 H15 V14 H8.5 Z" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel x:DataType="vm:EditorViewLayoutViewModel" DataContext="{Binding Views}" Width="230" Spacing="4">
                <TextBlock Text="{sd:LocalizeString Layout}" FontWeight="Bold"/>
                <!-- Each layout as a small picture of its panes, with the letter of the camera each pane starts with -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <StackPanel.Styles>
                    <Style Selector="Button.layout">
                      <Setter Property="Padding" Value="4"/>
                      <Setter Property="Margin" Value="2"/>
                    </Style>
                    <Style Selector="Button.layout Grid">
                      <Setter Property="Width" Value="44"/>
                      <Setter Property="Height" Value="32"/>
                    </Style>
                    <Style Selector="Button.layout Border">
                      <Setter Property="BorderBrush" Value="Gray"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Margin" Value="1"/>
                    </Style>
                    <Style Selector="Button.layout TextBlock">
                      <Setter Property="FontSize" Value="11"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                  </StackPanel.Styles>
                  <Button x:Name="SingleViewButton" Classes="layout" ToolTip.Tip="{sd:LocalizeString One view: Perspective, Context=ToolTip}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:EditorViewLayout.Single}">
                    <Grid>
                      <Border><TextBlock Text="{sd:LocalizeString P, Context=ViewLetter}"/></Border>
                    </Grid>
                  </Button>
                  <Button x:Name="TwoColumnsButton" Classes="layout" ToolTip.Tip="{sd:LocalizeString 'Two views, side by side: Perspective and Top', Context=ToolTip}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:EditorViewLayout.TwoColumns}">
                    <Grid ColumnDefinitions="*,*">
                      <Border><TextBlock Text="{sd:LocalizeString P, Context=ViewLetter}"/></Border>
                      <Border Grid.Column="1"><TextBlock Text="{sd:LocalizeString T, Context=ViewLetter}"/></Border>
                    </Grid>
                  </Button>
                  <Button x:Name="TwoRowsButton" Classes="layout" ToolTip.Tip="{sd:LocalizeString 'Two views, stacked: Perspective and Front', Context=ToolTip}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:EditorViewLayout.TwoRows}">
                    <Grid RowDefinitions="*,*">
                      <Border><TextBlock Text="{sd:LocalizeString P, Context=ViewLetter}"/></Border>
                      <Border Grid.Row="1"><TextBlock Text="{sd:LocalizeString F, Context=ViewLetter}"/></Border>
                    </Grid>
                  </Button>
                  <Button x:Name="QuadButton" Classes="layout" ToolTip.Tip="{sd:LocalizeString 'Four views: Top, Front, Left and Perspective', Context=ToolTip}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:EditorViewLayout.Quad}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                      <Border><TextBlock Text="{sd:LocalizeString T, Context=ViewLetter}"/></Border>
                      <Border Grid.Column="1"><TextBlock Text="{sd:LocalizeString F, Context=ViewLetter}"/></Border>
                      <Border Grid.Row="1"><TextBlock Text="{sd:LocalizeString L, Context=ViewLetter}"/></Border>
                      <Border Grid.Row="1" Grid.Column="1"><TextBlock Text="{sd:LocalizeString P, Context=ViewLetter}"/></Border>
                    </Grid>
                  </Button>
                </StackPanel>
                <Button x:Name="MaximizeButton" Content="{sd:LocalizeString Maximize or restore active view, Context=Button}" HorizontalAlignment="Stretch" Margin="2" Command="{Binding ToggleMaximizeCommand}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="{sd:LocalizeString 'The view under the pointer is active: the camera, the gizmos and the selection work there.'}"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Render mode: the editor, the game preview, or one stream of the materials -->
        <Panel x:DataType="vm:EditorViewToolbarViewModel" DataContext="{Binding Rendering}" VerticalAlignment="Center"
               IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ComboBox x:Name="RenderModeBox" x:DataType="ehvm:EditorRenderingViewModel" Focusable="False" Width="110"
                  ItemsSource="{Binding AvailableRenderModes}" SelectedItem="{Binding RenderMode}">
          <ComboBox.Styles>
            <Style Selector="ComboBoxItem">
              <Setter Property="IsEnabled" Value="{ReflectionBinding !IsSeparator}"/>
            </Style>
          </ComboBox.Styles>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="eh:EditorRenderMode">
              <Panel>
                <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsSeparator}"/>
                <Separator IsVisible="{Binding IsSeparator}" Margin="0,2"/>
              </Panel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        </Panel>
        <!-- Widgets: the widgets of the plugins on the edges of the view, each shown or hidden for this scene -->
        <Button x:Name="WidgetsButton" x:DataType="vm:SceneViewWidgetsViewModel" Focusable="False" Background="Transparent" Padding="6"
                DataContext="{Binding $parent[local:EntityHierarchyEditorView].((vm:EntityHierarchyEditorViewModel)DataContext).SceneViewWidgets}"
                IsVisible="{Binding HasWidgets, FallbackValue=False}" ToolTip.Tip="{sd:LocalizeString Widgets..., Context=ToolTip}">
          <Path Classes="icon" Data="M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SceneViewWidgetViewModel">
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsVisible}" Focusable="False" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- The game of the editor renders here; the text shows while it has no game (yet) -->
      <Panel>
        <TextBlock Text="{sd:LocalizeString The scene view is not available.}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding GameHost.GameView, Converter={x:Static ObjectConverters.IsNull}}" />
        <!-- Assets dropped on the view add their entities under the pointer -->
        <ContentControl x:Name="GameViewHost"
                        IsVisible="{Binding GameHost.LastException, Converter={x:Static ObjectConverters.IsNull}}">
          <!-- Cut, Copy and Rename act on the selected entities from the view too (its context menu, and the
               shortcuts while it has the focus); Delete and Paste come from the editor's bindings -->
          <sd:EditCommands.Bindings>
            <sd:EditCommandBinding Kind="Cut" Command="{Binding CutCommand}"/>
            <sd:EditCommandBinding Kind="Copy" Command="{Binding CopyCommand}"/>
            <sd:EditCommandBinding Kind="Rename" Command="{Binding RenameCommand}"/>
          </sd:EditCommands.Bindings>
          <Interaction.Behaviors>
            <dd:AddChildDropBehavior/>
          </Interaction.Behaviors>
          <!-- The views of the game: the primary view alone, or several views with a camera each -->
          <local:EditorViewLayoutPanel x:Name="GameViews" GameView="{Binding GameHost.GameView}"
                                       Viewport="{Binding GameHost.Controller.Viewport, FallbackValue={x:Null}}"
                                       Layout="{Binding ((vm:EditorViewToolbarViewModel)ViewOptions).Views, FallbackValue={x:Null}}"/>
        </ContentControl>
        <!-- The widgets of the plugins, on the edges of the view over the game; the panels have no background, so the pointer
             reaches the game everywhere but on a widget -->
        <DockPanel x:Name="WidgetLayer" IsVisible="{Binding GameHost.LastException, Converter={x:Static ObjectConverters.IsNull}}">
          <StackPanel x:Name="TopWidgets" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Left" />
          <StackPanel x:Name="BottomWidgets" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Left" />
          <StackPanel x:Name="LeftWidgets" DockPanel.Dock="Left" Orientation="Vertical" Spacing="4" Margin="4" VerticalAlignment="Top" />
          <StackPanel x:Name="RightWidgets" DockPanel.Dock="Right" Orientation="Vertical" Spacing="4" Margin="4" VerticalAlignment="Top" />
          <Panel />
        </DockPanel>
        <!-- The game stopped on an exception (EditorGameRecoveryService): the error, with Resume and Copy -->
        <Panel x:Name="GameErrorPane" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
               IsVisible="{Binding GameHost.LastException, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400" MaxWidth="1200" Margin="20" Padding="20"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
              <SelectableTextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{Binding GameHost.LastException.Message, StringFormat=Error: {0}, FallbackValue={x:Null}}"/>
              <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap"
                           Text="{sd:LocalizeString Before you resume\, fix the failing asset (likely a graphics compositor or scene).}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                  <Button x:Name="ResumeButton" Content="{sd:LocalizeString Resume, Context=Button}" Padding="24,8"
                          Command="{Binding GameHost.ResumeCommand}"/>
                  <Button x:Name="CopyErrorButton" Content="{sd:LocalizeString Copy error to clipboard, Context=Button}" Padding="24,8"
                          Command="{Binding GameHost.CopyErrorToClipboardCommand}"/>
                </StackPanel>
              </StackPanel>
              <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding GameHost.LastException, FallbackValue={x:Null}}"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
