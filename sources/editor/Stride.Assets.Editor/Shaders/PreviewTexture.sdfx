using Stride.Rendering.Data;
using Stride.Shaders.Compiler;

namespace StrideEffects
{
    params PreviewTextureParameters
    {
        bool Is3D;
    };

    effect PreviewTexture
    {
        using params PreviewTextureParameters;
        using params SpriteBaseKeys;

        if(PreviewTextureParameters.Is3D)
        {
            mixin Sprite3DBase;
        }

        // The SpriteBatch effect file no longer exists: mix the sprite batch shader directly, as SpriteBatch itself does
        mixin SpriteBatchShader<SpriteBaseKeys.ColorIsSRgb>;
    };
}
