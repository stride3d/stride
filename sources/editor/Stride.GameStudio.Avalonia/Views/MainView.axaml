<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:cmd="using:Stride.Core.Assets.Editor.Avalonia.Commands"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:caevmp="using:Stride.Core.Assets.Editor.ViewModels.Progress"
             xmlns:cpc="using:Stride.Core.Presentation.Commands"
             xmlns:gsc="using:Stride.GameStudio.Avalonia.Converters"
             xmlns:gsh="using:Stride.GameStudio.Avalonia.Helpers"
             xmlns:gsvm="using:Stride.GameStudio.Avalonia.ViewModels"
             xmlns:gsvw="using:Stride.GameStudio.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Stride.GameStudio.Avalonia.Views.MainView"
             x:DataType="gsvm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <gsvm:MainViewModel/>
  </Design.DataContext>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.GameStudio.Avalonia/Views/PackageMenuResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- An entry of File > Open recent: the version in bold, then the path, shortened in the middle -->
      <DataTemplate x:Key="RecentSessionHeaderTemplate" DataType="gsvm:RecentSessionViewModel">
        <Grid ColumnDefinitions="30, Auto">
          <TextBlock Grid.Column="0" Text="{Binding Version}" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" MaxWidth="320" TextTrimming="PathSegmentEllipsis"/>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- The Edit commands that no panel handles, bound on the window: Undo and Redo act on the session
       wherever the focus is, unless a text editor has it. -->
  <sd:EditCommands.Bindings>
    <sd:EditCommandBinding Kind="Undo" Command="{Binding UndoCommand}"/>
    <sd:EditCommandBinding Kind="Redo" Command="{Binding RedoCommand}"/>
  </sd:EditCommands.Bindings>

  <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, 25"
        Background="Transparent">
    <!-- Menus -->
    <Menu Name="MainMenu" Grid.Row="0" Grid.Column="0"
          VerticalAlignment="Top">
      <!-- File menu. The editor's items bind its commands by id ({cmd:Command}): the main window gives them their command,
           their title (unless the item has a header of its own, for its access key) and the user's shortcut. Each main menu
           ends with the commands that the editor and the plugins place there (MainCommandSlots); in this one they go before Exit. -->
      <MenuItem Header="{sd:LocalizeString _File, Context=Menu}"
                Name="FileMenu">
        <!-- A new session from a template (the project selection window). New, Open and Exit work without a session too. -->
        <MenuItem Header="{sd:LocalizeString _New..., Context=Menu}"
                  Name="NewMenuItem"
                  Command="{cmd:Command Stride.File.New}"/>
        <MenuItem Header="{sd:LocalizeString _Open..., Context=Menu}"
                  Name="OpenMenuItem"
                  Command="{cmd:Command Stride.File.Open}"/>
        <MenuItem Header="{sd:LocalizeString _Close, Context=Menu}"
                  Command="{cmd:Command Stride.File.Close}"/>
        <Separator/>
        <!-- Recent sessions (the most recently used sessions of this editor version or an earlier one), then "Clear list": the
             items are made by the view (MainView.UpdateRecentSessionsMenu) since a menu shows either items or a source -->
        <MenuItem Header="{sd:LocalizeString Open _recent, Context=Menu}"
                  Name="RecentSessionsMenu"
                  IsEnabled="{Binding RecentFiles.Count, Mode=OneWay, Converter={sd:NumericToBool}}"/>
        <Separator/>
        <!-- Save and reload: Save is enabled whenever a session is open -->
        <MenuItem Header="{sd:LocalizeString _Save, Context=Menu}"
                  Name="SaveMenuItem"
                  Command="{cmd:Command Stride.File.Save}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString _Reload project, Context=Menu}"
                  Command="{cmd:Command Stride.File.ReloadProject}"/>
        <Separator Name="ExitSeparator"/>
        <MenuItem Header="{sd:LocalizeString E_xit, Context=Menu}"
                  Name="ExitMenuItem"
                  Command="{cmd:Command Stride.File.Exit}"/>
      </MenuItem>
      <!-- Edit menu: its items act on the panel that has the focus, through the router of the view (see EditCommandRouter).
           Their shortcuts are handled by the main window after the focused control, so that a text box keeps its own. -->
      <MenuItem Header="{sd:LocalizeString Edit, Context=Menu}"
                Name="EditMenu">
        <MenuItem Name="UndoMenuItem"
                  Command="{cmd:Command Stride.Edit.Undo}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageUndo}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="RedoMenuItem"
                  Command="{cmd:Command Stride.Edit.Redo}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageRedo}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Name="CutMenuItem"
                  Command="{cmd:Command Stride.Edit.Cut}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageCut}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="CopyMenuItem"
                  Command="{cmd:Command Stride.Edit.Copy}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageCopy}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="PasteMenuItem"
                  Command="{cmd:Command Stride.Edit.Paste}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImagePaste}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="DeleteMenuItem"
                  Command="{cmd:Command Stride.Edit.Delete}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageDelete}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="RenameMenuItem"
                  Command="{cmd:Command Stride.Edit.Rename}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageRename}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString _Settings..., Context=Menu}"
                  Name="SettingsMenuItem"
                  Command="{cmd:Command Stride.Edit.Settings}"/>
        <MenuItem Name="KeyboardShortcutsMenuItem"
                  Command="{cmd:Command Stride.Edit.KeyboardShortcuts}"/>
      </MenuItem>
      <!-- View menu: a toggle per panel (a command of the registry, checked while the panel is shown), in sections, then
           Reset layout; its items are made by the view (MainView.UpdateViewMenu) from MainViewModel.ViewMenu, which follows
           the panels the plugins register -->
      <MenuItem Header="{sd:LocalizeString _View, Context=Menu}"
                Name="ViewMenu"
                IsEnabled="{Binding Session, Mode=OneWay, Converter={sd:ObjectToBool}}"/>
      <!-- Project menu: build the current project and start its game -->
      <MenuItem Header="{sd:LocalizeString _Project, Context=Menu}"
                Name="ProjectMenu"
                IsEnabled="{Binding Session, Mode=OneWay, Converter={sd:ObjectToBool}}">
        <MenuItem Name="BuildProjectMenuItem"
                  Command="{cmd:Command Stride.Project.Build}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageBuildProject}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="StartProjectMenuItem"
                  Command="{cmd:Command Stride.Project.Start}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageStartProject}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="CancelBuildMenuItem"
                  Command="{cmd:Command Stride.Project.CancelBuild}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageStopBuild}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <!-- The package commands, on the package selected in the solution explorer: Update package (shown
             when a project is selected) lists the package templates, Add dependency opens the package picker -->
        <MenuItem Header="{sd:LocalizeString Update package, Context=Menu}"
                  Name="UpdatePackageMenuItem"
                  ItemsSource="{Binding Session.UpdatePackageViewModel.Templates, FallbackValue={x:Null}}"
                  ItemTemplate="{StaticResource PackageTemplateHeaderTemplate}"
                  ItemContainerTheme="{StaticResource PackageTemplateMenuItemTheme}"
                  IsVisible="{Binding Session.IsUpdatePackageEnabled, FallbackValue=False}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageAddNewProject}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="AddDependencyMenuItem"
                  Command="{cmd:Command Stride.Project.AddDependency}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageAddDependency}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <!-- Opens the solution in the IDE of the settings; the toolbar's drop-down picks another installed IDE -->
        <MenuItem Name="OpenInIDEMenuItem"
                  Command="{cmd:Command Stride.Project.OpenInIDE}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageCodeEditor}"/>
          </MenuItem.Icon>
        </MenuItem>
        <!-- Enabled while the game code has changes the editor did not load: they load in a new editor on the project -->
        <MenuItem Name="ReloadGameCodeMenuItem"
                  Command="{cmd:Command Stride.Project.ReloadGameAssemblies}">
          <MenuItem.Icon>
            <Image Source="{StaticResource ImageReloadAssemblies}"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- Tools menu: only the commands that the editor and the plugins place there, shown when it has some -->
      <MenuItem Header="{sd:LocalizeString _Tools, Context=Menu}"
                Name="ToolsMenu"
                IsVisible="False"/>
      <!-- Help menu -->
      <MenuItem Header="{sd:LocalizeString _Help, Context=Menu}"
                Name="HelpMenu">
        <MenuItem Command="{cmd:Command Stride.Help.Documentation}"/>
        <Separator/>
        <MenuItem Command="{cmd:Command Stride.Help.Questions}"/>
        <MenuItem Command="{cmd:Command Stride.Help.ReportIssue}"/>
        <MenuItem Command="{cmd:Command Stride.Help.Forum}"/>
        <Separator/>
        <MenuItem Name="DebugWindowMenuItem"
                  Command="{cmd:Command Stride.Help.DebugWindow}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString _About..., Context=Menu}"
                  Command="{cmd:Command Stride.Help.About}"/>
      </MenuItem>
      <MenuItem Header="Debug"
                IsVisible="{sd:IsDebug}">
        <MenuItem Header="Simulate a crash"
                  Command="{Binding CrashCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar: the build buttons, while a session is open, then the command buttons and the widgets that
         the editor and the plugins place there (MainCommandSlots) -->
    <sd:ToolBar Grid.Row="1"
                Name="MainToolBar"
                IsVisible="{Binding Session, Converter={sd:ObjectToBool}}">
      <sd:ToolBar.Styles>
        <!-- The icon of a disabled button is dimmed -->
        <Style Selector="Button:disabled Image">
          <Setter Property="Opacity" Value="0.25"/>
        </Style>
        <!-- The reload button blinks while the game code has changes to load -->
        <Style Selector="Button#ReloadGameCodeButton:not(:disabled) Image">
          <Style.Animations>
            <Animation Duration="0:0:0.5" IterationCount="Infinite" PlaybackDirection="Alternate">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="1"/>
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.3"/>
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </sd:ToolBar.Styles>
      <!-- The editor's buttons bind its commands by id: their tool tips end with the user's shortcut -->
      <Button Name="BuildProjectButton"
              Command="{cmd:Command Stride.Project.Build, ToolTip={sd:LocalizeString Build the project, Context=ToolTip}}"
              ToolTip.ShowOnDisabled="True">
        <Image Source="{StaticResource ImageBuildProject}" Width="16" Height="16"/>
      </Button>
      <Button Name="StartProjectButton"
              Command="{cmd:Command Stride.Project.Start, ToolTip={sd:LocalizeString Build the project and start the game, Context=ToolTip}}"
              ToolTip.ShowOnDisabled="True">
        <Image Source="{StaticResource ImageStartProject}" Width="16" Height="16"/>
      </Button>
      <Button Name="CancelBuildButton"
              Command="{cmd:Command Stride.Project.CancelBuild, ToolTip={sd:LocalizeString Cancel the current build, Context=ToolTip}}"
              ToolTip.ShowOnDisabled="True">
        <Image Source="{StaticResource ImageStopBuild}" Width="16" Height="16"/>
      </Button>
      <!-- Open in IDE (the IDE of the settings), and the installed IDEs to open the solution with -->
      <Button Name="OpenInIDEButton"
              Command="{cmd:Command Stride.Project.OpenInIDE, ToolTip={sd:LocalizeString Open in IDE, Context=ToolTip}}"
              ToolTip.ShowOnDisabled="True">
        <Image Source="{StaticResource ImageCodeEditor}" Width="16" Height="16"/>
      </Button>
      <DropDownButton Name="OpenWithIDEButton"
                      Padding="0"
                      ToolTip.Tip="{sd:LocalizeString Open with..., Context=ToolTip}">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft"/>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Name="ReloadGameCodeButton"
              Command="{cmd:Command Stride.Project.ReloadGameAssemblies, ToolTip={sd:LocalizeString Reload the game assemblies: build the changed code and open the project in a new editor, Context=ToolTip}}"
              ToolTip.ShowOnDisabled="True">
        <Image Source="{StaticResource ImageReloadAssemblies}" Width="16" Height="16"/>
      </Button>
    </sd:ToolBar>

    <!-- Safe mode (D12 A): how many plugins are off, "Restart normally" (the same project without safe mode), and the Plugins panel -->
    <Border Name="SafeModeBanner" Grid.Row="2" Padding="8,4" BorderThickness="0,1" BorderBrush="Gray" Background="#30E0A040"
            IsVisible="{Binding SafeModeBanner?.IsVisible, FallbackValue=False}">
      <Grid ColumnDefinitions="*, Auto, Auto">
        <TextBlock Name="SafeModeMessage" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SafeModeBanner?.Message}"/>
        <Button Name="OpenPluginsPanelButton" Grid.Column="1" Margin="8,0,0,0"
                Content="{sd:LocalizeString Show the plugins, Context=Button}"
                Command="{Binding SafeModeBanner?.OpenPluginsPanelCommand}"/>
        <Button Name="RestartNormallyButton" Grid.Column="2" Margin="8,0,0,0"
                Content="{sd:LocalizeString Restart normally, Context=Button}"
                Command="{Binding SafeModeBanner?.RestartNormallyCommand}"
                ToolTip.Tip="{sd:LocalizeString Open the project again with all its plugins, Context=ToolTip}"/>
      </Grid>
    </Border>

    <!-- Session area: the panels and the editors, docked as the layout of the session says (MainViewModel.Panels); the
         floating ones are in windows of their own. The views of the panels come from DockViewLocator. -->
    <dock:DockControl x:Name="DockArea" Grid.Row="3"
                      Layout="{Binding Panels.Layout}"
                      Factory="{Binding Panels.Factory}"
                      InitializeLayout="False" InitializeFactory="False"
                      EnableManagedWindowLayer="True"
                      IsVisible="{Binding Session, Converter={sd:ObjectToBool}}"/>

    <!-- Notifications: the background operations in progress, each until it finishes -->
    <ItemsControl Grid.Row="4"
                  ItemsSource="{Binding Notifications?.ActiveNotifications}"
                  IsVisible="{Binding $self.ItemCount, Converter={sd:NumericToBool}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="caevmp:WorkProgressViewModel">
          <Border Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="Gray">
            <Grid ColumnDefinitions="Auto, *, Auto">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         Text="{Binding Title}"
                         ToolTip.Tip="{Binding ProgressMessage}"/>
              <ProgressBar Grid.Column="1"
                           VerticalAlignment="Center"
                           Height="16"
                           Margin="4,0"
                           IsIndeterminate="{Binding IsIndeterminate}"
                           Minimum="{Binding Minimum}"
                           Maximum="{Binding Maximum}"
                           Value="{Binding ProgressValue}"/>
              <Button Grid.Column="2"
                      Content="{sd:LocalizeString Cancel, Context=Button}"
                      Margin="8,0,0,0"
                      Command="{Binding CancelCommand}"
                      IsVisible="{Binding IsCancellable}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The command palette (Ctrl+Shift+P): over the top of the main window, until a command runs or the user clicks elsewhere -->
    <Popup Name="CommandPalettePopup" Grid.Row="0" Grid.RowSpan="6"
           Placement="AnchorAndGravity" PlacementAnchor="Top" PlacementGravity="Bottom" VerticalOffset="48"
           IsLightDismissEnabled="True"
           Closed="OnCommandPaletteClosed">
      <gsvw:CommandPaletteView Name="CommandPalette"/>
    </Popup>

    <!-- Status bar -->
    <Grid Grid.Row="5"
          IsVisible="{Binding Session, Converter={sd:ObjectToBool}}"
          ColumnDefinitions="2*, Auto, *, Auto, *, 100">
      <TextBlock Grid.Column="0"
                 Margin="8,0"
                 VerticalAlignment="Center"
                 Text="{Binding Status.CurrentStatus}"/>
      <Border Grid.Column="1"
              Margin="2"
              BorderThickness="1"
              BorderBrush="Gray"/>
      <TextBlock Grid.Column="2"
                 Margin="8,0"
                 VerticalAlignment="Center">
        <Run Text="{Binding Session?.AssetCollection.FilteredContent.Count, Mode=OneWay, Converter={sd:Localize Text={}{0} item, Plural={}{0} items, IsStringFormat=True, Context=StatusBar}}"/>
        <Run Text="{Binding Session?.AssetCollection.SelectedContent.Count, Mode=OneWay, Converter={sd:Localize Text=({0} selected), Plural=({0} selected), IsStringFormat=True, Context=StatusBar}}"/>
      </TextBlock>
      <Border Grid.Column="3"
              Margin="2"
              BorderThickness="1"
              BorderBrush="Gray"/>
      <TextBlock Grid.Column="4"
                 Margin="8,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{Binding Status.CurrentJob?.Message}"/>
      <ProgressBar Grid.Column="5"
                   IsVisible="{Binding Status.CurrentJob, Converter={sd:ObjectToBool}}"
                   Margin="0,2"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Left"
                   IsIndeterminate="{Binding Status.CurrentJob?.IsIndeterminate, TargetNullValue={sd:True}}"
                   Maximum="{Binding Status.CurrentJob?.Total, TargetNullValue={sd:Double 0}}"
                   Value="{Binding Status.CurrentJob?.Current, TargetNullValue={sd:Double 0}}"/>
    </Grid>
  </Grid>
</UserControl>
