<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:cmd="using:Stride.Core.Assets.Editor.Avalonia.Commands"
             xmlns:cmdl="using:Stride.Core.Assets.Editor.Commands"
             xmlns:vm="using:Stride.Core.Assets.Presentation.ViewModels"
             xmlns:vm2="using:Stride.Core.Assets.Editor.ViewModels"
             xmlns:dd="using:Stride.Core.Assets.Editor.Avalonia.DragDrop"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stride.GameStudio.Avalonia.Views.SolutionExplorerView"
             x:DataType="vm2:SessionViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
        <ResourceInclude Source="avares://Stride.GameStudio.Avalonia/Views/PackageMenuResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel>
    <!-- A "*" follows the name of an item with unsaved changes -->
    <TreeView x:Name="SolutionTree"
              Focusable="True"
              ItemsSource="{Binding PackageCategories.Values}"
              SelectedItems="{Binding AssetCollection.SelectedLocations}"
              SelectionMode="Multiple"
              Margin="4">
      <!-- The Edit commands while the solution explorer has the focus -->
      <sd:EditCommands.Bindings>
        <sd:EditCommandBinding Kind="Cut" Command="{Binding AssetCollection.CutLocationsCommand}"/>
        <sd:EditCommandBinding Kind="Copy" Command="{Binding AssetCollection.CopyLocationsCommand}"/>
        <sd:EditCommandBinding Kind="Paste" Command="{Binding AssetCollection.PasteCommand}"/>
        <sd:EditCommandBinding Kind="Delete" Command="{Binding DeleteSelectedSolutionItemsCommand}"/>
        <sd:EditCommandBinding Kind="Rename" Command="{Binding RenameDirectoryOrPackageCommand}" CommandParameter="{Binding AssetCollection.SelectedLocations}"/>
      </sd:EditCommands.Bindings>
      <!-- The context menu of the solution explorer, in groups shown when one of
           their commands applies to the selection; its items bind the commands of the registry by their identifier, which
           act on the selection the menu opened on -->
      <TreeView.ContextMenu>
        <ContextMenu x:Name="SolutionContextMenu"
                     cmd:CommandSlot.Location="{x:Static cmdl:CommandLocations.SolutionExplorerContext}"
                     cmd:CommandSlot.Selection="{Binding AssetCollection.SelectedLocations}">
          <MenuItem Header="{sd:LocalizeString Folder, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"
                    IsVisible="{Binding NewDirectoryCommand.IsEnabled}"/>
          <MenuItem Command="{cmd:Command Stride.Asset.NewFolder}"
                    IsVisible="{Binding NewDirectoryCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageNewFolder}"/>
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="{sd:LocalizeString Package, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"
                    IsVisible="{sd:MultiBinding {Binding IsUpdatePackageEnabled}, {Binding AddDependencyCommand.IsEnabled}, {Binding SetCurrentProjectCommand.IsEnabled}, {Binding ActivatePackagePropertiesCommand.IsEnabled}, Converter={sd:OrMulti}}"/>
          <MenuItem Header="{sd:LocalizeString Update package, Context=Menu}"
                    x:Name="SolutionUpdatePackageMenuItem"
                    ItemsSource="{Binding UpdatePackageViewModel.Templates}"
                    ItemTemplate="{StaticResource PackageTemplateHeaderTemplate}"
                    ItemContainerTheme="{StaticResource PackageTemplateMenuItemTheme}"
                    IsVisible="{Binding IsUpdatePackageEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageAddNewProject}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="SolutionAddDependencyMenuItem"
                    Command="{cmd:Command Stride.Project.AddDependency}"
                    IsVisible="{Binding AddDependencyCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageAddDependency}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Project.SetCurrent}"
                    IsVisible="{Binding SetCurrentProjectCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageStartupProject}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Project.PackageProperties}"
                    IsVisible="{Binding ActivatePackagePropertiesCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImagePackageProperties}"/>
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="{sd:LocalizeString Solution, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"
                    IsVisible="{sd:MultiBinding {Binding NewProjectCommand.IsEnabled}, {Binding AddExistingProjectCommand.IsEnabled}, {Binding OpenInIDECommand.IsEnabled}, Converter={sd:OrMulti}}"/>
          <MenuItem Command="{cmd:Command Stride.Project.NewProject}"
                    IsVisible="{Binding NewProjectCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageAddNewPackage}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Project.AddExistingProject}"
                    IsVisible="{Binding AddExistingProjectCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageAddExistingProject}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="SolutionOpenInIDEMenuItem"
                    Command="{cmd:Command Stride.Project.OpenInIDE}"
                    IsVisible="{Binding OpenInIDECommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageCodeEditor}"/>
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="{sd:LocalizeString Actions, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"/>
          <MenuItem Command="{cmd:Command Stride.Edit.Cut}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageCut}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Edit.Copy}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageCopy}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Edit.Paste}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImagePaste}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Edit.Delete}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageDelete}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{cmd:Command Stride.Edit.Rename}"
                    IsVisible="{Binding RenameDirectoryOrPackageCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageRename}"/>
            </MenuItem.Icon>
          </MenuItem>

          <!-- The asset group of the menu, shown where an asset can be created -->
          <MenuItem Header="{sd:LocalizeString Asset, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"
                    IsVisible="{Binding NewDirectoryCommand.IsEnabled}"/>
          <MenuItem Command="{cmd:Command Stride.Asset.Add}"
                    IsVisible="{Binding NewDirectoryCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageNewAsset}"/>
            </MenuItem.Icon>
          </MenuItem>

          <!-- The explore group of the menu -->
          <MenuItem Header="{sd:LocalizeString Explore, Context=Menu}" FontWeight="Bold" IsHitTestVisible="False"
                    IsVisible="{Binding ExploreCommand.IsEnabled}"/>
          <MenuItem Command="{cmd:Command Stride.Asset.ShowInExplorer}"
                    IsVisible="{Binding ExploreCommand.IsEnabled}">
            <MenuItem.Icon>
              <Image Source="{StaticResource ImageExplore}"/>
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </TreeView.ContextMenu>
      <Control.DataTemplates>
        <TreeDataTemplate DataType="{x:Type vm:AssetMountPointViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <!-- An asset dragged from the asset view moves here -->
            <Interaction.Behaviors>
              <dd:AddChildDropBehavior/>
            </Interaction.Behaviors>
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ICategoryViewModel}"
                           ItemsSource="{Binding Content}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Category: " />
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:DirectoryViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <!-- An asset dragged from the asset view moves to this folder -->
            <Interaction.Behaviors>
              <dd:AddChildDropBehavior/>
            </Interaction.Behaviors>
            <TextBlock Text="Directory: " />
            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditing}" />
            <!-- Renaming in place (F2): the box replaces the name while the folder is editing -->
            <TextBox Text="{Binding Name, Mode=OneWay}" IsVisible="{Binding IsEditing}" MinWidth="80">
              <Interaction.Behaviors>
                <sd:InlineEditBehavior Name="{Binding Name, Mode=TwoWay}" IsEditing="{Binding IsEditing, Mode=TwoWay}"/>
              </Interaction.Behaviors>
            </TextBox>
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ProjectViewModel}"
                          ItemsSource="{Binding Content}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Project: " />
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:PackageViewModel}"
                          ItemsSource="{Binding Content}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Package: " />
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <DataTemplate DataType="{x:Type vm:PackageReferenceViewModel}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Reference: " />
            <TextBlock Text="{Binding Name}" />
          </StackPanel>
        </DataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ProjectCodeViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
          </StackPanel>
        </TreeDataTemplate>
        <!-- Fallback -->
        <DataTemplate DataType="{x:Type vm:SessionObjectViewModel}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Unknown type: " />
            <TextBlock Text="{Binding Name}" />
          </StackPanel>
        </DataTemplate>
      </Control.DataTemplates>
    </TreeView>
  </DockPanel>
</UserControl>
