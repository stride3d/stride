<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:caep="using:Stride.Core.Assets.Editor.Panels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="Stride.GameStudio.Avalonia.Views.Panels.OutputView"
             x:DataType="caep:OutputPanelViewModel">
  <!-- The log of the last build and the output of the games started from the editor -->
  <sd:TextLogViewer LogMessages="{Binding Build.BuildLog.Messages}"
                    ShowDebugMessages="False" ShowVerboseMessages="False"/>
</UserControl>
