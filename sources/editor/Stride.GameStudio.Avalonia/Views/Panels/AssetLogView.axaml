<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:caectl="using:Stride.Core.Assets.Editor.Avalonia.Controls"
             xmlns:caevm="using:Stride.Core.Assets.Editor.ViewModels"
             xmlns:caevml="using:Stride.Core.Assets.Presentation.ViewModels.Logs"
             xmlns:caep="using:Stride.Core.Assets.Editor.Panels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="Stride.GameStudio.Avalonia.Views.Panels.AssetLogView"
             x:DataType="caep:AssetLogPanelViewModel">
  <!-- The warnings and errors of the assets, as WPF's Asset errors pane -->
  <caectl:GridLogViewer LogMessages="{Binding AssetLog.FilteredMessages}"
                        SelectMessageCommand="{Binding AssetLog.SelectMessageAssetCommand}"
                        ShowDebugMessages="False" ShowVerboseMessages="False" ShowInfoMessages="False">
    <caectl:GridLogViewer.ToolBarContent>
      <StackPanel Orientation="Horizontal" DataContext="{Binding AssetLog}" x:DataType="caevm:AssetLogViewModel">
        <ComboBox Name="AssetLogScope" MinWidth="100" VerticalAlignment="Center"
                  SelectedValue="{Binding Scope}" SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                  ToolTip.Tip="{sd:LocalizeString Show the messages of all assets or only of the selected ones (and the assets they use), Context=ToolTip}">
          <ComboBoxItem Content="{sd:LocalizeString All assets}" Tag="{x:Static caevml:AssetLogScope.AllAssets}"/>
          <ComboBoxItem Content="{sd:LocalizeString Selected assets}" Tag="{x:Static caevml:AssetLogScope.SelectedAssets}"/>
        </ComboBox>
        <Menu Name="AssetLogSources" VerticalAlignment="Center" Background="Transparent">
          <MenuItem Header="{Binding SourcesHeader}">
            <MenuItem Header="{sd:LocalizeString Show all sources, Context=Menu}" Command="{Binding ShowAllSourcesCommand}"/>
            <Separator/>
            <MenuItem Header="{Binding Sources[0].DisplayName}" ToggleType="CheckBox" IsChecked="{Binding Sources[0].IsShown, Mode=TwoWay}" StaysOpenOnClick="True"/>
            <MenuItem Header="{Binding Sources[1].DisplayName}" ToggleType="CheckBox" IsChecked="{Binding Sources[1].IsShown, Mode=TwoWay}" StaysOpenOnClick="True"/>
            <MenuItem Header="{Binding Sources[2].DisplayName}" ToggleType="CheckBox" IsChecked="{Binding Sources[2].IsShown, Mode=TwoWay}" StaysOpenOnClick="True"/>
            <MenuItem Header="{Binding Sources[3].DisplayName}" ToggleType="CheckBox" IsChecked="{Binding Sources[3].IsShown, Mode=TwoWay}" StaysOpenOnClick="True"/>
            <MenuItem Header="{Binding Sources[4].DisplayName}" ToggleType="CheckBox" IsChecked="{Binding Sources[4].IsShown, Mode=TwoWay}" StaysOpenOnClick="True"/>
          </MenuItem>
        </Menu>
      </StackPanel>
    </caectl:GridLogViewer.ToolBarContent>
  </caectl:GridLogViewer>
</UserControl>
