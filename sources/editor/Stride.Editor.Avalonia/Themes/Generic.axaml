<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Stride.Editor.Avalonia.Preview.Views">
  <!-- The default themes of the controls of this assembly. The application includes this dictionary in its resources. -->
  <ControlTheme x:Key="{x:Type views:StridePreviewView}" TargetType="views:StridePreviewView">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:StridePreviewView">
        <ContentPresenter x:Name="PART_StrideView" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
