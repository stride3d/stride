!Package
SerializedVersion: {Assets: 3.1.0.0}
TemplateFolders:
    - Path: !dir ../../data/StridePackage/Templates/Core
      Group: Core
      Exclude: "**/*.psd;**/*.md"
    - Path: !dir Templates/Assets
      Group: Assets
      Files:
        - !file Templates/Assets/Animations/DefaultAnimation.sdtpl
        - !file Templates/Assets/Animations/DefaultSkeleton.sdtpl
        - !file Templates/Assets/Fonts/OfflineRasterizedSpriteFont.sdtpl
        - !file Templates/Assets/Fonts/RuntimeRasterizedSpriteFont.sdtpl
        - !file Templates/Assets/Fonts/SignedDistanceFieldSpriteFont.sdtpl
        - !file Templates/Assets/Materials/DefaultMaterial.sdtpl
        - !file Templates/Assets/Materials/DiffuseMaterial.sdtpl
        - !file Templates/Assets/Materials/PBRMetalnessMaterial.sdtpl
        - !file Templates/Assets/Materials/PBRSpecularMaterial.sdtpl
        - !file Templates/Assets/Materials/PBRClearCoatMaterial.sdtpl
        - !file Templates/Assets/Materials/PBRGlassMaterial.sdtpl
        - !file Templates/Assets/Misc/DefaultGameSettings.sdtpl
        - !file Templates/Assets/Misc/DefaultGraphicsCompositorLevel10.sdtpl
        - !file Templates/Assets/Misc/DefaultGraphicsCompositorLevel9.sdtpl
        - !file Templates/Assets/Misc/DefaultRawAsset.sdtpl
        - !file Templates/Assets/Misc/DefaultSkybox.sdtpl
        - !file Templates/Assets/Models/DefaultModel.sdtpl
        - !file Templates/Assets/Models/PrefabModel.sdtpl
        - !file Templates/Assets/Models/ProceduralCapsule.sdtpl
        - !file Templates/Assets/Models/ProceduralCone.sdtpl
        - !file Templates/Assets/Models/ProceduralCube.sdtpl
        - !file Templates/Assets/Models/ProceduralCylinder.sdtpl
        - !file Templates/Assets/Models/ProceduralGeoSphere.sdtpl
        - !file Templates/Assets/Models/ProceduralPlane.sdtpl
        - !file Templates/Assets/Models/ProceduralSphere.sdtpl
        - !file Templates/Assets/Models/ProceduralTeapot.sdtpl
        - !file Templates/Assets/Models/ProceduralTorus.sdtpl
        - !file Templates/Assets/Scenes/DefaultPrefab.sdtpl
        - !file Templates/Assets/Scenes/DefaultScene.sdtpl
        - !file Templates/Assets/Scripts/Animation/AnimationBlend.sdtpl
        - !file Templates/Assets/Scripts/Animation/AnimationStart.sdtpl
        - !file Templates/Assets/Scripts/Camera/BasicCameraController.sdtpl
        - !file Templates/Assets/Scripts/Camera/SideScrollingCamera.sdtpl
        - !file Templates/Assets/Scripts/Camera/FpsCamera.sdtpl
        - !file Templates/Assets/Scripts/DefaultAsyncScript.sdtpl
        - !file Templates/Assets/Scripts/DefaultSyncScript.sdtpl
        - !file Templates/Assets/Scripts/DefaultStartupScript.sdtpl
        - !file Templates/Assets/Scripts/Events/EventBroadcaster.sdtpl
        - !file Templates/Assets/Scripts/Events/EventListener.sdtpl
        - !file Templates/Assets/Scripts/Prefabs/PrefabInstance.sdtpl
        - !file Templates/Assets/Scripts/Utility/GameProfiler.sdtpl
        - !file Templates/Assets/Sprites/SpriteSheetSprites.sdtpl
        - !file Templates/Assets/Sprites/SpriteSheetUI.sdtpl
        - !file Templates/Assets/Textures/ColorTexture.sdtpl
        - !file Templates/Assets/Textures/NormalMapTexture.sdtpl
        - !file Templates/Assets/Textures/GrayscaleTexture.sdtpl
