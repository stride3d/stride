<Window
    x:Class="Stride.GameStudio.View.GameStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cmd="clr-namespace:Stride.Core.Presentation.Commands;assembly=Stride.Core.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gh="clr-namespace:Stride.GameStudio.Helpers"
    xmlns:gl="clr-namespace:Stride.GameStudio.Layout.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
    xmlns:strings="clr-namespace:Stride.GameStudio.Resources.Strings"
    xmlns:stringsEd="clr-namespace:Stride.Core.Assets.Editor.Resources.Strings;assembly=Stride.Core.Assets.Editor"
    xmlns:viewModels="clr-namespace:Stride.Core.Presentation.Quantum.ViewModels;assembly=Stride.Core.Presentation.Quantum"
    xmlns:viewModels1="clr-namespace:Stride.Core.Assets.Editor.Components.TemplateDescriptions.ViewModels;assembly=Stride.Core.Assets.Editor"
    xmlns:vm="clr-namespace:Stride.GameStudio.ViewModels"
    xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
    x:Name="EditorWindow"
    Title="{Binding EditorTitle, RelativeSource={RelativeSource Self}}"
    Width="1280"
    Height="900"
    d:DataContext="{d:DesignInstance vm:GameStudioViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    PreviewMouseDown="EditorWindowPreviewMouseDown"
    Style="{DynamicResource WindowChromeStyle}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme.AvalonDock.xaml" />
                <ResourceDictionary Source="/Stride.Core.Assets.Editor;component/View/CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="AvalonDock_GameStudio_TitleTemplate">
                <DockPanel LastChildFill="False">
                    <DockPanel.Resources>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LayoutItem.IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type xcad:LayoutDocumentTabItem}}, Mode=OneWay}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>
                    <TextBlock
                        Margin="3,0"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Left"
                        Text="*"
                        TextAlignment="Center"
                        Visibility="{Binding Path=Content.DataContext.Asset.IsDirty, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}" />
                </DockPanel>
            </DataTemplate>

            <!--  TODO: Migrate ImageDictionary from Editor to here  -->
            <DrawingImage x:Key="ImageReloadProject">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                            <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M0,15L16,15 16,1 0,1z" />
                            <GeometryDrawing Brush="#FF424242" Geometry="F1M14,13L2,13 2,5 14,5z M1,14L15,14 15,2 1,2z" />
                            <GeometryDrawing Brush="#FFEFEFF0" Geometry="F1M14,13L2,13 2,5 14,5z" />
                        </DrawingGroup>
                        <DrawingGroup>
                            <DrawingGroup.Transform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.3" ScaleY="0.3" />
                                    <SkewTransform />
                                    <RotateTransform />
                                    <TranslateTransform X="11" Y="10" />
                                </TransformGroup>
                            </DrawingGroup.Transform>
                            <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                            <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M16,8C16,12.411 12.411,16 8,16 3.589,16 0,12.411 0,8 0,6.597 0.384,5.212 1.088,4L0,4 0,0 8,0 8,8 4,8C4,10.206 5.794,12 8,12 10.206,12 12,10.206 12,8 12,6.656 11.331,5.41 10.21,4.666L9.377,4.112 11.592,0.78 12.425,1.333C14.663,2.822,16,5.314,16,8" />
                            <GeometryDrawing Brush="#FF00529C" Geometry="F1M15,8C15,11.859 11.859,15 8,15 4.14,15 1,11.859 1,8 1,6.076 1.801,4.292 3.121,3L1,3 1,1 7,1 7,7 5,7 5,4.002C3.766,4.931 3,6.401 3,8 3,10.757 5.243,13 8,13 10.757,13 13,10.757 13,8 13,6.321 12.164,4.763 10.764,3.833L11.871,2.167C13.83,3.469,15,5.649,15,8" />
                        </DrawingGroup>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <ContextMenu x:Key="AssetContextMenu" d:DataContext="{d:DesignInstance sd:AssetCollectionViewModel}">
                <!--  Asset  -->
                <MenuItem Header="{sd:Localize Asset, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.EditSelectedContentCommand}"
                    Header="{sd:Localize Edit asset...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageEditAsset}}"
                    InputGestureText="{x:Static strings:KeyGestures.EditAsset}" />
                <MenuItem
                    Command="{Binding Session.ToggleIsRootOnSelectedAssetCommand}"
                    Header="{Binding Session.SelectionIsRoot, Converter={sd:BoolToParam}, ConverterParameter={sd:Localize Don\'t include in build as root asset, Context=Menu}, FallbackValue={sd:Localize Include in build as root asset, Context=Menu}}"
                    Icon="{sd:Image {StaticResource ImageAssetIsRoot}}" />
                <Separator Visibility="{Binding Session.ActiveAssetView.SingleSelectedAsset.AssetCommands.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:VisibleOrCollapsed}}, FallbackValue={sd:Collapsed}}" />
                <!--  IsCheckable=True is a hack to prevent WPF from clearing the selected sub menu item  -->
                <MenuItem
                    IsCheckable="True"
                    ItemsSource="{Binding Session.ActiveAssetView.SingleSelectedAsset.AssetCommands}"
                    Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}">
                    <MenuItem.ItemContainerStyle>
                        <Style
                            d:DataContext="{d:DesignInstance sd:MenuCommandInfo}"
                            BasedOn="{StaticResource {x:Type MenuItem}}"
                            TargetType="{x:Type MenuItem}">
                            <Setter Property="Command" Value="{Binding Command}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Icon" Value="{Binding Icon}" />
                            <Setter Property="IsEnabled" Value="{Binding Command.IsEnabled, Mode=OneWay}" />
                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                            <Setter Property="InputGestureText" Value="{Binding Gesture}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel IsItemsHost="True" />
                        </ControlTemplate>
                    </MenuItem.Template>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="ApplicationCommands.Cut"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="{sd:Localize Cut,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCut}}" />
                <MenuItem
                    Command="ApplicationCommands.Copy"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="{sd:Localize Copy,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCopy}}" />
                <MenuItem
                    Command="{Binding CopyAssetsRecursivelyCommand}"
                    Header="{sd:Localize Copy with dependencies,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCopyRecursively}}"
                    InputGestureText="{x:Static strings:KeyGestures.CopyAssetRecursively}" />
                <MenuItem
                    Command="ApplicationCommands.Paste"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="{sd:Localize Paste,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImagePaste}}" />
                <MenuItem
                    Command="ApplicationCommands.Delete"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="{sd:Localize Delete,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageDelete}}" />
                <Separator />
                <MenuItem Command="{Binding CopyAssetUrlCommand}" Header="{sd:Localize Copy asset URL, Context=Menu}" />
                <MenuItem
                    Command="sd:AssetViewUserControl.BeginEditCommand"
                    Header="{sd:Localize Rename,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageRename}}"
                    InputGestureText="F2" />
                <Separator />
                <MenuItem
                    Command="{Binding Session.NewDirectoryCommand}"
                    CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                    Header="{sd:Localize Create folder,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageNewFolder}}"
                    Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                <MenuItem
                    Command="{Binding Session.ActiveAssetView.ShowAddAssetDialogCommand}"
                    Header="{sd:Localize Add asset...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageNewAsset}}"
                    InputGestureText="{x:Static strings:KeyGestures.AddAsset}"
                    Visibility="{Binding Session.ActiveAssetView.ShowAddAssetDialogCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                <MenuItem
                    Command="{Binding Session.SourceTracker.UpdateSelectedAssetsFromSourceCommand}"
                    Header="{sd:Localize Update selected assets from their source,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource UpdateSelectedAssetsFromSource}}"
                    InputGestureText="{x:Static stringsEd:KeyGestures.UpdateSelectedAssetsFromSource}" />
                <MenuItem
                    Command="{Binding Session.SourceTracker.UpdateAllAssetsWithModifiedSourceCommand}"
                    Header="{sd:Localize Update all assets with modified source,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource UpdateAllAssetsWithModifiedSource}}"
                    InputGestureText="{x:Static stringsEd:KeyGestures.UpdateAllAssetsWithModifiedSource}" />
                <!--  Explore  -->
                <MenuItem Header="{sd:Localize Explore, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.OpenWithTextEditorCommand}"
                    CommandParameter="{Binding SingleSelectedAsset}"
                    Header="{sd:Localize Open with text editor,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageOpenWithTextEditor}}" />
                <MenuItem
                    Command="{Binding Session.OpenAssetFileCommand}"
                    CommandParameter="{Binding SingleSelectedAsset}"
                    Header="{sd:Localize Open asset file,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageOpenAssetFile}}" />
                <MenuItem
                    Command="{Binding Session.OpenSourceFileCommand}"
                    CommandParameter="{Binding SingleSelectedAsset}"
                    Header="{sd:Localize Open source file,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageOpenSourceFile}}" />
                <MenuItem
                    Command="{Binding Session.ExploreCommand}"
                    CommandParameter="{Binding SelectedContent}"
                    Header="{sd:Localize Show in Explorer,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageExplore}}" />
                <MenuItem
                    Command="{Binding Session.ExploreSourceFileCommand}"
                    CommandParameter="{Binding SingleSelectedAsset}"
                    Header="{sd:Localize Show source file in Explorer,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageExplore}}" />
            </ContextMenu>

        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{Binding Session.ActiveAssetView.CopyAssetsRecursivelyCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.CopyAssetRecursively}}" />
        <KeyBinding Command="{Binding Session.EditSelectedContentCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.EditAsset}}" />
        <KeyBinding Command="{Binding Session.ActiveAssetView.ShowAddAssetDialogCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.AddAsset}}" />
        <KeyBinding Command="{Binding Session.SourceTracker.UpdateSelectedAssetsFromSourceCommand}" Gesture="{sd:KeyGesture {x:Static stringsEd:KeyGestures.UpdateSelectedAssetsFromSource}}" />
        <KeyBinding Command="{Binding Session.SourceTracker.UpdateAllAssetsWithModifiedSourceCommand}" Gesture="{sd:KeyGesture {x:Static stringsEd:KeyGestures.UpdateAllAssetsWithModifiedSource}}" />
        <KeyBinding Command="{Binding Debugging.BuildProjectCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.BuildProject}}" />
        <KeyBinding Command="{Binding Debugging.StartProjectCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.StartProject}}" />
        <KeyBinding Command="{Binding Debugging.CancelBuildCommand}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.CancelBuild}}" />
        <KeyBinding Command="{Binding OpenDebugWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" Gesture="{sd:KeyGesture {x:Static strings:KeyGestures.OpenDebugWindow}}" />
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <sd:CommandBindingBehavior Command="{Binding NewSessionCommand}" RoutedCommand="ApplicationCommands.New" />
        <sd:CommandBindingBehavior Command="{Binding OpenSessionCommand}" RoutedCommand="ApplicationCommands.Open" />
        <sd:CommandBindingBehavior Command="{Binding Session.SaveSessionCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Save" />
        <sd:CommandBindingBehavior Command="{Binding Session.ActionHistory.UndoCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Undo" />
        <sd:CommandBindingBehavior Command="{Binding Session.ActionHistory.RedoCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Redo" />
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <!--  MENU ROW DEFINITION  -->
            <RowDefinition Height="Auto" />
            <!--  DOCUMENT ROW DEFINITION  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  MENU ROW  -->
        <Menu
            Grid.Row="0"
            FontSize="12"
            IsHitTestVisible="True">
            <!--  File Menu  -->
            <MenuItem Header="{sd:Localize File, Context=Menu}">
                <MenuItem
                    Command="ApplicationCommands.New"
                    Header="{sd:Localize New,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageNewSolution}}" />
                <MenuItem
                    Command="ApplicationCommands.Open"
                    Header="{sd:Localize Open,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageOpen}}" />
                <MenuItem
                    Header="{sd:Localize Open recent,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageOpen}}"
                    IsEnabled="{Binding MRU.MostRecentlyUsedFiles.Count, Converter={sd:NumericToBool}}">
                    <!--  IsCheckable=True is a hack to prevent WPF from clearing the selected sub menu item  -->
                    <MenuItem IsCheckable="True" ItemsSource="{Binding RecentFiles}">
                        <MenuItem.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" ToolTip="{Binding FilePath, Converter={sd:UFileToString}, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition MaxWidth="320" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontWeight="Bold"
                                        Text="{Binding Version}" />
                                    <TextBlock Grid.Column="1" Text="{sd:MultiBinding {Binding FilePath, Converter={sd:UFileToString}, Mode=OneWay}, {Binding RelativeSource={RelativeSource Self}}, Converter={sd:TrimString MaxWidth=320, TextTrimming=WordEllipsis, TrimmingSource=Middle, WordSeparators=/\\}}" />
                                </Grid>
                            </DataTemplate>
                        </MenuItem.ItemTemplate>
                        <MenuItem.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                <Setter Property="Command" Value="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                        <MenuItem.Template>
                            <ControlTemplate>
                                <StackPanel IsItemsHost="True" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Command="{Binding ClearMRUCommand}"
                        Header="{sd:Localize Clear list,
                                             Context=Menu}"
                        Icon="{sd:Image {StaticResource ImageDelete}}" />
                </MenuItem>
                <MenuItem
                    Command="ApplicationCommands.Save"
                    Header="{sd:Localize Save,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageSave}}" />
                <Separator />
                <MenuItem
                    Command="{Binding ReloadSessionCommand}"
                    Header="{sd:Localize Reload project,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageReloadProject}}" />
                <Separator />
                <MenuItem Header="{sd:Localize Quit, Context=Menu}">
                    <i:Interaction.Behaviors>
                        <sd:MenuItemCloseWindowBehavior />
                    </i:Interaction.Behaviors>
                </MenuItem>
            </MenuItem>
            <!--  Edit Menu  -->
            <MenuItem Header="{sd:Localize Edit, Context=Menu}">
                <MenuItem
                    Command="ApplicationCommands.Undo"
                    Header="{sd:Localize Undo,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageUndo}}" />
                <MenuItem
                    Command="ApplicationCommands.Redo"
                    Header="{sd:Localize Redo,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageRedo}}" />
                <Separator />
                <MenuItem
                    Command="ApplicationCommands.Cut"
                    Header="{sd:Localize Cut,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCut}}" />
                <MenuItem
                    Command="ApplicationCommands.Copy"
                    Header="{sd:Localize Copy,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCopy}}" />
                <MenuItem
                    Command="ApplicationCommands.Paste"
                    Header="{sd:Localize Paste,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImagePaste}}" />
                <MenuItem
                    Command="ApplicationCommands.Delete"
                    Header="{sd:Localize Delete,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageDelete}}" />
                <Separator />
                <MenuItem
                    Command="{Binding OpenSettingsWindowCommand}"
                    Header="{sd:Localize Settings,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageSettings}}" />
            </MenuItem>
            <!--  Project Menu  -->
            <MenuItem Header="{sd:Localize Project, Context=Menu}" IsEnabled="{Binding Session, Converter={sd:ObjectToBool}}">
                <MenuItem
                    Command="{Binding Debugging.BuildProjectCommand}"
                    Header="{sd:Localize Build project,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageBuildProject}}"
                    InputGestureText="{x:Static strings:KeyGestures.BuildProject}" />
                <MenuItem
                    Command="{Binding Debugging.StartProjectCommand}"
                    Header="{sd:Localize Start project,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageStartProject}}"
                    InputGestureText="{x:Static strings:KeyGestures.StartProject}" />
                <!--  Disable live-scripting commands until it is working  -->
                <MenuItem
                    Command="{Binding Debugging.LivePlayProjectCommand}"
                    Header="{sd:Localize Start live-scripting,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageLiveScripting}}"
                    Visibility="Collapsed" />
                <MenuItem
                    Command="{Binding Debugging.CancelBuildCommand}"
                    Header="{sd:Localize Cancel build,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageStopBuild}}"
                    InputGestureText="{x:Static strings:KeyGestures.CancelBuild}" />
                <MenuItem Header="{sd:Localize Folder, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.NewDirectoryCommand}"
                    CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                    Header="{sd:Localize Create folder,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageNewFolder}}" />

                <MenuItem Header="{sd:Localize Package, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Header="{sd:Localize Update package,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageAddNewProject}}"
                    ItemsSource="{Binding Session.UpdatePackageViewModel.Templates}"
                    Visibility="{Binding Session.IsUpdatePackageEnabled, Converter={sd:VisibleOrCollapsed}}">
                    <MenuItem.ItemContainerStyle>
                        <Style
                            d:DataContext="{d:DesignInstance viewModels1:TemplateDescriptionViewModel}"
                            BasedOn="{StaticResource {x:Type MenuItem}}"
                            TargetType="{x:Type MenuItem}">
                            <Setter Property="Command" Value="{Binding UpdatePackageCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.ItemTemplate>
                        <DataTemplate DataType="viewModels1:TemplateDescriptionViewModel">
                            <DockPanel Width="384">
                                <Image
                                    Width="48"
                                    Height="48"
                                    Margin="2"
                                    DockPanel.Dock="Left"
                                    Source="{Binding Icon}" />
                                <DockPanel Margin="18,0">
                                    <TextBlock
                                        DockPanel.Dock="Top"
                                        FontSize="16"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Text="{Binding Description}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="Wrap" />
                                </DockPanel>
                            </DockPanel>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem
                    Command="{Binding Session.AddDependencyCommand}"
                    Header="{sd:Localize Add dependency...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageAddDependency}}" />
                <MenuItem
                    Command="{Binding Session.SetCurrentProjectCommand}"
                    CommandParameter="{Binding}"
                    Header="{sd:Localize Set as current project,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageStartupProject}}" />
                <MenuItem
                    Command="{Binding Session.ActivatePackagePropertiesCommand}"
                    Header="{sd:Localize Package properties,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImagePackageProperties}}" />

                <MenuItem Header="{sd:Localize Solution, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.NewProjectCommand}"
                    Header="{sd:Localize New project...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageAddNewPackage}}" />
                <MenuItem
                    Command="{Binding Session.AddExistingProjectCommand}"
                    Header="{sd:Localize Add existing project...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageAddExistingProject}}" />
                <MenuItem
                    Command="{Binding Session.OpenInIDECommand}"
                    Header="{sd:Localize Open in IDE,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageCodeEditor}}" />
                <MenuItem
                    Command="{Binding Debugging.ReloadAssembliesCommand}"
                    Header="{sd:Localize Reload game assemblies,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageReloadAssemblies}}" />

                <MenuItem Header="{sd:Localize Actions, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.DeleteSelectedSolutionItemsCommand}"
                    Header="{sd:Localize Delete,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageDelete}}" />
                <MenuItem
                    Command="{Binding Session.RenameDirectoryOrPackageCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}}"
                    CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                    Header="{sd:Localize Rename,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageRename}}"
                    InputGestureText="F2" />

                <MenuItem Header="{sd:Localize Asset, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                <MenuItem
                    Command="{Binding Session.ActiveAssetView.ShowAddAssetDialogCommand}"
                    Header="{sd:Localize Add asset...,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageNewAsset}}"
                    InputGestureText="{x:Static strings:KeyGestures.AddAsset}" />
                <MenuItem
                    Command="{Binding Session.SourceTracker.UpdateSelectedAssetsFromSourceCommand}"
                    Header="{sd:Localize Update selected assets from their source,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource UpdateSelectedAssetsFromSource}}"
                    InputGestureText="{x:Static stringsEd:KeyGestures.UpdateSelectedAssetsFromSource}" />
                <MenuItem
                    Command="{Binding Session.SourceTracker.UpdateAllAssetsWithModifiedSourceCommand}"
                    Header="{sd:Localize Update all assets with modified source,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource UpdateAllAssetsWithModifiedSource}}"
                    InputGestureText="{x:Static stringsEd:KeyGestures.UpdateAllAssetsWithModifiedSource}"
                    Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                <MenuItem
                    Header="{sd:Localize Explore,
                                         Context=Menu}"
                    Style="{StaticResource MenuGroupSeparatorStyle}"
                    Visibility="{Binding Session.ExploreCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                <MenuItem
                    Command="{Binding Session.ExploreCommand}"
                    CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                    Header="{sd:Localize Show in Explorer,
                                         Context=Menu}"
                    Icon="{sd:Image {StaticResource ImageExplore}}"
                    Visibility="{Binding Session.ExploreCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
            </MenuItem>
            <!--  View Menu  -->
            <MenuItem Header="{sd:Localize View, Context=Menu}" IsEnabled="{Binding Session, Converter={sd:ObjectToBool}}">
                <MenuItem
                    Header="{sd:Localize Solution explorer,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.SessionExplorerPanelVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{sd:Localize Asset view,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.AssetViewPanelVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{sd:Localize References,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.ReferencesPanelVisible, Mode=TwoWay}" />
                <Separator />
                <MenuItem
                    Header="{sd:Localize Asset preview,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.AssetPreviewPanelVisible, Mode=TwoWay}" />

                <Separator />
                <MenuItem
                    Header="{sd:Localize Git changes,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.GitChangesPanelVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{sd:Localize Edit history,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.ActionHistoryPanelVisible, Mode=TwoWay}" />
                <Separator />
                <MenuItem
                    Header="{sd:Localize Property grid,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.PropertyGridPanelVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{sd:Localize Asset errors,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.AssetLogPanelVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{sd:Localize Output,
                                         Context=Menu}"
                    IsCheckable="True"
                    IsChecked="{Binding Panels.BuildLogPanelVisible, Mode=TwoWay}" />

            </MenuItem>
            <!--  Help Menu  -->
            <MenuItem Header="{sd:Localize Help, Context=Menu}">
                <MenuItem
                    Command="{Binding OpenWebPageCommand}"
                    CommandParameter="{x:Static gh:StrideGameStudio.DocumentationUrl}"
                    Header="{sd:Localize Online documentation,
                                         Context=Menu}" />
                <Separator />
                <MenuItem
                    Command="{Binding OpenWebPageCommand}"
                    CommandParameter="{x:Static gh:StrideGameStudio.AnswersUrl}"
                    Header="{sd:Localize Questions and answers,
                                         Context=Menu}" />
                <MenuItem
                    Command="{Binding OpenWebPageCommand}"
                    CommandParameter="{x:Static gh:StrideGameStudio.ReportIssueUrl}"
                    Header="{sd:Localize Report an issue...,
                                         Context=Menu}" />
                <MenuItem
                    Command="{Binding OpenWebPageCommand}"
                    CommandParameter="{x:Static gh:StrideGameStudio.ForumsUrl}"
                    Header="{sd:Localize Community forums,
                                         Context=Menu}" />
                <Separator />
                <MenuItem
                    Command="{Binding OpenDebugWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Header="{sd:Localize Show debug window,
                                         Context=Menu}"
                    InputGestureText="{x:Static strings:KeyGestures.OpenDebugWindow}" />
                <Separator />
                <MenuItem Command="{Binding OpenAboutPageCommand}" Header="{sd:Localize About..., Context=Menu}" />
            </MenuItem>
            <!--  Debug Menu  -->
            <MenuItem Header="Debug" Visibility="{Binding IsTestMenuVisible, ElementName=EditorWindow, Converter={sd:VisibleOrCollapsed}}">
                <MenuItem Command="{Binding CreateTestAssetCommand, RelativeSource={RelativeSource AncestorType=Window}}" Header="Create test asset" />
                <MenuItem Command="{Binding CreateUnitTestAssetCommand, RelativeSource={RelativeSource AncestorType=Window}}" Header="Create unit test asset" />
                <Separator />
                <MenuItem Command="{Binding BreakDebuggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Header="Break with debugger" />
            </MenuItem>
        </Menu>

        <!--  DOCUMENT ROW  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!--  TOOLBAR ROW DEFINITION  -->
                <RowDefinition Height="Auto" />
                <!--  DOCKING ROW DEFINITION  -->
                <RowDefinition Height="*" />
                <!--  STATUS BAR ROW DEFINITION  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  TOOLBAR ROW  -->
            <ToolBarTray Grid.Row="0" Visibility="{Binding Session, Converter={sd:Chained {sd:ObjectToBool}, {sd:VisibleOrCollapsed}}}">
                <ToolBar>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="ApplicationCommands.New"
                        ToolTip="{sd:Localize Create a project,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageNewSolution}" />
                    </Button>
                    <Button
                        Margin="2,0,0,0"
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="ApplicationCommands.Open"
                        ToolTip="{sd:Localize Open an existing project,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageOpen}" />
                    </Button>
                    <Menu
                        Margin="0"
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Background="Transparent"
                        ToolTip="{sd:Localize Open recent,
                                              Context=ToolTip}"
                        ToolTipService.IsEnabled="{Binding ElementName=MRUMenu, Path=IsSubmenuOpen, Converter={sd:InvertBool}}"
                        ToolTipService.ShowOnDisabled="True">
                        <MenuItem
                            x:Name="MRUMenu"
                            ItemsSource="{Binding RecentFiles}"
                            Style="{StaticResource ToolBarDropDownMenuItemStyle}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" ToolTip="{Binding FilePath, Converter={sd:UFileToString}, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition MaxWidth="320" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="Bold"
                                            Text="{Binding Version}" />
                                        <TextBlock Grid.Column="1" Text="{sd:MultiBinding {Binding FilePath, Converter={sd:UFileToString}, Mode=OneWay}, {Binding RelativeSource={RelativeSource Self}}, Converter={sd:TrimString MaxWidth=320, TextTrimming=WordEllipsis, TrimmingSource=Middle, WordSeparators=/\\}}" />
                                    </Grid>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                            <MenuItem.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                    <Setter Property="Command" Value="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="ApplicationCommands.Save"
                        ToolTip="{sd:Localize Save the project and all its documents,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageSave}" />
                    </Button>
                    <Separator />
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding ReloadSessionCommand}"
                        ToolTip="{sd:Localize Reload current project (ask to save),
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageReloadProject}" />
                    </Button>
                    <Separator />
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="ApplicationCommands.Undo"
                        ToolTip="{sd:Localize Undo last action,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageUndo}" />
                    </Button>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="ApplicationCommands.Redo"
                        ToolTip="{sd:Localize Redo last cancelled action,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageRedo}" />
                    </Button>
                </ToolBar>
                <ToolBar>
                    <Button
                        Margin="2,0,0,0"
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Session.OpenInIDECommand}"
                        ToolTip="{sd:Localize Open in IDE,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image
                            Width="16"
                            Height="16"
                            Source="{StaticResource ImageCodeEditor}" />
                    </Button>
                    <Menu
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Background="Transparent"
                        ToolTip="{sd:Localize Open with...,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <MenuItem ItemsSource="{Binding AvailableIDEs}" Style="{StaticResource ToolBarDropDownMenuItemStyle}">
                            <MenuItem.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                    <Setter Property="Command" Value="{Binding DataContext.Session.OpenInIDECommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Debugging.ReloadAssembliesCommand}"
                        ToolTip="{sd:Localize Reload game assemblies and update scripts,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <Grid>
                            <Image Source="{StaticResource ImageReloadAssemblies}" />
                            <Rectangle Fill="White" Visibility="{Binding Debugging.ReloadAssembliesCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource ImageReloadAssemblies}" />
                                </Rectangle.OpacityMask>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Window.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    BeginTime="0:0:0"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0"
                                                    To="1"
                                                    Duration="0:0:0.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                    </Button>
                    <Separator />
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Debugging.BuildProjectCommand}"
                        ToolTip="{sd:ToolTip {sd:Localize Build the project,
                                                          Context=ToolTip},
                                             {x:Static strings:KeyGestures.BuildProject}}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageBuildProject}" />
                    </Button>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Debugging.StartProjectCommand}"
                        ToolTip="{sd:ToolTip {sd:Localize Build the project and start the game,
                                                          Context=ToolTip},
                                             {x:Static strings:KeyGestures.StartProject}}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageStartProject}" />
                    </Button>
                    <!--  Live Scripting  -->
                    <!--  FIXME live scripting is disabled (XK-4309)  -->
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Debugging.LivePlayProjectCommand}"
                        ToolTip="{sd:Localize Start project in live-scripting mode,
                                              Context=ToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        Visibility="Collapsed">
                        <Image Source="{StaticResource ImageLiveScripting}" />
                    </Button>
                    <Button
                        sd:ToolTipHelper.Status="{Binding Status}"
                        Command="{Binding Debugging.CancelBuildCommand}"
                        ToolTip="{sd:ToolTip {sd:Localize Cancel the current build,
                                                          Context=ToolTip},
                                             {x:Static strings:KeyGestures.CancelBuild}}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image Source="{StaticResource ImageStopBuild}" />
                    </Button>
                </ToolBar>
            </ToolBarTray>

            <!--  DOCKING ROW  -->
            <xcad:DockingManager
                x:Name="Docking"
                Grid.Row="1"
                AllowMixedOrientation="True"
                AnchorableTitleTemplate="{StaticResource AvalonDock_GameStudio_TitleTemplate}"
                DocumentHeaderTemplate="{StaticResource AvalonDock_GameStudio_TitleTemplate}"
                DocumentTitleTemplate="{StaticResource AvalonDock_GameStudio_TitleTemplate}"
                Visibility="{Binding Session, Converter={sd:Chained {sd:ObjectToBool}, {sd:VisibleOrCollapsed}}}">
                <xcad:LayoutRoot>
                    <xcad:LayoutPanel Orientation="Horizontal">
                        <xcad:LayoutPanel Orientation="Vertical">
                            <xcad:LayoutPanel Orientation="Horizontal">
                                <xcad:LayoutAnchorablePane DockWidth="300">
                                    <!--  SOLUTION EXPLORER  -->
                                    <xcad:LayoutAnchorable
                                        Title="{Binding Source={sd:Localize Solution explorer, Context=View}}"
                                        gh:AvalonDockHelper.IsVisible="{Binding Panels.SessionExplorerPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                        AutoHideMinWidth="300"
                                        ContentId="SolutionExplorer">
                                        <DockPanel>
                                            <ToolBarTray DockPanel.Dock="Top">
                                                <ToolBar>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.NewProjectCommand}"
                                                        ToolTip="{sd:Localize Create a project...,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageAddNewPackage}" />
                                                    </Button>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.NewDirectoryCommand}"
                                                        CommandParameter="{Binding SelectedItems, ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Create a folder,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageNewFolder}" />
                                                    </Button>
                                                    <Separator />
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.ActivatePackagePropertiesCommand}"
                                                        ToolTip="{sd:Localize Display the properties of the selected package in the property grid,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImagePackageProperties}" />
                                                    </Button>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.RenameDirectoryOrPackageCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}}"
                                                        CommandParameter="{Binding SelectedItems, ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Rename the selected folder or package,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageRename}" />
                                                    </Button>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.DeleteSelectedSolutionItemsCommand}"
                                                        ToolTip="{sd:Localize Delete the selected items,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageDelete}" />
                                                    </Button>
                                                    <Separator />
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{x:Static sd:SessionExplorerHelper.ExpandAssetFolders}"
                                                        CommandTarget="{Binding ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Expand all asset folders,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageExpandAssetFolders}" />
                                                    </Button>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{x:Static sd:SessionExplorerHelper.ExpandAllFolders}"
                                                        CommandTarget="{Binding ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Expand all,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageExpandAllFolders}" />
                                                    </Button>
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{x:Static sd:SessionExplorerHelper.CollapseAllFolders}"
                                                        CommandTarget="{Binding ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Collapse all,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageCollapseAllFolders}" />
                                                    </Button>
                                                    <Separator />
                                                    <Button
                                                        sd:ToolTipHelper.Status="{Binding Status}"
                                                        Command="{Binding Session.ExploreCommand}"
                                                        CommandParameter="{Binding SelectedItems, ElementName=DirectoryTreeView}"
                                                        ToolTip="{sd:Localize Show in Explorer,
                                                                              Context=ToolTip}"
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <Image Source="{StaticResource ImageExplore}" />
                                                    </Button>
                                                </ToolBar>
                                            </ToolBarTray>
                                            <!--  TODO: SearchText  -->
                                            <sd:TreeView
                                                x:Name="DirectoryTreeView"
                                                AllowDrop="True"
                                                IsVirtualizing="False"
                                                ItemsSource="{Binding Session.PackageCategories.Values}">
                                                <sd:TreeView.Resources>
                                                    <ContextMenu x:Key="ContextMenu">
                                                        <MenuItem
                                                            Header="{sd:Localize Folder,
                                                                                 Context=Menu}"
                                                            Style="{StaticResource MenuGroupSeparatorStyle}"
                                                            Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.NewDirectoryCommand}"
                                                            CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                                                            Header="{sd:Localize Create folder,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageNewFolder}}"
                                                            Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                        <MenuItem
                                                            Header="{sd:Localize Package,
                                                                                 Context=Menu}"
                                                            Style="{StaticResource MenuGroupSeparatorStyle}"
                                                            Visibility="{sd:MultiBinding {Binding Session.IsUpdatePackageEnabled},
                                                                                         {Binding Session.AddExistingProjectCommand.IsEnabled},
                                                                                         {Binding Session.AddDependencyCommand.IsEnabled},
                                                                                         {Binding Session.SetCurrentProjectCommand.IsEnabled},
                                                                                         Converter={sd:MultiChained {sd:OrMultiConverter},
                                                                                                                    {sd:VisibleOrCollapsed}}}" />
                                                        <MenuItem
                                                            Header="{sd:Localize Update package,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageAddNewProject}}"
                                                            ItemsSource="{Binding Session.UpdatePackageViewModel.Templates}"
                                                            Visibility="{Binding Session.IsUpdatePackageEnabled, Converter={sd:VisibleOrCollapsed}}">
                                                            <MenuItem.ItemContainerStyle>
                                                                <Style
                                                                    d:DataContext="{d:DesignInstance viewModels1:TemplateDescriptionViewModel}"
                                                                    BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                    TargetType="{x:Type MenuItem}">
                                                                    <Setter Property="Command" Value="{Binding UpdatePackageCommand}" />
                                                                </Style>
                                                            </MenuItem.ItemContainerStyle>
                                                            <MenuItem.ItemTemplate>
                                                                <DataTemplate DataType="viewModels1:TemplateDescriptionViewModel">
                                                                    <DockPanel Width="384">
                                                                        <Image
                                                                            Width="48"
                                                                            Height="48"
                                                                            Margin="2"
                                                                            DockPanel.Dock="Left"
                                                                            Source="{Binding Icon}" />
                                                                        <DockPanel Margin="18,0">
                                                                            <TextBlock
                                                                                DockPanel.Dock="Top"
                                                                                FontSize="16"
                                                                                Text="{Binding Name}" />
                                                                            <TextBlock
                                                                                Text="{Binding Description}"
                                                                                TextTrimming="WordEllipsis"
                                                                                TextWrapping="Wrap" />
                                                                        </DockPanel>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </MenuItem.ItemTemplate>
                                                        </MenuItem>
                                                        <MenuItem
                                                            Command="{Binding Session.AddDependencyCommand}"
                                                            Header="{sd:Localize Add dependency...,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageAddDependency}}"
                                                            Visibility="{Binding Session.AddDependencyCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.SetCurrentProjectCommand}"
                                                            CommandParameter="{Binding}"
                                                            Header="{sd:Localize Set as current project,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageStartupProject}}"
                                                            Visibility="{Binding Session.SetCurrentProjectCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.ActivatePackagePropertiesCommand}"
                                                            Header="{sd:Localize Package properties,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImagePackageProperties}}"
                                                            Visibility="{Binding Session.ActivatePackagePropertiesCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                        <MenuItem
                                                            Header="{sd:Localize Solution,
                                                                                 Context=Menu}"
                                                            Style="{StaticResource MenuGroupSeparatorStyle}"
                                                            Visibility="{sd:MultiBinding {Binding Session.NewPackageCommand.IsEnabled},
                                                                                         {Binding Session.AddExistingPackageCommand.IsEnabled},
                                                                                         {Binding Session.OpenInIDECommand.IsEnabled},
                                                                                         Converter={sd:MultiChained {sd:OrMultiConverter},
                                                                                                                    {sd:VisibleOrCollapsed}}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.NewProjectCommand}"
                                                            Header="{sd:Localize New project...,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageAddNewPackage}}"
                                                            Visibility="{Binding Session.NewProjectCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.AddExistingProjectCommand}"
                                                            Header="{sd:Localize Add existing project...,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageAddExistingProject}}"
                                                            Visibility="{Binding Session.AddExistingProjectCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.OpenInIDECommand}"
                                                            Header="{sd:Localize Open in IDE,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageCodeEditor}}"
                                                            Visibility="{Binding Session.OpenInIDECommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                        <MenuItem Header="{sd:Localize Actions, Context=Menu}" Style="{StaticResource MenuGroupSeparatorStyle}" />
                                                        <MenuItem
                                                            Command="ApplicationCommands.Cut"
                                                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                            Header="{sd:Localize Cut,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageCut}}" />
                                                        <MenuItem
                                                            Command="ApplicationCommands.Copy"
                                                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                            Header="{sd:Localize Copy,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageCopy}}" />
                                                        <MenuItem
                                                            Command="ApplicationCommands.Paste"
                                                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                            Header="{sd:Localize Paste,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImagePaste}}" />
                                                        <MenuItem
                                                            Command="ApplicationCommands.Delete"
                                                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                            Header="{sd:Localize Delete,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageDelete}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.RenameDirectoryOrPackageCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}}"
                                                            CommandParameter="{Binding Session.ActiveAssetView.SelectedLocations}"
                                                            Header="{sd:Localize Rename,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageRename}}"
                                                            InputGestureText="F2"
                                                            Visibility="{Binding Session.RenameDirectoryOrPackageCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                        <MenuItem
                                                            Header="{sd:Localize Asset,
                                                                                 Context=Menu}"
                                                            Style="{StaticResource MenuGroupSeparatorStyle}"
                                                            Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.ActiveAssetView.ShowAddAssetDialogCommand}"
                                                            Header="{sd:Localize Add asset...,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageNewAsset}}"
                                                            InputGestureText="{x:Static strings:KeyGestures.AddAsset}"
                                                            Visibility="{Binding Session.NewDirectoryCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                        <MenuItem
                                                            Header="{sd:Localize Explore,
                                                                                 Context=Menu}"
                                                            Style="{StaticResource MenuGroupSeparatorStyle}"
                                                            Visibility="{Binding Session.ExploreCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />
                                                        <MenuItem
                                                            Command="{Binding Session.ExploreCommand}"
                                                            CommandParameter="{Binding}"
                                                            Header="{sd:Localize Show in Explorer,
                                                                                 Context=Menu}"
                                                            Icon="{sd:Image {StaticResource ImageExplore}}"
                                                            Visibility="{Binding Session.ExploreCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}}" />

                                                    </ContextMenu>
                                                </sd:TreeView.Resources>
                                                <i:Interaction.Behaviors>
                                                    <sd:DragOverAutoScrollBehavior />
                                                    <sd:TreeViewAutoExpandBehavior />
                                                    <sd:TreeViewDragDropBehavior DragVisualTemplate="{StaticResource DragVisualTemplate}" />
                                                    <sd:TreeViewBindableSelectedItemsBehavior SelectedItems="{Binding Session.ActiveAssetView.SelectedLocations}" />
                                                    <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.CutLocationsCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Cut" />
                                                    <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.CopyLocationsCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Copy" />
                                                    <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.PasteCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Paste" />
                                                    <sd:CommandBindingBehavior Command="{Binding Session.DeleteSelectedSolutionItemsCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Delete" />
                                                </i:Interaction.Behaviors>
                                                <sd:TreeView.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource {x:Type sd:TreeViewItem}}" TargetType="{x:Type sd:TreeViewItem}">
                                                        <Setter Property="IsExpanded" Value="{Binding Mode=OneTime, Converter={sd:AssetToExpandedAtInitialization}}" />
                                                        <Setter d:DataContext="{d:DesignInstance sd:IIsEditableViewModel}" Property="IsEditable" Value="{Binding IsEditable, Mode=OneTime}" />
                                                        <Setter d:DataContext="{d:DesignInstance sd:IIsEditableViewModel}" Property="IsEditing" Value="{Binding IsEditing, Mode=TwoWay}" />
                                                        <Setter Property="ContextMenu" Value="{StaticResource ContextMenu}" />
                                                        <Setter Property="TemplateSelectorEdit" Value="{StaticResource SolutionTreeViewEditTemplate}" />
                                                        <Setter Property="sd:Interaction.Behaviors">
                                                            <Setter.Value>
                                                                <sd:BehaviorCollection>
                                                                    <sd:TreeViewStopEditOnLostFocusBehavior />
                                                                </sd:BehaviorCollection>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </sd:TreeView.ItemContainerStyle>
                                                <sd:TreeView.ItemTemplate>
                                                    <HierarchicalDataTemplate ItemTemplateSelector="{StaticResource SolutionTreeViewTemplate}" ItemsSource="{Binding Content}">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </HierarchicalDataTemplate>
                                                </sd:TreeView.ItemTemplate>
                                            </sd:TreeView>
                                        </DockPanel>
                                    </xcad:LayoutAnchorable>
                                </xcad:LayoutAnchorablePane>
                                <xcad:LayoutDocumentPane>
                                    <!--  ASSET VIEW  -->
                                    <xcad:LayoutAnchorable
                                        Title="{Binding Source={sd:Localize Asset view, Context=View}}"
                                        gh:AvalonDockHelper.IsVisible="{Binding Panels.AssetViewPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                        AutoHideMinWidth="300"
                                        ContentId="AssetView">
                                        <sd:AssetViewUserControl
                                            AssetCollection="{Binding Session.ActiveAssetView}"
                                            AssetContextMenu="{StaticResource AssetContextMenu}"
                                            AssetDoubleClick="{Binding Session.EditSelectedContentCommand}">
                                            <i:Interaction.Behaviors>
                                                <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.CutContentCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Cut" />
                                                <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.CopyContentCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Copy" />
                                                <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.PasteCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Paste" />
                                                <sd:CommandBindingBehavior Command="{Binding Session.ActiveAssetView.DeleteContentCommand}" RoutedCommand="ApplicationCommands.Delete" />
                                                <gl:ActivateParentPaneOnGotFocusBehavior />
                                            </i:Interaction.Behaviors>
                                        </sd:AssetViewUserControl>
                                        <i:Interaction.Behaviors>
                                            <gl:LayoutAnchorableActivateOnLocationChangedBehavior Collection="{Binding Session.ActiveAssetView.SelectedLocations}" />
                                        </i:Interaction.Behaviors>
                                    </xcad:LayoutAnchorable>
                                </xcad:LayoutDocumentPane>
                            </xcad:LayoutPanel>
                            <xcad:LayoutAnchorablePane DockHeight="200">
                                <!--  REFERENCES  -->
                                <xcad:LayoutAnchorable
                                    Title="{Binding Source={sd:Localize References, Context=View}}"
                                    gh:AvalonDockHelper.IsVisible="{Binding Panels.ReferencesPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                    AutoHideMinHeight="200"
                                    ContentId="References">
                                    <DockPanel x:Name="RefViewDockPanel" LastChildFill="True">
                                        <!--  stats  -->
                                        <Border Padding="10,5" DockPanel.Dock="Bottom">
                                            <TextBlock
                                                Text="{Binding Session.References.TypeCountersAsText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">
                                                <TextBlock.ToolTip>
                                                    <TextBlock
                                                        Text="{Binding Session.References.TypeCountersAsText}"
                                                        TextTrimming="None"
                                                        TextWrapping="Wrap" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                        <!--  view  -->
                                        <sd:AssetViewUserControl
                                            AssetCollection="{Binding Session.References.DisplayedReferences}"
                                            AssetContextMenu="{StaticResource AssetContextMenu}"
                                            AssetDoubleClick="{Binding Session.ActiveAssetView.SelectAssetCommand}"
                                            BorderThickness="0"
                                            CanAddAssets="False"
                                            CanDeleteAssets="False"
                                            CanEditAssets="False"
                                            CanRecursivelyDisplayAssets="False"
                                            GiveFocusOnSelectionChange="False"
                                            TileThumbnailSize="64">
                                            <sd:AssetViewUserControl.PrimaryToolBarItems>
                                                <ToggleButton
                                                    MinWidth="80"
                                                    Content="{sd:Localize References}"
                                                    IsChecked="{Binding Session.References.ShowReferencers, Converter={sd:InvertBool}}" />
                                                <ToggleButton
                                                    MinWidth="80"
                                                    Content="{sd:Localize Referenced by}"
                                                    IsChecked="{Binding Session.References.ShowReferencers}" />
                                            </sd:AssetViewUserControl.PrimaryToolBarItems>
                                            <i:Interaction.Behaviors>
                                                <sd:CommandBindingBehavior Command="{Binding Session.References.DisplayedReferences.CutContentCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Cut" />
                                                <sd:CommandBindingBehavior Command="{Binding Session.References.DisplayedReferences.CopyContentCommand, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}" RoutedCommand="ApplicationCommands.Copy" />
                                            </i:Interaction.Behaviors>
                                        </sd:AssetViewUserControl>
                                    </DockPanel>
                                </xcad:LayoutAnchorable>
                                <!--  ASSET LOG  -->
                                <xcad:LayoutAnchorable
                                    Title="{sd:Localize Asset error ({0}),
                                                        Plural=Asset errors ({0}),
                                                        Count={Binding Session.AssetLog.ErrorCount,
                                                                       Source={x:Static vm:GameStudioViewModel.GameStudio}},
                                                        IsStringFormat=True,
                                                        Context=View}"
                                    gh:AvalonDockHelper.IsVisible="{Binding Panels.AssetLogPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                    AutoHideMinHeight="200"
                                    ContentId="AssetLog">
                                    <sd:GridLogViewer
                                        LogMessages="{Binding Session.AssetLog.FilteredMessages}"
                                        Session="{Binding Session}"
                                        ShowDebugMessages="False"
                                        ShowInfoMessages="False"
                                        ShowVerboseMessages="False" />
                                </xcad:LayoutAnchorable>
                                <!--  BUILD LOG  -->
                                <xcad:LayoutAnchorable
                                    Title="{Binding Debugging.OutputTitle, Source={x:Static vm:GameStudioViewModel.GameStudio}}"
                                    gh:AvalonDockHelper.IsVisible="{Binding Panels.BuildLogPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                    AutoHideMinHeight="200"
                                    ContentId="BuildLog">
                                    <TabControl x:Name="LogTabControl">
                                        <TabItem DataContext="{Binding Debugging.BuildLog}">
                                            <TabItem.Header>
                                                <TextBlock FontWeight="{Binding HasNewMessages, Mode=OneWay, Converter={sd:BoolToParam}, ConverterParameter={x:Static FontWeights.Bold}, FallbackValue={x:Static FontWeights.Normal}}" Foreground="{StaticResource SelectedTextBrush}">
                                                    <Run Text="{sd:Localize Build}" />
                                                    <Run Text="{Binding HasNewMessages, Mode=OneWay, Converter={sd:BoolToParam}, ConverterParameter=*}" />
                                                </TextBlock>
                                            </TabItem.Header>
                                            <sd:TextLogViewer
                                                LogMessages="{Binding Messages}"
                                                ShowDebugMessages="False"
                                                ShowInfoMessages="True"
                                                ShowVerboseMessages="False" />
                                            <i:Interaction.Behaviors>
                                                <sd:TabItemActivateOnLogBehavior Collection="{Binding Messages}" MinimumLevel="Error" />
                                            </i:Interaction.Behaviors>
                                        </TabItem>
                                        <!--  FIXME live scripting is disabled (XK-4309)  -->
                                        <TabItem DataContext="{Binding Debugging.LiveScriptingLog}" Visibility="Collapsed">
                                            <TabItem.Header>
                                                <TextBlock FontWeight="{Binding HasNewMessages, Mode=OneWay, Converter={sd:BoolToParam}, ConverterParameter={x:Static FontWeights.Bold}, FallbackValue={x:Static FontWeights.Normal}}" Foreground="{StaticResource SelectedTextBrush}">
                                                    <Run Text="{sd:Localize Live-scripting}" />
                                                    <Run Text="{Binding HasNewMessages, Mode=OneWay, Converter={sd:BoolToParam}, ConverterParameter=*}" />
                                                </TextBlock>
                                            </TabItem.Header>
                                            <sd:TextLogViewer
                                                LogMessages="{Binding Messages}"
                                                ShowDebugMessages="False"
                                                ShowInfoMessages="True"
                                                ShowVerboseMessages="False" />
                                            <i:Interaction.Behaviors>
                                                <sd:TabItemActivateOnLogBehavior Collection="{Binding Messages}" MinimumLevel="Error" />
                                            </i:Interaction.Behaviors>
                                        </TabItem>
                                        <i:Interaction.Behaviors>
                                            <sd:OnEventCommandBehavior Command="{Binding SelectedItem.DataContext.ClearNewMessageFlagCommand, ElementName=LogTabControl}" EventName="SelectionChanged" />
                                        </i:Interaction.Behaviors>
                                    </TabControl>
                                    <i:Interaction.Behaviors>
                                        <sd:OnEventCommandBehavior Command="{Binding Debugging.ResetOutputTitleCommand, Source={x:Static vm:GameStudioViewModel.GameStudio}}" EventName="IsActiveChanged" />
                                        <gl:LayoutAnchorableActivateOnLogBehavior Collection="{Binding Debugging.BuildLog.Messages, Source={x:Static vm:GameStudioViewModel.GameStudio}}" MinimumLevel="Error" />
                                        <gl:LayoutAnchorableActivateOnLogBehavior Collection="{Binding Debugging.LiveScriptingLog.Messages, Source={x:Static vm:GameStudioViewModel.GameStudio}}" MinimumLevel="Error" />
                                    </i:Interaction.Behaviors>
                                </xcad:LayoutAnchorable>
                            </xcad:LayoutAnchorablePane>
                        </xcad:LayoutPanel>
                        <xcad:LayoutAnchorablePaneGroup DockWidth="400" Orientation="Vertical">
                            <xcad:LayoutAnchorablePane DockHeight="2*">
                                <!--  PROPERTY GRID  -->
                                <xcad:LayoutAnchorable
                                    Title="{Binding Source={sd:Localize Property grid, Context=View}}"
                                    gh:AvalonDockHelper.IsVisible="{Binding Panels.PropertyGridPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                    AutoHideMinWidth="400"
                                    ContentId="PropertyGrid">
                                    <Grid Background="{StaticResource ToolBarBackgroundBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="5" />
                                            <RowDefinition Height="70" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="6,6,6,2">
                                            <!--  Adding tag  -->
                                            <sd:TextBox
                                                x:Name="NewTagTextBox"
                                                MinWidth="90"
                                                DockPanel.Dock="Right"
                                                ValidateOnLostFocus="False"
                                                Visibility="{Binding Session.ActiveAssetView.SelectedAssets.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:VisibleOrCollapsed}}}"
                                                WatermarkContent="{sd:Localize Add new tag}">
                                                <i:Interaction.Behaviors>
                                                    <sd:OnEventCommandBehavior
                                                        Command="{Binding Session.AssetTags.AddTagCommand}"
                                                        CommandParameter="{Binding Text, ElementName=NewTagTextBox}"
                                                        EventName="Validated" />
                                                    <sd:OnEventCommandBehavior Command="{x:Static sd:TextBox.ClearTextCommand}" EventName="Validated" />
                                                </i:Interaction.Behaviors>
                                            </sd:TextBox>
                                            <!--  Navigation  -->
                                            <StackPanel
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Orientation="Horizontal">
                                                <Button
                                                    sd:ToolTipHelper.Status="{Binding Session.Editor.Status}"
                                                    Command="{Binding Session.PreviousSelectionCommand}"
                                                    Content="{sd:Image {StaticResource ImagePrevious},
                                                                       16,
                                                                       16,
                                                                       HighQuality}"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                    ToolTip="{sd:Localize Previous selection,
                                                                          Context=ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True" />
                                                <Button
                                                    sd:ToolTipHelper.Status="{Binding Session.Editor.Status}"
                                                    Command="{Binding Session.NextSelectionCommand}"
                                                    Content="{sd:Image {StaticResource ImageNext},
                                                                       16,
                                                                       16,
                                                                       HighQuality}"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                    ToolTip="{sd:Localize Next selection,
                                                                          Context=ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True" />
                                            </StackPanel>
                                            <!--  Description  -->
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run FontWeight="Bold" Text="{Binding Session.ActiveProperties.TypeDescription, Mode=OneWay}" />
                                                <Run Text="{Binding Session.ActiveProperties.Name, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <!--  TAGS  -->
                                        <ToolBar
                                            Grid.Row="1"
                                            Margin="6,2"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Session.AssetTags.Tags}"
                                            Style="{StaticResource TagToolBarStyle}"
                                            Visibility="{Binding Session.AssetTags.Tags.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:VisibleOrCollapsed}}}">
                                            <ToolBar.ItemTemplate>
                                                <DataTemplate>
                                                    <sd:TagControl
                                                        Height="20"
                                                        Margin="2"
                                                        VerticalAlignment="Center"
                                                        CloseTagCommand="{Binding RemoveTagCommand}"
                                                        ToolTip="{Binding Name}"
                                                        Visibility="{Binding Assets.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:VisibleOrCollapsed}}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                MaxWidth="100"
                                                                Margin="2,0"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Cursor="Hand"
                                                                IsEnabled="{Binding Counter, Converter={sd:Chained {sd:StringEquals}, {sd:InvertBool}, Parameter1={} (all)}}"
                                                                Text="{Binding Counter}"
                                                                ToolTip="{sd:Localize Add tag to all,
                                                                                      Context=ToolTip}">
                                                                <i:Interaction.Behaviors>
                                                                    <sd:OnEventCommandBehavior Command="{Binding AddTagToAllCommand}" EventName="MouseDown" />
                                                                </i:Interaction.Behaviors>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </sd:TagControl>
                                                </DataTemplate>
                                            </ToolBar.ItemTemplate>
                                        </ToolBar>

                                        <DockPanel Grid.Row="3" Margin="6,2">
                                            <Button
                                                Margin="0,0,0,8"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding Session.EditSelectedContentCommand}"
                                                DockPanel.Dock="Top"
                                                Visibility="{Binding Session.EditSelectedContentCommand.IsEnabled, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}">
                                                <Grid>
                                                    <DockPanel Visibility="{Binding Session.ActiveProperties.CanDisplayProperties, Converter={sd:VisibleOrCollapsed}}">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Margin="4"
                                                            DockPanel.Dock="Left"
                                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                            Source="{StaticResource ImageEditAsset}" />
                                                        <TextBlock
                                                            Margin="0,4,4,4"
                                                            VerticalAlignment="Center"
                                                            Text="{sd:Localize Open this asset in editor}" />
                                                    </DockPanel>
                                                    <TextBlock
                                                        Margin="0,4,4,4"
                                                        VerticalAlignment="Center"
                                                        Text="{sd:Localize Show this asset in editor}"
                                                        Visibility="{Binding Session.ActiveProperties.CanDisplayProperties, Converter={sd:Chained {sd:InvertBool}, {sd:VisibleOrCollapsed}}}" />
                                                </Grid>
                                            </Button>
                                            <DockPanel Visibility="{Binding Session.ActiveProperties.CanDisplayProperties, Converter={sd:VisibleOrCollapsed}}">
                                                <!--  TODO: Disabling this button for now, it is relatively terrible in term of UX  -->
                                                <ToggleButton
                                                    Width="22"
                                                    Height="22"
                                                    Margin="4,0"
                                                    Content="{sd:Image {StaticResource ImageAssetOverride},
                                                                       16,
                                                                       16}"
                                                    IsChecked="{Binding Session.ActiveProperties.ShowOverridesOnly}"
                                                    ToolTip="{sd:Localize Display only overridden properties,
                                                                          Context=ToolTip}"
                                                    Visibility="Collapsed" />
                                                <AdornerDecorator>
                                                    <sd:TextBox
                                                        x:Name="PropertyFilterTextBox"
                                                        UseTimedValidation="True"
                                                        WatermarkContent="{sd:Localize Search properties}">
                                                        <i:Interaction.Behaviors>
                                                            <sd:ContainTextAdornerBehavior />
                                                        </i:Interaction.Behaviors>
                                                    </sd:TextBox>
                                                </AdornerDecorator>
                                            </DockPanel>
                                        </DockPanel>

                                        <TextBlock
                                            Grid.Row="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Session.ActiveProperties.FallbackMessage}"
                                            Visibility="{Binding Session.ActiveProperties.CanDisplayProperties, Converter={sd:Chained {sd:InvertBool}, {sd:VisibleOrCollapsed}}}" />
                                        <sd:PropertyView
                                            x:Name="AssetPropertyView"
                                            Grid.Row="4"
                                            ItemsSource="{Binding Session.ActiveProperties.ViewModel.RootNode.Children}"
                                            Visibility="{Binding Session.ActiveProperties.CanDisplayProperties, Converter={sd:VisibleOrCollapsed}}">
                                            <sd:PropertyView.Resources>
                                                <RoutedUICommand x:Key="ReplaceCommand" Text="Replace">
                                                    <RoutedUICommand.InputGestures>
                                                        <KeyGesture>Ctrl+Shift+V</KeyGesture>
                                                    </RoutedUICommand.InputGestures>
                                                </RoutedUICommand>
                                            </sd:PropertyView.Resources>
                                            <sd:PropertyView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource {x:Type sd:PropertyViewItem}}" TargetType="sd:PropertyViewItem">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="ContextMenu">
                                                        <Setter.Value>
                                                            <ContextMenu Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={sd:VisibleOrHidden}, FallbackValue={sd:Hidden}}">
                                                                <MenuItem
                                                                    Command="{Binding ResetOverride, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}"
                                                                    Header="{sd:Localize Reset to base value,
                                                                                         Context=Menu}"
                                                                    IsEnabled="{Binding HasBase}" />
                                                                <Separator />
                                                                <MenuItem
                                                                    Command="ApplicationCommands.Copy"
                                                                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type MenuBase}}}"
                                                                    Icon="{sd:Image {StaticResource ImageCopy}}" />
                                                                <MenuItem
                                                                    Command="ApplicationCommands.Paste"
                                                                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type MenuBase}}}"
                                                                    Icon="{sd:Image {StaticResource ImagePaste}}" />
                                                                <MenuItem
                                                                    Command="{StaticResource ReplaceCommand}"
                                                                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type MenuBase}}}"
                                                                    Icon="{sd:Image {StaticResource ImagePaste}}"
                                                                    Visibility="{Binding HasCommand_ReplaceProperty, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}" />
                                                            </ContextMenu>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="HeaderTemplate">
                                                        <Setter.Value>
                                                            <HierarchicalDataTemplate DataType="viewModels:NodeViewModel" ItemsSource="{Binding Children, Mode=OneWay}">
                                                                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{x:Static sd:PropertyViewHelper.HeaderProviders}" />
                                                            </HierarchicalDataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="sd:PropertyViewItem">
                                                                <Border
                                                                    d:DataContext="{d:DesignInstance viewModels:NodeViewModel}"
                                                                    BorderBrush="{TemplateBinding Border.BorderBrush}"
                                                                    BorderThickness="{TemplateBinding Border.BorderThickness}"
                                                                    SnapsToDevicePixels="True"
                                                                    Visibility="{Binding IsVisible, Converter={sd:VisibleOrCollapsed}}">
                                                                    <DockPanel>
                                                                        <Border Background="{TemplateBinding Background}" DockPanel.Dock="Top">
                                                                            <ContentPresenter
                                                                                Name="PART_Header"
                                                                                HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                                                                Content="{TemplateBinding HeaderedContentControl.Header}"
                                                                                ContentSource="Header"
                                                                                ContentStringFormat="{TemplateBinding HeaderedItemsControl.HeaderStringFormat}"
                                                                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                                                                Visibility="{sd:MultiBinding {Binding DataContext.Session.ActiveProperties.ShowOverridesOnly, Converter={sd:InvertBool}, RelativeSource={RelativeSource AncestorType=sd:PropertyView}},
                                                                                                             {Binding IsOverridden},
                                                                                                             {Binding HasBase, Converter={sd:InvertBool}},
                                                                                                             Converter={sd:MultiChained {sd:OrMultiConverter},
                                                                                                                                        {sd:VisibleOrCollapsed}}}" />
                                                                        </Border>
                                                                        <Expander
                                                                            x:Name="propertyExpander"
                                                                            IsEnabled="True"
                                                                            IsExpanded="{TemplateBinding IsExpanded}"
                                                                            Style="{StaticResource PropertyExpanderStyle}">
                                                                            <StackPanel>
                                                                                <ItemsPresenter Name="ItemsHost" />
                                                                                <Border Background="{TemplateBinding Background}">
                                                                                    <ContentPresenter
                                                                                        Name="PART_Footer"
                                                                                        HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                                                                        Content="{TemplateBinding HeaderedContentControl.Header}"
                                                                                        ContentTemplateSelector="{x:Static sd:PropertyViewHelper.FooterProviders}"
                                                                                        SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                                                                        Visibility="{sd:MultiBinding {Binding DataContext.Session.ActiveProperties.ShowOverridesOnly, Converter={sd:InvertBool}, RelativeSource={RelativeSource AncestorType=sd:PropertyView}},
                                                                                                                     {Binding IsOverridden},
                                                                                                                     {Binding HasBase, Converter={sd:InvertBool}},
                                                                                                                     Converter={sd:MultiChained {sd:OrMultiConverter},
                                                                                                                                                {sd:VisibleOrCollapsed}}}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Expander>
                                                                    </DockPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="sd:Interaction.Behaviors">
                                                        <Setter.Value>
                                                            <sd:BehaviorCollection>
                                                                <sd:CommandBindingBehavior
                                                                    Command="{Binding CopyProperty, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}"
                                                                    ContinueRouting="False"
                                                                    RoutedCommand="ApplicationCommands.Copy" />
                                                                <sd:CommandBindingBehavior
                                                                    Command="{Binding PasteProperty, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}"
                                                                    ContinueRouting="False"
                                                                    RoutedCommand="ApplicationCommands.Paste" />
                                                                <sd:CommandBindingBehavior
                                                                    Command="{Binding ReplaceProperty, FallbackValue={x:Static cmd:DisabledCommand.Instance}, Mode=OneWay}"
                                                                    ContinueRouting="False"
                                                                    RoutedCommand="{StaticResource ReplaceCommand}" />
                                                                <sd:PropertyViewFilteringBehavior FilterToken="{Binding Text, ElementName=PropertyFilterTextBox, Mode=OneWay}" />
                                                                <sd:PropertyViewItemDragDropBehavior
                                                                    CanDrag="False"
                                                                    CanDrop="False"
                                                                    CanInsert="True" />
                                                            </sd:BehaviorCollection>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Documentation, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <Setter Property="Highlightable" Value="False" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsHovered" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PropertyGridItemHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource NormalBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardActive" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource NormalBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                    <Style.Resources>
                                                        <Style BasedOn="{StaticResource {x:Type sd:TextBox}}" TargetType="{x:Type sd:TextBox}">
                                                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                            <Setter Property="ToolTipService.IsEnabled" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={sd:Chained {sd:EmptyStringToBool}, {sd:InvertBool}, Parameter1={sd:True}}}" />
                                                        </Style>
                                                    </Style.Resources>
                                                </Style>
                                            </sd:PropertyView.ItemContainerStyle>
                                            <i:Interaction.Behaviors>
                                                <sd:PropertyViewDragDropBehavior
                                                    CanDrag="False"
                                                    CanDrop="True"
                                                    CanInsert="False"
                                                    Target="{Binding Session.ActiveProperties.ViewModel}" />
                                                <sd:PropertyViewFilteringBehavior FilterToken="{Binding Text, ElementName=PropertyFilterTextBox, Mode=OneWay}" />
                                                <sd:PropertyViewAutoExpandNodesBehavior ViewModel="{Binding Session.ActiveProperties.ViewModel, Mode=OneWay}" />
                                            </i:Interaction.Behaviors>
                                        </sd:PropertyView>

                                        <GridSplitter
                                            Grid.Row="5"
                                            Height="5"
                                            HorizontalAlignment="Stretch"
                                            ResizeBehavior="PreviousAndNext" />

                                        <Border Grid.Row="6" Background="{StaticResource ToolBarBackgroundBrush}">
                                            <DockPanel>
                                                <Grid Margin="4" DockPanel.Dock="Top">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="20px" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontStyle="Normal"
                                                        FontWeight="Bold"
                                                        Text="{Binding HoveredItem.DataContext.DisplayName, ElementName=AssetPropertyView}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontStyle="Italic"
                                                        FontWeight="Thin"
                                                        Text="{Binding HoveredItem.DataContext.Type, Converter={sd:TypeToNamespace}, ConverterParameter='$.', ElementName=AssetPropertyView}"
                                                        TextAlignment="Right"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        FontStyle="Italic"
                                                        FontWeight="Bold"
                                                        Text="{Binding HoveredItem.DataContext.Type, Converter={sd:TypeToTypeName}, ElementName=AssetPropertyView}"
                                                        TextAlignment="Left"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="4"
                                                    Text="{Binding HoveredItem.DataContext.Documentation, ElementName=AssetPropertyView}"
                                                    TextTrimming="WordEllipsis"
                                                    TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </xcad:LayoutAnchorable>
                            </xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorablePaneGroup DockHeight="1*">
                                <xcad:LayoutAnchorablePane>
                                    <!--  ASSET PREVIEW  -->
                                    <xcad:LayoutAnchorable
                                        Title="{Binding Source={sd:Localize Asset preview, Context=View}}"
                                        gh:AvalonDockHelper.IsVisible="{Binding Panels.AssetPreviewPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                        AutoHideMinWidth="400"
                                        ContentId="AssetPreview">
                                        <DockPanel LastChildFill="True">
                                            <ContentPresenter Content="{Binding Preview.PreviewObject}" />
                                        </DockPanel>
                                    </xcad:LayoutAnchorable>
                                    <!--  GIT CHANGES  -->
                                    <xcad:LayoutAnchorable
                                        Title="{Binding Source={sd:Localize Git changes, Context=View}}"
                                        gh:AvalonDockHelper.IsVisible="{Binding Panels.GitChangesPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                        AutoHideMinWidth="400"
                                        ContentId="GitChanges">
                                        <DockPanel LastChildFill="True">
                                            <Grid Background="{StaticResource ToolBarBackgroundBrush}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!--  Верхній рядок  -->
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <ComboBox
                                                        Width="150"
                                                        Margin="0,0,5,0"
                                                        Background="#FF2D2D30"
                                                        Foreground="Black"
                                                        SelectedIndex="0">
                                                        <ComboBoxItem Content="main" />
                                                    </ComboBox>
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,2,0"
                                                        Background="#FF2D2D30"
                                                        BorderBrush="Gray"
                                                        Content="↑"
                                                        Foreground="White" />
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,2,0"
                                                        Background="#FF2D2D30"
                                                        BorderBrush="Gray"
                                                        Content="↓"
                                                        Foreground="White" />
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,2,0"
                                                        Background="#FF2D2D30"
                                                        BorderBrush="Gray"
                                                        Content="⟳"
                                                        Foreground="White" />
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        Background="#FF2D2D30"
                                                        BorderBrush="Gray"
                                                        Content="⋯"
                                                        Foreground="White" />
                                                </StackPanel>

                                                <!--  Лічильник і перегляд фіксацій  -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Foreground="LightGray"
                                                    Text="↑ 0 / 0   " />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Margin="60,8,0,0"
                                                    Cursor="Hand"
                                                    Foreground="#FF3794FF"
                                                    Text="Просмотреть все фиксации" />

                                                <!--  Поле повідомлення  -->
                                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                    <TextBox
                                                        Height="60"
                                                        AcceptsReturn="True"
                                                        Background="#FF1E1E1E"
                                                        BorderBrush="Gray"
                                                        Foreground="White"
                                                        Text="Введите сообщение &lt;Обязательно&gt;"
                                                        TextWrapping="Wrap" />
                                                    <!--<Button
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Right"
                                                        Background="#FF2D2D30"
                                                        BorderBrush="Gray"
                                                        Content="+" />-->
                                                </StackPanel>

                                                <!--  Нижня частина  -->
                                                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ComboBox
                                                            Width="200"
                                                            Margin="0,0,10,0"
                                                            Background="#FF2D2D30"
                                                            Foreground="White"
                                                            IsEnabled="True">
                                                            <ComboBoxItem Content="Зафиксировать все" IsSelected="True" />
                                                            <ComboBoxItem Content="Зафиксировать все и отправить" />
                                                            <ComboBoxItem Content="Зафиксировать все и синхронизировать" />
                                                            <ComboBoxItem Content="Спрятать все (--include-untracked)" />
                                                            <ComboBoxItem Content="Спрятать все и сохранить промежуточные данные (--keep-index)" />
                                                        </ComboBox>
                                                        <CheckBox
                                                            VerticalAlignment="Center"
                                                            Content="Исправить"
                                                            Foreground="White" />
                                                    </StackPanel>

                                                    <Expander
                                                        Margin="0,10,0,0"
                                                        Background="#FF2D2D30"
                                                        Foreground="White"
                                                        Header="Связанные элементы">
                                                        <StackPanel Margin="10,5,0,0" Orientation="Vertical">
                                                            <TextBlock Foreground="Gray" Text="В фиксации не упомянуто ни одного елемента" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander
                                                        Margin="0,10,0,0"
                                                        Background="#FF2D2D30"
                                                        Foreground="White"
                                                        IsExpanded="True">
                                                        <!--<StackPanel Margin="10,5,0,0" Orientation="Vertical">
                                                          <TextBlock Foreground="Gray" Text="В рабочей папке нет неподготовленных изменений." />
                                                        </StackPanel>-->
                                                        <!--  Кастомний заголовок  -->
                                                        <Expander.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="Изменения" />

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Margin="0,0,0,0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Background="#FF2D2D30"
                                                                    BorderBrush="Gray"
                                                                    Content="+"
                                                                    Foreground="White" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <TreeView
                                                            Background="#1E1E1E"
                                                            Foreground="White"
                                                            ItemsSource="{Binding GitChanges.ChangedFiles}">
                                                            <TreeView.Resources>
                                                                <Style TargetType="TreeViewItem">
                                                                    <Setter Property="HeaderTemplate">
                                                                        <Setter.Value>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Foreground="White" Text="{Binding}" />
                                                                                    <StackPanel
                                                                                        x:Name="HoverPanel"
                                                                                        Margin="5,0,0,0"
                                                                                        Orientation="Horizontal"
                                                                                        Visibility="Collapsed">
                                                                                        <TextBlock
                                                                                            Margin="0,0,5,0"
                                                                                            Foreground="White"
                                                                                            Text="↺" />
                                                                                        <TextBlock
                                                                                            Margin="0,0,5,0"
                                                                                            Foreground="White"
                                                                                            Text="+" />
                                                                                        <TextBlock Foreground="White" Text="M" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                                <DataTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                                                                        <Setter TargetName="HoverPanel" Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </DataTemplate.Triggers>
                                                                            </DataTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </TreeView.Resources>
                                                            <TreeView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="2" Orientation="Horizontal">
                                                                        <TextBlock Foreground="White" Text="{Binding RelativeFilePath}" />
                                                                        <TextBlock
                                                                            Margin="4,0,0,0"
                                                                            Foreground="Gray"
                                                                            Text=" [" />
                                                                        <TextBlock Foreground="LightGreen" Text="{Binding Status}" />
                                                                        <TextBlock Foreground="Gray" Text="]" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </TreeView.ItemTemplate>
                                                        </TreeView>
                                                    </Expander>
                                                    <Expander
                                                        Margin="0,10,0,0"
                                                        Padding="10"
                                                        Background="#FF2D2D30"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Header="Спрятанные изменения (2)">

                                                        <StackPanel>
                                                            <!--  Кнопка "Удалить все"  -->
                                                            <TextBlock
                                                                Margin="0,0,0,10"
                                                                Cursor="Hand"
                                                                FontWeight="Bold"
                                                                Foreground="#3DAEE9"
                                                                Text="Удалить все" />

                                                            <!--  Список скрытых изменений  -->
                                                            <StackPanel Margin="0,0,0,5" Orientation="Vertical">
                                                                <StackPanel Margin="0,5" Orientation="Horizontal">
                                                                    <Image
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0,0,5,0"
                                                                        Source="/Icons/hidden.png" />
                                                                    <TextBlock Text="WIP on ui: 960799d02 feat: add Git Changes menu item to View Menu tab in GameStudioWindow" />
                                                                </StackPanel>

                                                                <StackPanel Margin="0,5" Orientation="Horizontal">
                                                                    <Image
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0,0,5,0"
                                                                        Source="/Icons/hidden.png" />
                                                                    <TextBlock Text="WIP on ui: 960799d02 feat: add Git Changes menu item to View Menu tab in GameStudioWindow" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                        <!--<DockPanel LastChildFill="True">
                                            <ContentPresenter Content="{Binding Preview.PreviewObject}" />
                                        </DockPanel>-->
                                    </xcad:LayoutAnchorable>
                                    <!--  EDIT HISTORY  -->
                                    <xcad:LayoutAnchorable
                                        Title="{Binding Source={sd:Localize Edit history, Context=View}}"
                                        gh:AvalonDockHelper.IsVisible="{Binding Panels.ActionHistoryPanelVisible, Mode=TwoWay, Source={x:Static vm:GameStudioViewModel.GameStudio}, FallbackValue={sd:True}}"
                                        AutoHideMinWidth="400"
                                        ContentId="ActionHistory">
                                        <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding Session.ActionHistory.Transactions}">
                                            <ListBox.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel HorizontalAlignment="Stretch">
                                                        <TextBlock
                                                            x:Name="txt"
                                                            DockPanel.Dock="Left"
                                                            Text="{Binding Name, Mode=OneWay}" />
                                                        <Image
                                                            x:Name="img"
                                                            HorizontalAlignment="Right"
                                                            DockPanel.Dock="Right"
                                                            Source="{StaticResource ImageSave}"
                                                            Visibility="Hidden" />
                                                    </DockPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone, Mode=OneWay}" Value="False">
                                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource PressedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSavePoint, Mode=OneWay}" Value="True">
                                                            <Setter TargetName="img" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </xcad:LayoutAnchorable>
                                </xcad:LayoutAnchorablePane>
                            </xcad:LayoutAnchorablePaneGroup>
                        </xcad:LayoutAnchorablePaneGroup>
                    </xcad:LayoutPanel>
                </xcad:LayoutRoot>
            </xcad:DockingManager>
            <StatusBar
                Grid.Row="2"
                Background="{StaticResource StatusBarBackgroundBrush}"
                Visibility="{Binding Session, Converter={sd:Chained {sd:ObjectToBool}, {sd:VisibleOrCollapsed}}}">
                <StatusBar.Resources>
                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SelectedTextBrush}" />
                    </Style>
                    <Style
                        x:Key="StatusBarSeparatorStyle"
                        BasedOn="{StaticResource {x:Type Separator}}"
                        TargetType="{x:Type Separator}">
                        <Setter Property="Background" Value="{StaticResource SelectedTextBrush}" />
                        <Setter Property="Opacity" Value="0.25" />
                    </Style>
                </StatusBar.Resources>
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <TextBlock Margin="5,0" Text="{Binding Status.CurrentStatus}" />
                </StatusBarItem>
                <Separator Grid.Column="1" Style="{StaticResource StatusBarSeparatorStyle}" />
                <StatusBarItem Grid.Column="2">
                    <TextBlock>
                        <Run Text="{sd:Localize {}{0} item, Plural={}{0} items, Count={Binding Session.ActiveAssetView.FilteredContent.Count, Mode=OneWay}, IsStringFormat=True, Context=StatusBar}" />
                        <Run Text="{sd:Localize ({0} selected), Plural=({0} selected), Count={Binding Session.ActiveAssetView.SelectedContent.Count, Mode=OneWay}, IsStringFormat=True, Context=StatusBar}" />
                    </TextBlock>
                </StatusBarItem>
                <Separator Grid.Column="3" Style="{StaticResource StatusBarSeparatorStyle}" />
                <StatusBarItem Grid.Column="4" HorizontalContentAlignment="Right">
                    <TextBlock Margin="5,0" Text="{Binding Status.CurrentJob.Message}" />
                </StatusBarItem>
                <StatusBarItem
                    Grid.Column="5"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <ProgressBar
                        IsIndeterminate="{Binding Status.CurrentJob.IsIndeterminate}"
                        Maximum="{Binding Status.CurrentJob.Total}"
                        Visibility="{Binding Status.CurrentJob, Converter={sd:Chained {sd:ObjectToBool}, {sd:VisibleOrCollapsed}}}"
                        Value="{Binding Status.CurrentJob.Current}" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>

