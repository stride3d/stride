<!--
Launcher release: publishes the exe, packs the nupkg (the self-update) and builds StrideSetup, into bin\launcher.
Imported by build\Stride.build, which runs these targets, e.g. msbuild build\Stride.build /t:FullBuildLauncher
-->
<Project>
  <Import Project="Stride.Launcher\Stride.Launcher.Version.props" />

  <PropertyGroup>
    <!-- Launchers before 6.0 update to pre-releases too: a pre-release sends them to the release setup instead -->
    <StrideLauncherForceReinstallMinVersion>5.0.1</StrideLauncherForceReinstallMinVersion>
    <StrideLauncherForceReinstallMinVersion Condition="'$(VersionSuffix)' != ''">6.0.0</StrideLauncherForceReinstallMinVersion>
    <!-- The website serves its own copy, renamed to StrideSetup.exe when it's updated -->
    <StrideSetupFileName>StrideSetup-$(StrideLauncherVersion).exe</StrideSetupFileName>
  </PropertyGroup>

  <UsingTask TaskName="GetStrideSetupVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)Setup\GetStrideSetupVersion.cs" />
    </Task>
  </UsingTask>

  <Target Name="_StrideSetupVersion">
    <GetStrideSetupVersion Version="$(StrideLauncherVersion)">
      <Output TaskParameter="MsiVersion" PropertyName="StrideSetupMsiVersion" />
      <Output TaskParameter="ProductCode" PropertyName="StrideSetupProductCode" />
    </GetStrideSetupVersion>
    <Message Importance="high" Text="StrideSetup $(StrideLauncherVersion): MSI version $(StrideSetupMsiVersion), ProductCode $(StrideSetupProductCode), $(StrideSetupFileName)" />
  </Target>

  <!--
  Package Launcher
  -->
  <!-- _StrideSetupVersion also rejects a version NuGet or MSI can't order, before anything is packed -->
  <Target Name="PackageLauncher" DependsOnTargets="_StrideSetupVersion">
    <ItemGroup>
      <FilesToDeleteLauncher Include="$(StrideRoot)bin\launcher\*.nupkg"/>
      <FilesToDeleteLauncher Include="$(StrideRoot)bin\launcher\*.exe"/>
    </ItemGroup>

    <!-- Note: we avoid building again if BuildWindows was already ran just before -->
    <Delete Files="@(FilesToDeleteLauncher)"/>

    <!-- Generate the nuget package for the launcher application -->
    <Exec Command='"$(NuGetPath)" pack "$(MSBuildThisFileDirectory)Stride.Launcher\Stride.Launcher.nuspec" -Version $(StrideLauncherVersion) -Properties ForceReinstallMinVersion=$(StrideLauncherForceReinstallMinVersion) -BasePath "$(MSBuildThisFileDirectory)Stride.Launcher\bin\Release\publish" -OutputDirectory "$(StrideRoot)bin\launcher"' />

    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_SignFiles"
             Properties="StrideSign=$(StrideSign);StrideSignDir=$(StrideRoot)bin\launcher" />
  </Target>

  <!--
  Package Installer: StrideSetup.exe
  -->
  <Target Name="PackageInstaller" DependsOnTargets="PackageLauncher">
    <PropertyGroup>
      <_StrideSetupDir>$(MSBuildThisFileDirectory)Setup\</_StrideSetupDir>
      <!-- The version is set on a copy (next to the original, as its paths are relative) so the committed project stays as it is -->
      <_StrideSetupAip>$(_StrideSetupDir)setup-generated.aip</_StrideSetupAip>
    </PropertyGroup>
    <Copy SourceFiles="$(_StrideSetupDir)setup.aip" DestinationFiles="$(_StrideSetupAip)" />
    <Exec Command='"$(AdvancedInstallerPath)" /edit "$(_StrideSetupAip)" /SetVersion $(StrideSetupMsiVersion) -noprodcode' />
    <Exec Command='"$(AdvancedInstallerPath)" /edit "$(_StrideSetupAip)" /SetProductCode -langid 1033 -guid $(StrideSetupProductCode)' />
    <Exec Command='"$(AdvancedInstallerPath)" /edit "$(_StrideSetupAip)" /SetProperty StrideVersion=$(StrideLauncherVersion)' />
    <Exec Command='"$(AdvancedInstallerPath)" /edit "$(_StrideSetupAip)" /SetPackageName $(StrideSetupFileName) -buildname DefaultBuild' />
    <Exec Command='"$(AdvancedInstallerPath)" /edit "$(_StrideSetupAip)" /SetOutputLocation -buildname DefaultBuild -path "$(_StrideSetupDir)setup-SetupFiles"' />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_BuildAdvancedInstaller" Properties="StrideInstallerAip=$(_StrideSetupAip)" />
    <Copy SourceFiles="$(_StrideSetupDir)setup-SetupFiles\$(StrideSetupFileName)" DestinationFolder="$(StrideRoot)bin\launcher"/>
  </Target>

  <!--
  Perform a full build: Build, Package and PackageInstaller
  -->
  <Target Name="FullBuildLauncher">
    <CallTarget Targets="BuildLauncher"/>
    <CallTarget Targets="PackageInstaller"/>
  </Target>

  <!--
  Publish Launcher nupkg from this folder to the store
  -->
  <Target Name="PublishLauncher">
    <Error Condition="'$(StrideStoreApiKey)' == ''" Text="Missing env variable StrideStoreApiKey"/>
    <Exec Command='"$(NuGetPath)" push "$(StrideRoot)bin\launcher\*.nupkg" -ApiKey $(StrideStoreApiKey) -Source $(StrideStoreUrl) -NoSymbols'/>
  </Target>

  <Target Name="BuildLauncher" DependsOnTargets="SignCredentialsCheck">
    <MSBuild Targets="Restore" Projects="$(MSBuildProjectFullPath)" Properties="StridePlatforms=Windows;StrideSolution=$(StrideSolutionLauncher);RuntimeIdentifiers=win-x64"/>
    <MSBuild Projects="$(MSBuildThisFileDirectory)Stride.Launcher\Stride.Launcher.csproj" Targets="Publish" Properties="$(BuildProperties);PublishProfile=FolderProfile;SolutionName=Stride.Launcher" />
  </Target>
</Project>
