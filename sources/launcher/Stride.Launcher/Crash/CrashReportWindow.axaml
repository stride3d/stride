<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Stride.Crash.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
        x:Class="Stride.Crash.CrashReportWindow"
        x:DataType="vm:CrashReportViewModel"
        Icon="/Assets/CrashReportImage.png"
        Title="Report your crash"
        MinWidth="640" MinHeight="480" Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <FluentTheme />
  </Window.Styles>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <Image DockPanel.Dock="Left"
               Width="64" Margin="0,0,8,8"
               Source="/Assets/CrashReportImage.png"/>
        <TextBlock TextWrapping="WrapWithOverflow">
          Unfortunately, <Run Text="{Binding ApplicationName, Mode=OneWay}" /> has crashed.
          Please help us improve Stride by sending this crash report, or by opening a GitHub issue.
        </TextBlock>
      </DockPanel>
      <TextBlock Margin="4,0,4,4" TextWrapping="WrapWithOverflow"
                 Opacity="0.7" FontSize="12"
                 IsVisible="{Binding CanSendReport}"
                 Text="The report goes to Stride's crash reporting service and contains the crash details below — the error and stack, and basic system info. Your Windows user name and home-folder path are stripped; you can review the full report before sending. Reports carry a random installation id, not derived from you." />
      <StackPanel Margin="4,2,4,4" IsVisible="{Binding CanSendReport}">
        <TextBlock Text="What were you doing when it crashed? (optional)" Margin="0,0,0,2" />
        <TextBox Text="{Binding FeedbackMessage, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="48" MaxHeight="90" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Name (optional):" VerticalAlignment="Center" />
          <TextBox Text="{Binding FeedbackName, Mode=TwoWay}" Width="140" Margin="6,0,16,0" />
          <TextBlock Text="Email (optional):" VerticalAlignment="Center"
                     ToolTip.Tip="Only used to contact you about this crash" />
          <TextBox Text="{Binding FeedbackEmail, Mode=TwoWay}" Width="200" Margin="6,0,0,0"
                   ToolTip.Tip="Only used to contact you about this crash" />
        </StackPanel>
      </StackPanel>
      <TextBlock Margin="4,0,4,4" TextWrapping="WrapWithOverflow"
                 FontWeight="SemiBold"
                 IsVisible="{Binding SendStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding SendStatus, Mode=OneWay}" />
      <DockPanel LastChildFill="False" Margin="4">
        <Button DockPanel.Dock="Left" Margin="4 0"
                Content="View Report"
                Command="{Binding ViewReportCommand}"/>
        <Button DockPanel.Dock="Left" Margin="8 0"
                Content="Copy Report"
                Command="{Binding CopyReportCommand}" />
        <Button DockPanel.Dock="Right" Margin="4 0"
                Content="Close"
                Command="{Binding CloseCommand}" />
        <!-- TODO: hyperlink style -->
        <Button DockPanel.Dock="Right" Margin="8 0"
                Content="New GitHub Issue"
                Command="{Binding OpenIssueCommand}" />
        <Button DockPanel.Dock="Right" Margin="8 0"
                Content="Send Report" IsDefault="True"
                IsVisible="{Binding CanSendReport}"
                IsEnabled="{Binding !IsSending}"
                Command="{Binding SendReportCommand}" />
      </DockPanel>
    </StackPanel>
    <TextBox IsReadOnly="True"
             IsVisible="{Binding IsReportVisible, Mode=OneWay}"
             Text="{Binding Report, Mode=OneWay}" />
  </DockPanel>
</Window>
