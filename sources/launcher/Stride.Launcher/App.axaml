<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Stride.Launcher.Assets.Localization"
             x:Class="Stride.Launcher.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Presentation.Avalonia/Windows/GeometryResources.axaml"/>
        <ResourceInclude Source="avares://Stride.Core.Presentation.Avalonia/Windows/TitleBar.axaml" />
        <ResourceInclude Source="Views/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="TileBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#17000000" />
          <BoxShadows x:Key="CardShadow">0 1 2 #17000000</BoxShadows>
          <SolidColorBrush x:Key="ChromeWhiteBrush" Color="{StaticResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="#80FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#17FFFFFF" />
          <BoxShadows x:Key="CardShadow">0 1 2 #17FFFFFF</BoxShadows>
          <SolidColorBrush x:Key="ChromeWhiteBrush" Color="{StaticResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="#0FFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Thickness x:Key="TileBorderThickness">12</Thickness>
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"/>
        <ColorPaletteResources x:Key="Light"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />

    <Style Selector="Border.card">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0 0 0 8" />
    </Style>
    <Style Selector="Button.mediaButton">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.mediaButton:pointerover">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.transparentButton">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.transparentButton">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
