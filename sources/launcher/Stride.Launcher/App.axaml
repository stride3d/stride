<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Stride.Launcher.Assets.Localization"
             xmlns:vm="using:Stride.Launcher.ViewModels"
             x:Class="Stride.Launcher.App"
             RequestedThemeVariant="Dark">
  <!-- Dark by default: the light variant isn't tuned yet. The user can choose another one (LauncherSettings.ThemeVariant, App.Initialize) -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Presentation.Avalonia/Windows/GeometryResources.axaml"/>
        <ResourceInclude Source="avares://Stride.Core.Presentation.Avalonia/Windows/TitleBar.axaml" />
        <ResourceInclude Source="Views/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="TileBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#17000000" />
          <BoxShadows x:Key="CardShadow">0 1 2 #17000000</BoxShadows>
          <SolidColorBrush x:Key="ChromeWhiteBrush" Color="{StaticResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="#80FFFFFF" />
          <!-- Badges of the version rows: nightly builds (amber), local builds (blue), betas (violet), custom builds (teal) -->
          <SolidColorBrush x:Key="NightlyBadgeBackgroundBrush" Color="#2EE08A00" />
          <SolidColorBrush x:Key="NightlyBadgeForegroundBrush" Color="#9A5B00" />
          <SolidColorBrush x:Key="LocalBadgeBackgroundBrush" Color="#263A8EE6" />
          <SolidColorBrush x:Key="LocalBadgeForegroundBrush" Color="#1F5FA8" />
          <SolidColorBrush x:Key="BetaBadgeBackgroundBrush" Color="#268A5CD6" />
          <SolidColorBrush x:Key="BetaBadgeForegroundBrush" Color="#5E35A8" />
          <SolidColorBrush x:Key="TagBadgeBackgroundBrush" Color="#2614A3A3" />
          <SolidColorBrush x:Key="TagBadgeForegroundBrush" Color="#0E6B6B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#17FFFFFF" />
          <BoxShadows x:Key="CardShadow">0 1 2 #17FFFFFF</BoxShadows>
          <SolidColorBrush x:Key="ChromeWhiteBrush" Color="{StaticResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="NightlyBadgeBackgroundBrush" Color="#40F5A623" />
          <SolidColorBrush x:Key="NightlyBadgeForegroundBrush" Color="#FFC46A" />
          <SolidColorBrush x:Key="LocalBadgeBackgroundBrush" Color="#403A8EE6" />
          <SolidColorBrush x:Key="LocalBadgeForegroundBrush" Color="#8AB8F0" />
          <SolidColorBrush x:Key="BetaBadgeBackgroundBrush" Color="#409B6BE6" />
          <SolidColorBrush x:Key="BetaBadgeForegroundBrush" Color="#C3A6F2" />
          <SolidColorBrush x:Key="TagBadgeBackgroundBrush" Color="#4022B8B8" />
          <SolidColorBrush x:Key="TagBadgeForegroundBrush" Color="#7FDCDC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- The badge of the version on the Start and Install buttons, as on its row in the list -->
      <DataTemplate x:Key="VersionCaptionBadge" DataType="vm:VersionCaption">
        <Panel VerticalAlignment="Center" Margin="8,0,0,0">
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource NightlyBadgeBackgroundBrush}" IsVisible="{Binding IsNightly}">
            <TextBlock Text="{x:Static l:Strings.BadgeNightly}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource NightlyBadgeForegroundBrush}" />
          </Border>
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource LocalBadgeBackgroundBrush}" IsVisible="{Binding IsLocal}">
            <TextBlock Text="{x:Static l:Strings.BadgeLocal}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource LocalBadgeForegroundBrush}" />
          </Border>
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource BetaBadgeBackgroundBrush}" IsVisible="{Binding IsBeta}">
            <TextBlock Text="{x:Static l:Strings.BadgeBeta}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource BetaBadgeForegroundBrush}" />
          </Border>
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource TagBadgeBackgroundBrush}"
                  IsVisible="{Binding Tag, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TagBadgeForegroundBrush}" />
          </Border>
        </Panel>
      </DataTemplate>
      <Thickness x:Key="TileBorderThickness">12</Thickness>
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- The Stride red of the launcher 5.x, rather than the system accent color: Fluent derives its shades (hover, pressed) -->
        <ColorPaletteResources x:Key="Dark" Accent="#900520"/>
        <ColorPaletteResources x:Key="Light" Accent="#900520"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />

    <Style Selector="Border.card">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0 0 0 8" />
    </Style>
    <Style Selector="Button.mediaButton">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.mediaButton:pointerover">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.transparentButton">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.transparentButton">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <!-- The text of the Start and Install buttons: the version in the middle, the date of a dated build on a second line, and on the
         right the badge of its row in the list. An invisible copy of the badge on the left keeps the version centered; the
         text shrinks only when it doesn't fit -->
    <DataTemplate DataType="vm:VersionCaption">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VersionCaptionBadge}" Opacity="0" />
        <Viewbox Grid.Column="1" HorizontalAlignment="Center" StretchDirection="DownOnly">
          <StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="{Binding Text}" Classes.dated="{Binding IsDated}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.dated">
                  <Setter Property="FontSize" Value="20" />
                  <Setter Property="LineHeight" Value="21" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" FontSize="12" LineHeight="14" Opacity="0.85"
                       Text="{Binding BuildDateText}" IsVisible="{Binding IsDated}" />
          </StackPanel>
        </Viewbox>
        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource VersionCaptionBadge}" />
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
