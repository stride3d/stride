<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <!-- UI-agnostic and cross-platform: shared by the WPF window, the Avalonia launcher, and headless tools -->
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <!-- Builds Native/*.cpp into runtimes/<rid>/native/libstridecrash.<ext>: the native crash trigger.
         Windows-only in effect; a no-op stub elsewhere. Deleted once .NET 12's SetFatalErrorHandler lands. -->
    <StrideNativeOutputName>libstridecrash</StrideNativeOutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sentry" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native access-violation handler (vectored exception handler + minidump). Shared with the test
         harness and the asset compiler; here it backs NativeCrashReporting for the in-process apps. -->
    <Compile Include="..\..\shared\NativeCrashHandler.cs" Link="NativeCrashHandler.cs" />
  </ItemGroup>
  <!-- StrideSentryDsn: a DSN sends crash reports there (official CI sets it, with StrideSentryEnvironment
       release/nightly); 'false' removes crash sending entirely; unset lets the user pick a destination per crash -->
  <ItemGroup Condition="'$(StrideSentryDsn)' != '' and '$(StrideSentryDsn)' != 'false'">
    <AssemblyMetadata Include="SentryDsn" Value="$(StrideSentryDsn)" />
  </ItemGroup>
  <ItemGroup Condition="'$(StrideSentryDsn)' == 'false'">
    <AssemblyMetadata Include="SentryDisabled" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(StrideSentryEnvironment)' != ''">
    <AssemblyMetadata Include="SentryEnvironment" Value="$(StrideSentryEnvironment)" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
