<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Stride.CrashReport.TestProbe</RootNamespace>
    <AssemblyName>Stride.CrashReport.TestProbe</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.CrashReport\Stride.CrashReport.csproj" />
    <!-- Own copy of the native handler, so the probe exercises the exact shared source the products use. -->
    <Compile Include="..\..\shared\NativeCrashHandler.cs" Link="NativeCrashHandler.cs" />
  </ItemGroup>
</Project>
