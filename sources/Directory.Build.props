<Project>
  <PropertyGroup>
    <!-- StrideRoot points to the repository root (one level above sources/).
         This file is auto-discovered during Microsoft.Common.props evaluation, which
         happens inside Microsoft.NET.Sdk initialization — i.e., inside Sdk.props.
         Therefore $(StrideRoot) is available within SDK files and for the closing
         targets <Import> at the bottom of project files, but NOT for the opening
         props <Import> (which uses GetDirectoryNameOfFileAbove to locate Sdk.props
         without any pre-set property). See docs/build/SDK-GUIDE.md for details. -->
    <StrideRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</StrideRoot>
    <!-- Stride's own assemblies aren't trimmed/AOT-published by the engine repo build;
         end-user games re-enable the analyzer via Microsoft.NET.Sdk defaults. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- Sentry's source generator injects a module initializer into an exe that loads Sentry.dll at startup.
         The apps resolving their dependencies from the store (GameStudio, the asset compiler) can't satisfy
         that, and nothing needs it: Sentry is only used at send time. This property is the only switch;
         ExcludeAssets="analyzers" on the reference doesn't keep the SDK from loading the generator. -->
    <SentryDisableSourceGenerator>true</SentryDisableSourceGenerator>
    <!-- CS1591: Missing XML comment for publicly visible type or member
         VSTHRD200: Use "Async" suffix for async methods
         The editor's newer public API is [Experimental] (STREXP001 to STREXP010, docs/build/plugins.md):
         a plugin outside this repository opts in per id. Stride's own projects (the editors, the built-in plugins,
         the tests) change with it, so they all opt in here, in one place. -->
    <NoWarn>$(NoWarn);CS1591;VSTHRD200;STREXP001;STREXP002;STREXP003;STREXP004;STREXP005;STREXP006;STREXP007;STREXP008;STREXP009;STREXP010</NoWarn>
  </PropertyGroup>
</Project>