<!-- Content template version authority, read from StrideVersion.SamplesVersion in SharedAssemblyInfo.cs (the single
     source, shared with the Game Studio bridge and the stride CLI). Imported by Stride.Templates.Common.targets (the
     pack side) and build/Stride.Samples.build (the samples release side).

     StrideSamplesVersion is the version a content pack gets (before the -devN worktree suffix). It defaults to the
     committed value; a -p:StrideSamplesVersion= global property wins (release-samples.yml packs the new number before it is
     committed). _StrideCommittedSamplesVersion always carries the committed value. -->
<Project>
  <PropertyGroup>
    <_StrideCommittedSamplesVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\shared\SharedAssemblyInfo.cs')), `SamplesVersion = \"([^\"]*)\";`).Groups[1].Value)</_StrideCommittedSamplesVersion>
    <StrideSamplesVersion Condition="'$(StrideSamplesVersion)' == ''">$(_StrideCommittedSamplesVersion)</StrideSamplesVersion>
  </PropertyGroup>
</Project>
