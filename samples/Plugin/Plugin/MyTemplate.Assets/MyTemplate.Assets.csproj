<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MyTemplate.Assets</RootNamespace>
    <Version>1.0.0</Version>
    <!-- What this companion carries: asset types, compilers and templates, loaded by the asset compiler and the Game Studio -->
    <StridePackageKind>Assets</StridePackageKind>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Core.Assets" Version="$EngineVersion$" />
    <PackageReference Include="Stride.AssetCompiler" Version="$EngineVersion$" IncludeAssets="build;buildTransitive" />
    <ProjectReference Include="..\MyTemplate\MyTemplate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Templates\**" />
  </ItemGroup>
</Project>
