<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The game's solution still builds on Linux and macOS: Game Studio, which loads this package, runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <RootNamespace>MyTemplate.Editor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!-- What this companion carries: Game Studio extensions (gizmos, previews); only the Game Studio loads it -->
    <StridePackageKind>Editor</StridePackageKind>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Assets.Presentation.Wpf" Version="$EngineVersion$" />
    <PackageReference Include="Stride.AssetCompiler" Version="$EngineVersion$" IncludeAssets="build;buildTransitive" />
    <ProjectReference Include="..\MyTemplate\MyTemplate.csproj" />
    <ProjectReference Include="..\MyTemplate.Assets\MyTemplate.Assets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\*.png" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
</Project>
