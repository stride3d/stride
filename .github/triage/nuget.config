<?xml version="1.0" encoding="utf-8"?>
<!-- The triage tool only needs nuget.org: the repo's stride-local feed is a build output folder that a triage run never has -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
