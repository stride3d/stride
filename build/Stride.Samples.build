<?xml version="1.0" encoding="utf-8"?>
<!--
  In-repo sample version management. Standalone entry point - run directly, e.g.
  dotnet msbuild build/Stride.Samples.build -t:CutSamples -p:StrideSamplesVersion=4.4.1. See docs/build/versioning.md.

  Two versions meet here:
    - the ENGINE version the sample csprojs reference (SampleVersion, the clean release version; locally only the
      per-checkout dev packages 4.4.0-devN exist, so the targets switch the csprojs between the two by REAL on-disk
      edits, no evaluation-time flip);
    - the CONTENT version of the template packs cut from the samples (StrideVersion.SamplesVersion, the exact
      published version an engine names; StrideSamplesVersion here).

    CutSamples              - the samples release: guards, UpgradeSamplesVersion, SamplesToReleaseVersion, write the
                              new content version into SharedAssemblyInfo.cs, pack the content templates as this
                              checkout's -devN, print what is left to do by hand.
    UpgradeSamplesVersion   - bump from the committed version through the package upgrader: migrate assets,
                              rewrite refs to this checkout's dev build (4.4.0-devN), restore. Leaves the
                              csprojs at the dev version so they open in GameStudio.
    SamplesToDevVersion     - switch already-bumped samples (at the clean version) to the dev build, to
                              re-open them on a worktree later.
    SamplesToReleaseVersion - switch the dev version back to the clean release version. Run before committing.
    PackContentTemplates    - pack Stride.Templates.Samples / .Games.Starters / .AssetPacks (a normal build never does).
    CleanContentTemplates   - remove this checkout's local content packs, so the published ones resolve again.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- StrideRoot self-default: this file is run standalone, e.g.
       dotnet msbuild build/Stride.Samples.build -t:UpgradeSamplesVersion. -->
  <PropertyGroup>
    <StrideRoot Condition="'$(StrideRoot)' == ''">$(MSBuildThisFileDirectory)..\</StrideRoot>
  </PropertyGroup>

  <!-- StrideGitVersion task (clean release version from git release tags). -->
  <Import Project="$(StrideRoot)sources\targets\Stride.GitVersion.targets"
          Condition="'$(_StrideGitVersionTargetsImported)' != 'true'" />

  <!-- Worktree-version machinery: provides StrideWorktreeSuffix so we can build the local,
       actually-published dev version (clean + suffix, e.g. 4.4.0-dev2). -->
  <Import Project="$(StrideRoot)sources\targets\Stride.WorktreeVersion.targets"
          Condition="'$(_StrideWorktreeVersionTargetsImported)' != 'true'" />

  <!-- The content version authority (StrideSamplesVersion, _StrideCommittedSamplesVersion), shared with the
       template pack (Stride.Templates.Common.targets). -->
  <Import Project="$(StrideRoot)sources\templates\StrideSamplesVersion.props" />

  <PropertyGroup>
    <_StrideSharedAssemblyInfo>$(StrideRoot)sources\shared\SharedAssemblyInfo.cs</_StrideSharedAssemblyInfo>
  </PropertyGroup>

  <!-- The content template projects (StrideTemplateContentVersioned=true); Stride.Templates.Games is
       engine-versioned and packed by every build. -->
  <ItemGroup>
    <_StrideContentTemplateProject Include="$(StrideRoot)sources\templates\Stride.Templates.Games.Starters\Stride.Templates.Games.Starters.csproj" />
    <_StrideContentTemplateProject Include="$(StrideRoot)sources\templates\Stride.Templates.Samples\Stride.Templates.Samples.csproj" />
    <_StrideContentTemplateProject Include="$(StrideRoot)sources\templates\Stride.Templates.AssetPacks\Stride.Templates.AssetPacks.csproj" />
  </ItemGroup>

  <!-- Rewrites Stride.* PackageReference Versions equal to SourceVersion -> TargetVersion (a real csproj
       edit). The exact source-version match is the whole filter: only refs at the expected version are
       touched, so $-placeholder versions (e.g. $EngineVersion$) and third-party Stride.*-prefixed packages
       (which carry their own version) are left alone without needing a name skip-list. -->
  <UsingTask TaskName="SetStrideVersionInProjects" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Projects ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <SourceVersion ParameterType="System.String" Required="true" />
      <TargetVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var rx = new System.Text.RegularExpressions.Regex("(Include=\"Stride[^\"]*\"[^>]*?\\sVersion=\")([^\"]*)(\")");
        foreach (var item in Projects)
        {
            var path = item.ItemSpec;
            if (!System.IO.File.Exists(path)) continue;
            var text = System.IO.File.ReadAllText(path);
            var newText = rx.Replace(text, m => m.Groups[2].Value == SourceVersion
                ? m.Groups[1].Value + TargetVersion + m.Groups[3].Value
                : m.Value);
            if (newText != text)
                System.IO.File.WriteAllText(path, newText);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Writes the content version into SharedAssemblyInfo.cs (the 'SamplesVersion = "x";' line, the same shape
       rule as the other version constants; the line is the authority the build, the bridge and the CLI read). -->
  <UsingTask TaskName="SetSamplesVersionConst" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var rx = new System.Text.RegularExpressions.Regex("SamplesVersion = \"[^\"]*\";");
        var text = System.IO.File.ReadAllText(File);
        if (rx.Matches(text).Count != 1)
        {
            Log.LogError("Expected exactly one 'SamplesVersion = \"...\";' line in " + File);
            return false;
        }
        var newText = rx.Replace(text, "SamplesVersion = \"" + Version + "\";");
        if (newText != text)
            System.IO.File.WriteAllText(File, newText);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Resolves SampleVersion (clean release, suffix off) + SampleDevVersion (clean + worktree
       suffix = the locally-published dev version) + the concrete sample csproj set (all under
       samples/ minus the $EngineVersion$ template sources NewGame/Library, the set release-deploy.yml
       checks for changes since the cut). -->
  <Target Name="_ResolveSampleVersions" DependsOnTargets="StrideEnsureWorktreeVersion">
    <PropertyGroup>
      <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    </PropertyGroup>
    <MakeDir Directories="$(StrideRoot)bin\obj" Condition="'$(SampleVersion)' == ''" />
    <StrideGitVersion Condition="'$(SampleVersion)' == ''"
        RootDirectory="$(StrideRoot)"
        VersionFile="sources\shared\SharedAssemblyInfo.cs"
        GeneratedVersionFile="bin\obj\SampleVersionProbe.cs">
      <Output TaskParameter="NuGetVersion" PropertyName="SampleVersion" />
    </StrideGitVersion>
    <Error Condition="'$(SampleVersion)' == ''" Text="Could not resolve a sample version. Pass -p:SampleVersion=." />
    <PropertyGroup>
      <SampleDevVersion>$(SampleVersion)$(StrideWorktreeSuffix)</SampleDevVersion>
    </PropertyGroup>
    <ItemGroup>
      <_StrideSampleCsproj Include="$(StrideRoot)samples\**\*.csproj" />
      <_StrideSampleCsproj Remove="$(StrideRoot)samples\NewGame\**\*.csproj" />
      <_StrideSampleCsproj Remove="$(StrideRoot)samples\Library\**\*.csproj" />
    </ItemGroup>
  </Target>

  <!-- Switch already-bumped samples (committed at the clean version) to this checkout's dev build, e.g.
       before opening them in GameStudio on a worktree. Real csproj edits; run SamplesToReleaseVersion
       before committing. A no-op on samples not at the clean version (run UpgradeSamplesVersion first). -->
  <Target Name="SamplesToDevVersion" DependsOnTargets="_ResolveSampleVersions">
    <SetStrideVersionInProjects Projects="@(_StrideSampleCsproj)" SourceVersion="$(SampleVersion)" TargetVersion="$(SampleDevVersion)" />
    <Message Importance="high" Text="Samples set to dev version $(SampleDevVersion)." />
  </Target>

  <!-- Switch samples from the dev build back to the committed clean release version. Run before committing. -->
  <Target Name="SamplesToReleaseVersion" DependsOnTargets="_ResolveSampleVersions">
    <SetStrideVersionInProjects Projects="@(_StrideSampleCsproj)" SourceVersion="$(SampleDevVersion)" TargetVersion="$(SampleVersion)" />
    <Message Importance="high" Text="Samples set to release version $(SampleVersion)." />
  </Target>

  <!-- Bump the in-repo samples through the real package upgraders: each sample upgrades from its committed
       version to this checkout's dev build - migrate assets, rewrite references to 4.4.0-devN, restore from
       the local dev feed. The csprojs are left at the dev version so they open in GameStudio; run
       SamplesToReleaseVersion to finalize at the clean version before committing. SampleVersion defaults to
       the clean next-release number; -p:SampleVersion= overrides (e.g. a -beta). -p:SamplePackages= limits
       the migrated .sdpkg set. Part of CutSamples; on its own it does not touch the content version. -->
  <Target Name="UpgradeSamplesVersion" DependsOnTargets="_ResolveSampleVersions">
    <Message Importance="high" Text="UpgradeSamplesVersion: migrate -&gt; dev=$(SampleDevVersion) ($(Configuration)); run SamplesToReleaseVersion to finalize at $(SampleVersion)" />

    <!-- Build the source CompilerApp and locate its xplat dll (net*.0 excludes the -windows TFM). -->
    <MSBuild Projects="$(StrideRoot)sources\assets\Stride.AssetCompiler\Stride.AssetCompiler.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_StrideCompilerAppDll Include="$(StrideRoot)sources\assets\Stride.AssetCompiler\bin\$(Configuration)\net*.0\Stride.AssetCompiler.dll" />
    </ItemGroup>
    <Error Condition="'@(_StrideCompilerAppDll)' == ''" Text="CompilerApp dll not found under bin\$(Configuration)\net*.0 - build it first." />

    <!-- Run the package upgrader once over the whole samples solution: one process + one shared NuGet restore,
         so the samples resolve against one coherent graph and don't each pay a fresh process + restore. It sees
         each sample's committed version, migrates assets, rewrites the Stride.* references to this checkout's dev
         build and restores from the local dev feed. Override SampleUpgradeTarget for a single .slnx/.csproj/.sdpkg. -->
    <PropertyGroup>
      <SampleUpgradeTarget Condition="'$(SampleUpgradeTarget)' == ''">$(StrideRoot)samples\StrideSamples.slnx</SampleUpgradeTarget>
    </PropertyGroup>
    <Message Importance="high" Text="UpgradeSamplesVersion: upgrading $(SampleUpgradeTarget)" />
    <Exec WorkingDirectory="$(StrideRoot)"
          Command="dotnet &quot;@(_StrideCompilerAppDll)&quot; upgrade &quot;$(SampleUpgradeTarget)&quot;" />
    <Message Importance="high" Text="UpgradeSamplesVersion: done (samples at $(SampleDevVersion))" />
  </Target>

  <!-- Pack the content templates (Stride.Templates.Samples / .Games.Starters / .AssetPacks) at StrideSamplesVersion,
       worktree-suffixed on a local build (4.4.0-dev2), exact on CI / release builds (StridePackageBuild=true also
       selects the fully preprocessed pack mode). The engine projects they reference (the Stride.Core marker, the
       preprocessor) auto-pack next to them, as in any build; a release only picks up the content packs. -->
  <Target Name="PackContentTemplates" DependsOnTargets="_ResolveSampleVersions">
    <PropertyGroup>
      <_StrideContentPackArgs>-c $(Configuration) -p:StridePackContentTemplates=true -p:StrideSamplesVersion=$(StrideSamplesVersion)</_StrideContentPackArgs>
      <_StrideContentPackArgs Condition="'$(StridePackageBuild)' == 'true'">$(_StrideContentPackArgs) -p:StridePackageBuild=true</_StrideContentPackArgs>
    </PropertyGroup>
    <Exec Command="dotnet pack &quot;%(_StrideContentTemplateProject.Identity)&quot; $(_StrideContentPackArgs)" WorkingDirectory="$(StrideRoot)" />
  </Target>

  <!-- Remove this checkout's local content packs (bin/packages, the nugetdev feed, the global cache), so the
       published content version resolves again in Game Studio and the CLI. -->
  <Target Name="CleanContentTemplates">
    <MSBuild Projects="@(_StrideContentTemplateProject)" Targets="CleanContentTemplates" />
  </Target>

  <!-- The samples release, as far as a tool can take it. The number is the next content version
       (-p:StrideSamplesVersion=4.4.1: patch = content counter, never an engine prerelease label). The steps:
       guards, UpgradeSamplesVersion (real upgraders), SamplesToReleaseVersion, the new number written into
       SharedAssemblyInfo.cs, a -devN pack of the content, then the manual part the tool cannot judge: open the
       samples in Game Studio, fix what the upgraders left, commit the samples and the bump together (the PR's
       template smoke tests cover the pack). Never automated further: that judgement step is the point. Publish
       the cut with release-samples.yml before releasing an engine that names it. -->
  <Target Name="CutSamples" DependsOnTargets="_ResolveSampleVersions">
    <PropertyGroup>
      <_StrideCutNumeric>$([System.Text.RegularExpressions.Regex]::Match('$(StrideSamplesVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</_StrideCutNumeric>
      <_StrideCutCommittedNumeric>$([System.Text.RegularExpressions.Regex]::Match('$(_StrideCommittedSamplesVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</_StrideCutCommittedNumeric>
      <_StrideCutEngineNumeric>$([System.Text.RegularExpressions.Regex]::Match('$(SampleVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</_StrideCutEngineNumeric>
    </PropertyGroup>
    <Error Condition="'$(StrideSamplesVersion)' == '$(_StrideCommittedSamplesVersion)'"
           Text="CutSamples needs the next content number: -p:StrideSamplesVersion=&lt;version&gt; (committed: $(_StrideCommittedSamplesVersion))." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(StrideSamplesVersion)', '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'))"
           Text="Content version '$(StrideSamplesVersion)' is not a version (major.minor.patch with an optional -label, e.g. 4.4.1 or 4.4.1-rc1)." />
    <Error Condition="$([MSBuild]::VersionLessThan('$(_StrideCutNumeric)', '$(_StrideCutCommittedNumeric)'))"
           Text="Content version $(StrideSamplesVersion) goes back behind the committed $(_StrideCommittedSamplesVersion); a cut takes the next content number." />
    <Error Condition="$([MSBuild]::VersionGreaterThan('$(_StrideCutNumeric)', '$(_StrideCutEngineNumeric)'))"
           Text="Content version $(StrideSamplesVersion) is ahead of the engine ($(SampleVersion)); the content number follows the engine line loosely and never exceeds it." />
    <Message Importance="high" Text="CutSamples: content $(_StrideCommittedSamplesVersion) -&gt; $(StrideSamplesVersion), samples referencing engine $(SampleVersion)" />

    <CallTarget Targets="UpgradeSamplesVersion;SamplesToReleaseVersion" />

    <SetSamplesVersionConst File="$(_StrideSharedAssemblyInfo)" Version="$(StrideSamplesVersion)" />
    <Message Importance="high" Text="CutSamples: SamplesVersion = $(StrideSamplesVersion) written to $(_StrideSharedAssemblyInfo)" />

    <CallTarget Targets="PackContentTemplates" />

    <Message Importance="high" Text="%0ACutSamples: content $(StrideSamplesVersion) is cut locally (packed as $(StrideSamplesVersion)$(StrideWorktreeSuffix)). Left to do by hand:%0A  1. Open the samples in Game Studio (they reference $(SampleDevVersion); SamplesToDevVersion re-applies that) and fix what the upgraders left.%0A  2. Run SamplesToReleaseVersion, then commit the samples together with the SamplesVersion bump in sources/shared/SharedAssemblyInfo.cs.%0A  3. Once merged, publish it: release-samples.yml (it must be on the feed before an engine naming $(StrideSamplesVersion) is released).%0A  4. CleanContentTemplates when this checkout should resolve the published content again." />
  </Target>

</Project>
