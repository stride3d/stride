<?xml version="1.0" encoding="utf-8"?>
<!-- uia.cs and fchook.cs need no package: nuget.org only, so that their build never depends on the repo's own build output feed -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
